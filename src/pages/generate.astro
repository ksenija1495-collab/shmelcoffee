---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
---

<Layout title="Создать гид — Shmelco" description="Персональный гид под твои зёрна и способы заваривания">
  <Nav />
  <div class="container">
    <div class="gen-page" id="genPage">
      <div class="gen-loading" id="genLoading"><div class="loader-spinner"></div><p>Загрузка…</p></div>
    </div>
  </div>
<style is:global>
  .gen-page { padding-top: 88px; max-width: 720px; margin: 0 auto; min-height: 70vh; padding-bottom: 120px; }
  .gen-loading { text-align: center; padding: 80px 0; color: var(--text-muted); }
  .gen-back { font-size: .8rem; color: var(--text-muted); text-decoration: none; }
  .gen-back:hover { color: var(--accent); }
  .gen-h1 { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1.9rem; font-weight: 600; margin: 10px 0 4px; }
  .gen-sub { font-size: .88rem; color: var(--text-dim); margin-bottom: 8px; }
  .gen-credit { font-size: .8rem; color: var(--text-muted); margin-bottom: 24px; }
  .gen-credit b { color: var(--accent); }
  .gen-step-t { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1.25rem; font-weight: 600; margin: 26px 0 12px; display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .gen-cnt { font-family: 'Inter', sans-serif; font-size: .72rem; font-weight: 600; color: var(--text-muted); background: var(--surface-2); border: 1px solid var(--border); border-radius: 20px; padding: 2px 10px; }
  .gen-cnt.full { color: var(--accent); border-color: var(--accent); }
  .gen-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; }
  .gen-card { position: relative; text-align: left; padding: 13px 14px; border-radius: 12px; border: 1.5px solid var(--border); background: var(--surface); cursor: pointer; transition: all .15s; font-family: 'Inter', sans-serif; }
  .gen-card:hover { border-color: var(--border-hover); }
  .gen-card.sel { border-color: var(--accent); background: rgba(168,124,79,.08); box-shadow: 0 0 0 1px var(--accent); }
  .gen-card.sel::after { content: '✓'; position: absolute; top: 8px; right: 10px; color: var(--accent); font-weight: 800; font-size: .9rem; }
  .gen-card .t { font-weight: 700; font-size: .86rem; color: var(--text); }
  .gen-card .m { font-size: .72rem; color: var(--text-muted); margin-top: 2px; }
  .gen-card .ico { font-size: 1.3rem; }
  .gen-method { display: flex; align-items: center; gap: 10px; }
  .gen-manual { margin-top: 12px; display: flex; flex-direction: column; gap: 10px; }
  .gen-manual-item { padding: 16px; border: 1px dashed var(--border-hover); border-radius: 12px; position: relative; }
  .gen-manual-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
  .gen-manual-head span { font-size: .78rem; font-weight: 700; color: var(--text-dim); }
  .gen-manual-del { border: 0; background: transparent; color: var(--text-muted); cursor: pointer; font-size: 1.1rem; line-height: 1; padding: 2px 6px; border-radius: 6px; }
  .gen-manual-del:hover { color: #c44; background: rgba(200,68,68,.08); }
  .gen-manual-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  @media (max-width: 560px) { .gen-manual-grid { grid-template-columns: 1fr; } }
  .gen-add-manual { margin-top: 10px; width: 100%; padding: 12px 14px; border-radius: 12px; border: 1.5px dashed var(--border-hover); background: var(--surface-2); color: var(--text-dim); font-family: 'Inter', sans-serif; font-size: .84rem; font-weight: 600; cursor: pointer; transition: all .15s; }
  .gen-add-manual:hover:not(:disabled) { border-color: var(--accent); color: var(--accent); background: rgba(168,124,79,.06); }
  .gen-add-manual:disabled { opacity: .45; cursor: default; }
  .gen-field { margin-bottom: 12px; }
  .gen-field label { display: block; font-size: .74rem; color: var(--text-muted); margin-bottom: 5px; }
  .gen-field input, .gen-field select { width: 100%; padding: 10px 12px; border: 1px solid var(--border); border-radius: 8px; font-size: .88rem; font-family: 'Inter', sans-serif; background: var(--surface); color: var(--text); }
  .gen-bar { position: fixed; left: 0; right: 0; bottom: 0; background: var(--surface); border-top: 1px solid var(--border); padding: 14px 20px; box-shadow: 0 -4px 20px rgba(0,0,0,.06); z-index: 40; }
  .gen-bar-inner { max-width: 720px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap; }
  .gen-bar-note { font-size: .78rem; color: var(--text-muted); }
  .gen-gen-btn { font-size: .9rem; padding: 12px 24px; border-radius: 8px; background: var(--accent); color: #fff; border: 0; cursor: pointer; font-weight: 700; font-family: 'Inter', sans-serif; transition: opacity .2s; }
  .gen-gen-btn:disabled { opacity: .45; cursor: default; }
  .gen-empty { font-size: .82rem; color: var(--text-muted); padding: 12px 0; }
  .loader-spinner { width: 28px; height: 28px; border: 2px solid var(--border); border-top-color: var(--text); border-radius: 50%; animation: spin .6s linear infinite; margin: 0 auto 16px; }
  @keyframes spin { to { transform: rotate(360deg); } }
</style>

<script>
  import { createClient } from '@supabase/supabase-js';
  import { DB, countryOrder } from '../data/countries';

  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
    { auth: { flowType: 'implicit' } }
  );
  import { buildProdamusBuyUrl } from '../lib/prodamusBuyUrl';
  import { BEAN_VARIETIES } from '../data/varieties';

  const PRODAMUS_URL = (import.meta.env.PUBLIC_PRODAMUS_URL as string) || '';
  const countries = countryOrder.map((k: string) => (DB as any)[k].name);
  const page = document.getElementById('genPage')!;

  const MAX_BEANS = 6, MAX_METHODS = 3;
  const METHODS = [
    { id: 'v60', label: 'Воронка V60', ico: '☕' },
    { id: 'switch', label: 'Hario Switch', ico: '🔀' },
    { id: 'kalita', label: 'Kalita Wave', ico: '🌊' },
    { id: 'chemex', label: 'Кемекс', ico: '⏳' },
    { id: 'aeropress', label: 'Аэропресс', ico: '💨' },
    { id: 'french', label: 'Френч-пресс', ico: '🫖' },
    { id: 'cezve', label: 'Турка', ico: '🔥' },
    { id: 'moka', label: 'Гейзер (мока)', ico: '⛰️' },
    { id: 'espresso', label: 'Эспрессо-машина', ico: '⚙️' },
    { id: 'coldbrew', label: 'Cold Brew', ico: '🧊' },
  ];
  const PROCESSES = ['Мытая', 'Натуральная', 'Хани', 'Анаэробная', 'Карбоник масерейшн', 'Другая'];

  type ManualBean = { name: string; variety: string; roaster: string; country: string; process: string };
  const emptyManual = (): ManualBean => ({ name: '', variety: '', roaster: '', country: '', process: '' });
  const state = {
    beans: new Set<string>(),
    manualIds: [] as string[],
    manualData: {} as Record<string, ManualBean>,
    methods: new Set<string>(),
  };
  let manualCounter = 0;
  const getParam = (n: string) => new URLSearchParams(window.location.search).get(n) || '';
  const escAttr = (s: string) => s.replace(/&/g, '&amp;').replace(/"/g, '&quot;');
  const manualName = (id: string) => document.getElementById(id + '_name') as HTMLInputElement | null;
  const manualRoaster = (id: string) => document.getElementById(id + '_roaster') as HTMLInputElement | null;
  const manualCountry = (id: string) => document.getElementById(id + '_country') as HTMLSelectElement | null;
  const manualProcess = (id: string) => document.getElementById(id + '_process') as HTMLSelectElement | null;
  const manualVariety = (id: string) => document.getElementById(id + '_variety') as HTMLSelectElement | null;

  function snapshotManual(id: string) {
    state.manualData[id] = {
      name: manualName(id)?.value.trim() || '',
      variety: manualVariety(id)?.value || '',
      roaster: manualRoaster(id)?.value.trim() || '',
      country: manualCountry(id)?.value || '',
      process: manualProcess(id)?.value || '',
    };
  }

  function snapshotAllManuals() {
    state.manualIds.forEach(snapshotManual);
  }

  const manualFilledCount = () => state.manualIds.filter((id) => !!(state.manualData[id]?.name.trim())).length;
  const beanSlotCount = () => state.beans.size + state.manualIds.length;
  const beanCount = () => state.beans.size + manualFilledCount();
  const vid = (n: number) => { const a = n % 100, b = n % 10; if (a > 10 && a < 20) return 'видов'; if (b > 1 && b < 5) return 'вида'; if (b === 1) return 'вид'; return 'видов'; };

  async function fetchCredits(token: string): Promise<number> {
    try {
      const res = await fetch('/api/guide-credits', { headers: { Authorization: 'Bearer ' + token } });
      if (!res.ok) return 0;
      const data = await res.json();
      return data.balance || 0;
    } catch {
      return 0;
    }
  }

  async function init() {
    const { data: { user } } = await supabase.auth.getUser();
    if (!user) { window.location.href = '/login'; return; }
    const { data: { session } } = await supabase.auth.getSession();
    const accessToken = session?.access_token || '';

    const [shelfRes, credits] = await Promise.all([
      supabase.from('shelf_items').select('*').eq('user_id', user.id).eq('kind', 'bean').order('created_at', { ascending: false }),
      fetchCredits(accessToken),
    ]);
    const beans: any[] = shelfRes.data || [];
    const buyUrl = buildProdamusBuyUrl(PRODAMUS_URL, user, window.location.origin);
    const preShelf = getParam('shelf');

    const beanCards = beans.map(b => `<button class="gen-card bean-card" data-bean="${b.id}"><div class="t">${b.name}</div><div class="m">${[b.roaster, b.country, b.process].filter(Boolean).join(' · ') || 'зерно'}</div></button>`).join('');
    const methodCards = METHODS.map(m => `<button class="gen-card method-card" data-method="${m.label}"><div class="gen-method"><span class="ico">${m.ico}</span><span class="t">${m.label}</span></div></button>`).join('');

    page.innerHTML = `
      <a href="/account" class="gen-back">← В кабинет</a>
      <div class="gen-h1">Создать персональный гид</div>
      <div class="gen-sub">Выбери одно или несколько зёрен и способов заваривания — AI соберёт рецепты и план дегустации, чтобы заваривать и сравнивать.</div>
      <div class="gen-credit">${credits > 0 ? `Доступно гидов: <b>${credits}</b> · списывается 1 за генерацию` : 'Нет оплаченных гидов — сначала купи (99&nbsp;₽).'}</div>

      <div class="gen-step-t">1. Зёрна <span class="gen-cnt" id="beanCnt">0 / ${MAX_BEANS}</span></div>
      <div class="gen-grid" id="beanGrid">
        ${beans.length ? beanCards : '<div class="gen-empty">На полке пока нет зерна — добавь своё вручную ниже.</div>'}
      </div>
      <div class="gen-manual" id="manualList"></div>
      <button type="button" class="gen-add-manual" id="addManualBtn">+ Добавить зерно вручную</button>

      <div class="gen-step-t">2. Способы заваривания <span class="gen-cnt" id="methodCnt">0 / ${MAX_METHODS}</span></div>
      <div class="gen-grid" id="methodGrid">${methodCards}</div>

      <div class="gen-bar"><div class="gen-bar-inner">
        <span class="gen-bar-note" id="genNote">Выбери хотя бы одно зерно и способ</span>
        ${credits > 0
          ? '<button class="gen-gen-btn" id="genBtn" disabled>🤖 Сгенерировать гид</button>'
          : '<button class="gen-gen-btn" id="buyBtn">Купить гид · 99 ₽</button>'}
      </div></div>
    `;

    const manualList = document.getElementById('manualList')!;
    const addManualBtn = document.getElementById('addManualBtn') as HTMLButtonElement;
    const genBtn = document.getElementById('genBtn') as HTMLButtonElement | null;
    const note = document.getElementById('genNote');
    const beanCnt = document.getElementById('beanCnt')!;
    const methodCnt = document.getElementById('methodCnt')!;

    const countryOpts = (sel: string) => countries.map((c: string) => `<option${c === sel ? ' selected' : ''}>${c}</option>`).join('');
    const processOpts = (sel: string) => PROCESSES.map((p) => `<option${p === sel ? ' selected' : ''}>${p}</option>`).join('');
    const varietyOpts = (sel: string) => BEAN_VARIETIES.map((v) => `<option${v === sel ? ' selected' : ''}>${v}</option>`).join('');

    function manualItemHtml(id: string, n: number) {
      const d = state.manualData[id] || emptyManual();
      return `<div class="gen-manual-item" data-manual-id="${id}">
        <div class="gen-manual-head"><span>Зерно ${n}</span><button type="button" class="gen-manual-del" data-manual-del="${id}" title="Удалить">×</button></div>
        <div class="gen-manual-grid">
          <div class="gen-field" style="grid-column:1/-1"><label>Название *</label><input id="${id}_name" value="${escAttr(d.name)}" placeholder="напр. Эфиопия Гедео" /></div>
          <div class="gen-field"><label>Сорт</label><select id="${id}_variety"><option value=""${d.variety ? '' : ' selected'}>— не знаю / смесь</option>${varietyOpts(d.variety)}</select></div>
          <div class="gen-field"><label>Обжарщик</label><input id="${id}_roaster" value="${escAttr(d.roaster)}" placeholder="напр. Tasty Coffee" /></div>
          <div class="gen-field"><label>Страна</label><select id="${id}_country"><option value=""${d.country ? '' : ' selected'}>—</option>${countryOpts(d.country)}</select></div>
          <div class="gen-field"><label>Обработка</label><select id="${id}_process"><option value=""${d.process ? '' : ' selected'}>—</option>${processOpts(d.process)}</select></div>
        </div>
      </div>`;
    }

    function bindManualItem(id: string) {
      const sync = () => { snapshotManual(id); refresh(); };
      manualName(id)?.addEventListener('input', sync);
      manualRoaster(id)?.addEventListener('input', sync);
      manualVariety(id)?.addEventListener('change', sync);
      manualCountry(id)?.addEventListener('change', sync);
      manualProcess(id)?.addEventListener('change', sync);
      document.querySelector('[data-manual-del="' + id + '"]')?.addEventListener('click', () => {
        snapshotAllManuals();
        state.manualIds = state.manualIds.filter((x) => x !== id);
        delete state.manualData[id];
        document.querySelector('[data-manual-id="' + id + '"]')?.remove();
        state.manualIds.forEach((mid, i) => {
          const head = document.querySelector('[data-manual-id="' + mid + '"] .gen-manual-head span');
          if (head) head.textContent = 'Зерно ' + (i + 1);
        });
        refresh();
      });
    }

    function renderManualEntries() {
      snapshotAllManuals();
      manualList.innerHTML = state.manualIds.map((id, i) => manualItemHtml(id, i + 1)).join('');
      state.manualIds.forEach(bindManualItem);
    }

    function addManualEntry() {
      if (beanSlotCount() >= MAX_BEANS) {
        if (note) note.textContent = `Максимум ${MAX_BEANS} зёрен`;
        return;
      }
      snapshotAllManuals();
      const id = 'manual_' + (++manualCounter);
      state.manualIds.push(id);
      state.manualData[id] = emptyManual();
      manualList.insertAdjacentHTML('beforeend', manualItemHtml(id, state.manualIds.length));
      bindManualItem(id);
      manualName(id)?.focus();
      refresh();
    }

    function collectManualBeans() {
      snapshotAllManuals();
      return state.manualIds
        .map((id) => state.manualData[id] || emptyManual())
        .filter((b) => b.name);
    }

    function refresh() {
      const bc = beanCount();
      beanCnt.textContent = bc + ' / ' + MAX_BEANS;
      beanCnt.classList.toggle('full', beanSlotCount() >= MAX_BEANS);
      methodCnt.textContent = state.methods.size + ' / ' + MAX_METHODS;
      methodCnt.classList.toggle('full', state.methods.size >= MAX_METHODS);
      if (addManualBtn) addManualBtn.disabled = beanSlotCount() >= MAX_BEANS;
      const ok = bc >= 1 && state.methods.size >= 1;
      if (genBtn) genBtn.disabled = !ok;
      if (note) note.textContent = ok ? `готово: ${bc} ${vid(bc)} зерна и ${state.methods.size} ${vid(state.methods.size)} заварки` : 'Выбери хотя бы одно зерно и способ';
    }

    page.querySelectorAll('.bean-card').forEach(c => c.addEventListener('click', () => {
      const id = (c as HTMLElement).getAttribute('data-bean')!;
      if (state.beans.has(id)) { state.beans.delete(id); c.classList.remove('sel'); }
      else {
        if (beanSlotCount() >= MAX_BEANS) { note && (note.textContent = `Максимум ${MAX_BEANS} зёрен`); return; }
        state.beans.add(id); c.classList.add('sel');
      }
      refresh();
    }));

    addManualBtn?.addEventListener('click', addManualEntry);

    page.querySelectorAll('.method-card').forEach(c => c.addEventListener('click', () => {
      const m = (c as HTMLElement).getAttribute('data-method')!;
      if (state.methods.has(m)) { state.methods.delete(m); c.classList.remove('sel'); }
      else {
        if (state.methods.size >= MAX_METHODS) { note && (note.textContent = `Максимум ${MAX_METHODS} способа`); return; }
        state.methods.add(m); c.classList.add('sel');
      }
      refresh();
    }));

    if (preShelf) { const card = page.querySelector('.bean-card[data-bean="' + preShelf + '"]') as HTMLElement | null; if (card) card.click(); }
    else if (!beans.length) addManualEntry();

    document.getElementById('buyBtn')?.addEventListener('click', () => { if (buyUrl) window.open(buyUrl, '_blank'); else alert('Оплата скоро будет доступна. Напишите в Telegram @ksenijashmel.'); });

    genBtn?.addEventListener('click', async () => {
      const beansArr: any[] = [];
      state.beans.forEach(id => { const b = beans.find(x => x.id === id); if (b) beansArr.push({ name: b.name, variety: b.variety || '', roaster: b.roaster, country: b.country, process: b.process }); });
      beansArr.push(...collectManualBeans());
      const methodsArr = Array.from(state.methods);
      if (!beansArr.length || !methodsArr.length) return;
      genBtn.disabled = true; genBtn.textContent = 'Генерация…';
      try {
        const { data: { session } } = await supabase.auth.getSession();
        const res = await fetch('/api/generate-bean-guide', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + (session?.access_token || '') }, body: JSON.stringify({ beans: beansArr, methods: methodsArr }) });
        if (res.status === 402) { alert('Нужен оплаченный гид. Нажми «Купить гид».'); window.location.reload(); return; }
        if (!res.ok) throw new Error(await res.text());
        try { localStorage.setItem('acc_tab', 'guides'); } catch (e) {}
        window.location.href = '/account';
      } catch (e: any) { alert('Ошибка: ' + e.message); genBtn.disabled = false; genBtn.textContent = '🤖 Сгенерировать гид'; }
    });

    refresh();
  }

  init();
</script>

</Layout>
