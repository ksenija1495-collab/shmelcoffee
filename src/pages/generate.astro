---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
---

<Layout title="Создать гид — Shmelco" description="Персональный гид под твои зёрна и способы заваривания">
  <Nav />
  <div class="container">
    <div class="gen-page" id="genPage">
      <div class="gen-loading" id="genLoading"><div class="loader-spinner"></div><p>Загрузка…</p></div>
    </div>
  </div>
</Layout>

<style is:global>
  .gen-page { padding-top: 88px; max-width: 720px; margin: 0 auto; min-height: 70vh; padding-bottom: 120px; }
  .gen-loading { text-align: center; padding: 80px 0; color: var(--text-muted); }
  .gen-back { font-size: .8rem; color: var(--text-muted); text-decoration: none; }
  .gen-back:hover { color: var(--accent); }
  .gen-h1 { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1.9rem; font-weight: 600; margin: 10px 0 4px; }
  .gen-sub { font-size: .88rem; color: var(--text-dim); margin-bottom: 8px; }
  .gen-credit { font-size: .8rem; color: var(--text-muted); margin-bottom: 24px; }
  .gen-credit b { color: var(--accent); }
  .gen-step-t { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1.25rem; font-weight: 600; margin: 26px 0 12px; display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .gen-cnt { font-family: 'Inter', sans-serif; font-size: .72rem; font-weight: 600; color: var(--text-muted); background: var(--surface-2); border: 1px solid var(--border); border-radius: 20px; padding: 2px 10px; }
  .gen-cnt.full { color: var(--accent); border-color: var(--accent); }
  .gen-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; }
  .gen-card { position: relative; text-align: left; padding: 13px 14px; border-radius: 12px; border: 1.5px solid var(--border); background: var(--surface); cursor: pointer; transition: all .15s; font-family: 'Inter', sans-serif; }
  .gen-card:hover { border-color: var(--border-hover); }
  .gen-card.sel { border-color: var(--accent); background: rgba(168,124,79,.08); box-shadow: 0 0 0 1px var(--accent); }
  .gen-card.sel::after { content: '✓'; position: absolute; top: 8px; right: 10px; color: var(--accent); font-weight: 800; font-size: .9rem; }
  .gen-card .t { font-weight: 700; font-size: .86rem; color: var(--text); }
  .gen-card .m { font-size: .72rem; color: var(--text-muted); margin-top: 2px; }
  .gen-card .ico { font-size: 1.3rem; }
  .gen-method { display: flex; align-items: center; gap: 10px; }
  .gen-manual { margin-top: 12px; padding: 16px; border: 1px dashed var(--border-hover); border-radius: 12px; display: none; }
  .gen-manual.show { display: block; }
  .gen-field { margin-bottom: 12px; }
  .gen-field label { display: block; font-size: .74rem; color: var(--text-muted); margin-bottom: 5px; }
  .gen-field input, .gen-field select { width: 100%; padding: 10px 12px; border: 1px solid var(--border); border-radius: 8px; font-size: .88rem; font-family: 'Inter', sans-serif; background: var(--surface); color: var(--text); }
  .gen-bar { position: fixed; left: 0; right: 0; bottom: 0; background: var(--surface); border-top: 1px solid var(--border); padding: 14px 20px; box-shadow: 0 -4px 20px rgba(0,0,0,.06); z-index: 40; }
  .gen-bar-inner { max-width: 720px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap; }
  .gen-bar-note { font-size: .78rem; color: var(--text-muted); }
  .gen-gen-btn { font-size: .9rem; padding: 12px 24px; border-radius: 8px; background: var(--accent); color: #fff; border: 0; cursor: pointer; font-weight: 700; font-family: 'Inter', sans-serif; transition: opacity .2s; }
  .gen-gen-btn:disabled { opacity: .45; cursor: default; }
  .gen-empty { font-size: .82rem; color: var(--text-muted); padding: 12px 0; }
  .loader-spinner { width: 28px; height: 28px; border: 2px solid var(--border); border-top-color: var(--text); border-radius: 50%; animation: spin .6s linear infinite; margin: 0 auto 16px; }
  @keyframes spin { to { transform: rotate(360deg); } }
</style>

<script>
  import { createClient } from '@supabase/supabase-js';
  import { DB, countryOrder } from '../data/countries';

  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
    { auth: { flowType: 'implicit' } }
  );
  const PRODAMUS_URL = (import.meta.env.PUBLIC_PRODAMUS_URL as string) || '';
  const countries = countryOrder.map((k: string) => (DB as any)[k].name);
  const page = document.getElementById('genPage')!;

  const MAX_BEANS = 6, MAX_METHODS = 3;
  const METHODS = [
    { id: 'v60', label: 'Воронка V60', ico: '☕' },
    { id: 'kalita', label: 'Kalita Wave', ico: '🌊' },
    { id: 'chemex', label: 'Кемекс', ico: '⏳' },
    { id: 'aeropress', label: 'Аэропресс', ico: '💨' },
    { id: 'french', label: 'Френч-пресс', ico: '🫖' },
    { id: 'cezve', label: 'Турка', ico: '🔥' },
    { id: 'moka', label: 'Гейзер (мока)', ico: '⛰️' },
    { id: 'espresso', label: 'Эспрессо-машина', ico: '⚙️' },
    { id: 'coldbrew', label: 'Cold Brew', ico: '🧊' },
  ];
  const PROCESSES = ['Мытая', 'Натуральная', 'Хани', 'Анаэробная', 'Карбоник масерейшн', 'Другая'];

  const state = { beans: new Set<string>(), manualOn: false, methods: new Set<string>() };
  const getParam = (n: string) => new URLSearchParams(window.location.search).get(n) || '';
  const inp = (id: string) => document.getElementById(id) as HTMLInputElement;
  const sel = (id: string) => document.getElementById(id) as HTMLSelectElement;
  const manualFilled = () => state.manualOn && !!(inp('mName') && inp('mName').value.trim());
  const beanCount = () => state.beans.size + (manualFilled() ? 1 : 0);

  async function init() {
    const { data: { user } } = await supabase.auth.getUser();
    if (!user) { window.location.href = '/login'; return; }

    const [shelfRes, creditsRes] = await Promise.all([
      supabase.from('shelf_items').select('*').eq('user_id', user.id).eq('kind', 'bean').order('created_at', { ascending: false }),
      supabase.from('guide_credits').select('balance').eq('user_id', user.id).maybeSingle(),
    ]);
    const beans: any[] = shelfRes.data || [];
    const credits = (creditsRes.data && (creditsRes.data as any).balance) || 0;
    const buyUrl = PRODAMUS_URL ? PRODAMUS_URL + (PRODAMUS_URL.includes('?') ? '&' : '?') + 'order_id=' + encodeURIComponent(user.id) + '&customer_email=' + encodeURIComponent(user.email || '') : '';
    const preShelf = getParam('shelf');

    const beanCards = beans.map(b => `<button class="gen-card bean-card" data-bean="${b.id}"><div class="t">${b.name}</div><div class="m">${[b.roaster, b.country, b.process].filter(Boolean).join(' · ') || 'зерно'}</div></button>`).join('');
    const methodCards = METHODS.map(m => `<button class="gen-card method-card" data-method="${m.label}"><div class="gen-method"><span class="ico">${m.ico}</span><span class="t">${m.label}</span></div></button>`).join('');

    page.innerHTML = `
      <a href="/account" class="gen-back">← В кабинет</a>
      <div class="gen-h1">Создать персональный гид</div>
      <div class="gen-sub">Выбери одно или несколько зёрен и способов заваривания — AI соберёт рецепты и план дегустации, чтобы заваривать и сравнивать.</div>
      <div class="gen-credit">${credits > 0 ? `Доступно гидов: <b>${credits}</b> · списывается 1 за генерацию` : 'Нет оплаченных гидов — сначала купи (99&nbsp;₽).'}</div>

      <div class="gen-step-t">1. Зёрна <span class="gen-cnt" id="beanCnt">0 / ${MAX_BEANS}</span></div>
      <div class="gen-grid" id="beanGrid">
        ${beans.length ? beanCards : '<div class="gen-empty">На полке пока нет зерна — впиши своё ниже.</div>'}
        <button class="gen-card bean-card" data-bean="__manual__"><div class="t">+ Другое зерно</div><div class="m">вписать вручную</div></button>
      </div>
      <div class="gen-manual" id="manualBox">
        <div class="gen-field"><label>Название зерна *</label><input id="mName" placeholder="напр. Эфиопия Гедео" /></div>
        <div class="gen-field"><label>Обжарщик</label><input id="mRoaster" placeholder="напр. Tasty Coffee" /></div>
        <div class="gen-field"><label>Страна</label><select id="mCountry"><option value="">—</option>${countries.map((c: string) => `<option>${c}</option>`).join('')}</select></div>
        <div class="gen-field"><label>Обработка</label><select id="mProcess"><option value="">—</option>${PROCESSES.map(p => `<option>${p}</option>`).join('')}</select></div>
      </div>

      <div class="gen-step-t">2. Способы заваривания <span class="gen-cnt" id="methodCnt">0 / ${MAX_METHODS}</span></div>
      <div class="gen-grid" id="methodGrid">${methodCards}</div>

      <div class="gen-bar"><div class="gen-bar-inner">
        <span class="gen-bar-note" id="genNote">Выбери хотя бы одно зерно и способ</span>
        ${credits > 0
          ? '<button class="gen-gen-btn" id="genBtn" disabled>🤖 Сгенерировать гид</button>'
          : '<button class="gen-gen-btn" id="buyBtn">Купить гид · 99 ₽</button>'}
      </div></div>
    `;

    const manualBox = document.getElementById('manualBox')!;
    const genBtn = document.getElementById('genBtn') as HTMLButtonElement | null;
    const note = document.getElementById('genNote');
    const beanCnt = document.getElementById('beanCnt')!;
    const methodCnt = document.getElementById('methodCnt')!;

    function refresh() {
      const bc = beanCount();
      beanCnt.textContent = bc + ' / ' + MAX_BEANS;
      beanCnt.classList.toggle('full', bc >= MAX_BEANS);
      methodCnt.textContent = state.methods.size + ' / ' + MAX_METHODS;
      methodCnt.classList.toggle('full', state.methods.size >= MAX_METHODS);
      const ok = bc >= 1 && state.methods.size >= 1;
      if (genBtn) genBtn.disabled = !ok;
      if (note) note.textContent = ok ? `Готово — ${bc} ${bc === 1 ? 'зерно' : 'зёрен'} × ${state.methods.size} ${state.methods.size === 1 ? 'способ' : 'способа'}` : 'Выбери хотя бы одно зерно и способ';
    }

    page.querySelectorAll('.bean-card').forEach(c => c.addEventListener('click', () => {
      const id = (c as HTMLElement).getAttribute('data-bean')!;
      if (id === '__manual__') {
        if (!state.manualOn && state.beans.size >= MAX_BEANS) { note && (note.textContent = `Максимум ${MAX_BEANS} зёрен`); return; }
        state.manualOn = !state.manualOn;
        c.classList.toggle('sel', state.manualOn);
        manualBox.classList.toggle('show', state.manualOn);
        refresh();
        return;
      }
      if (state.beans.has(id)) { state.beans.delete(id); c.classList.remove('sel'); }
      else {
        if (beanCount() >= MAX_BEANS) { note && (note.textContent = `Максимум ${MAX_BEANS} зёрен`); return; }
        state.beans.add(id); c.classList.add('sel');
      }
      refresh();
    }));

    page.querySelectorAll('.method-card').forEach(c => c.addEventListener('click', () => {
      const m = (c as HTMLElement).getAttribute('data-method')!;
      if (state.methods.has(m)) { state.methods.delete(m); c.classList.remove('sel'); }
      else {
        if (state.methods.size >= MAX_METHODS) { note && (note.textContent = `Максимум ${MAX_METHODS} способа`); return; }
        state.methods.add(m); c.classList.add('sel');
      }
      refresh();
    }));

    inp('mName')?.addEventListener('input', refresh);

    if (preShelf) { const card = page.querySelector('.bean-card[data-bean="' + preShelf + '"]') as HTMLElement | null; if (card) card.click(); }

    document.getElementById('buyBtn')?.addEventListener('click', () => { if (buyUrl) window.open(buyUrl, '_blank'); else alert('Оплата скоро будет доступна. Напишите в Telegram @ksenijashmel.'); });

    genBtn?.addEventListener('click', async () => {
      const beansArr: any[] = [];
      state.beans.forEach(id => { const b = beans.find(x => x.id === id); if (b) beansArr.push({ name: b.name, roaster: b.roaster, country: b.country, process: b.process }); });
      if (manualFilled()) beansArr.push({ name: inp('mName').value.trim(), roaster: inp('mRoaster').value.trim(), country: sel('mCountry').value, process: sel('mProcess').value });
      const methodsArr = Array.from(state.methods);
      if (!beansArr.length || !methodsArr.length) return;
      genBtn.disabled = true; genBtn.textContent = 'Генерация…';
      try {
        const { data: { session } } = await supabase.auth.getSession();
        const res = await fetch('/api/generate-bean-guide', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + (session?.access_token || '') }, body: JSON.stringify({ beans: beansArr, methods: methodsArr }) });
        if (res.status === 402) { alert('Нужен оплаченный гид. Нажми «Купить гид».'); window.location.reload(); return; }
        if (!res.ok) throw new Error(await res.text());
        try { localStorage.setItem('acc_tab', 'guides'); } catch (e) {}
        window.location.href = '/account';
      } catch (e: any) { alert('Ошибка: ' + e.message); genBtn.disabled = false; genBtn.textContent = '🤖 Сгенерировать гид'; }
    });

    refresh();
  }

  init();
</script>
