---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
---

<Layout title="Войти — Shmelco" description="Войдите в личный кабинет Shmelco Coffee Guide">
  <Nav />
  <div class="container">
    <div class="login-page">
      <div class="login-card">
        <h1>Войти в Shmelco</h1>
        <p class="login-desc">Войдите через Google — мы сохраним ваш профиль вкуса, подборки и персональные гиды</p>

        <button id="googleBtn" class="google-btn">
          <svg width="18" height="18" viewBox="0 0 18 18"><path d="M16.51 8H8.98v3h4.3c-.18 1-.74 1.48-1.6 2.04v2.01h2.6a7.8 7.8 0 0 0 2.38-5.88c0-.57-.05-.66-.15-1.18Z" fill="#4285F4"/><path d="M8.98 17c2.16 0 3.97-.72 5.3-1.94l-2.6-2a4.8 4.8 0 0 1-7.18-2.54H1.83v2.07A8 8 0 0 0 8.98 17Z" fill="#34A853"/><path d="M4.5 10.52a4.8 4.8 0 0 1 0-3.04V5.41H1.83a8 8 0 0 0 0 7.18l2.67-2.07Z" fill="#FBBC05"/><path d="M8.98 3.58c1.32 0 2.5.45 3.44 1.35l2.58-2.59A8 8 0 0 0 1.83 5.41L4.5 7.48a4.77 4.77 0 0 1 4.48-3.9Z" fill="#EA4335"/></svg>
          Войти через Google
        </button>

        <div id="loginMsg" class="login-msg"></div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .login-page {
    padding-top: 100px; min-height: 70vh;
    display: flex; align-items: flex-start; justify-content: center;
  }
  .login-card {
    max-width: 400px; width: 100%; padding: 32px;
    background: var(--surface); border-radius: var(--radius-lg);
    border: 1px solid var(--border); box-shadow: var(--shadow);
    text-align: center;
  }
  .login-card h1 {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.6rem; font-weight: 600; margin-bottom: 8px;
  }
  .login-desc { font-size: .84rem; color: var(--text-dim); margin-bottom: 24px; line-height: 1.5; }
  .google-btn {
    display: inline-flex; align-items: center; gap: 10px;
    padding: 11px 24px; border-radius: 8px;
    border: 1px solid var(--border); background: #fff;
    font-family: 'Inter', sans-serif; font-size: .88rem; font-weight: 500;
    color: var(--text); cursor: pointer; transition: all .2s;
    box-shadow: 0 1px 3px rgba(0,0,0,.08);
  }
  .google-btn:hover {
    border-color: var(--border-hover); box-shadow: 0 2px 8px rgba(0,0,0,.12);
  }
  .login-msg {
    margin-top: 16px; font-size: .82rem; line-height: 1.5; min-height: 24px;
  }
  .login-msg.error { color: var(--accent-warm); }
</style>

<script>
  import { createClient } from '@supabase/supabase-js';

  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
    { auth: { flowType: 'implicit' } }
  );

  document.getElementById('googleBtn')!.addEventListener('click', async () => {
    // Возвращаемся на тот же домен, с которого пользователь зашёл,
    // чтобы не уходить на несуществующий www-поддомен.
    const { error } = await supabase.auth.signInWithOAuth({
      provider: 'google',
      options: { redirectTo: `${window.location.origin}/auth/callback` },
    });
    if (error) {
      const msg = document.getElementById('loginMsg')!;
      msg.className = 'login-msg error';
      msg.textContent = 'Ошибка: ' + error.message;
    }
  });
</script>
