---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
---

<Layout title="Войти — Shmelco" description="Войдите в личный кабинет Shmelco Coffee Guide">
  <Nav />
  <div class="container">
    <div class="login-page">
      <div class="login-card">
        <h1>Войти в Shmelco</h1>
        <p class="login-desc">Сохраним ваш профиль вкуса, подборки и персональные гиды</p>
        <p class="login-hint">Быстрее всего — через Google, без писем</p>

        <button id="googleBtn" class="google-btn">
          <svg width="18" height="18" viewBox="0 0 18 18"><path d="M16.51 8H8.98v3h4.3c-.18 1-.74 1.48-1.6 2.04v2.01h2.6a7.8 7.8 0 0 0 2.38-5.88c0-.57-.05-.66-.15-1.18Z" fill="#4285F4"/><path d="M8.98 17c2.16 0 3.97-.72 5.3-1.94l-2.6-2a4.8 4.8 0 0 1-7.18-2.54H1.83v2.07A8 8 0 0 0 8.98 17Z" fill="#34A853"/><path d="M4.5 10.52a4.8 4.8 0 0 1 0-3.04V5.41H1.83a8 8 0 0 0 0 7.18l2.67-2.07Z" fill="#FBBC05"/><path d="M8.98 3.58c1.32 0 2.5.45 3.44 1.35l2.58-2.59A8 8 0 0 0 1.83 5.41L4.5 7.48a4.77 4.77 0 0 1 4.48-3.9Z" fill="#EA4335"/></svg>
          Войти через Google
        </button>

        <div class="login-or"><span>или по почте</span></div>
        <p class="login-email-note">Письмо придёт от Supabase — проверьте «Спам», если не видите</p>

        <form id="emailForm" class="email-form">
          <input id="emailInput" type="email" inputmode="email" autocomplete="email" placeholder="you@example.com" required />
          <button type="submit" class="email-btn" id="emailBtn">Получить ссылку для входа</button>
        </form>

        <div id="loginMsg" class="login-msg"></div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .login-page { padding-top: 100px; min-height: 70vh; display: flex; align-items: flex-start; justify-content: center; }
  .login-card { max-width: 400px; width: 100%; padding: 32px; background: var(--surface); border-radius: var(--radius-lg); border: 1px solid var(--border); box-shadow: var(--shadow); text-align: center; }
  .login-card h1 { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1.6rem; font-weight: 600; margin-bottom: 8px; }
  .login-desc { font-size: .84rem; color: var(--text-dim); margin-bottom: 8px; line-height: 1.5; }
  .login-hint { font-size: .76rem; color: var(--accent); font-weight: 600; margin-bottom: 20px; }
  .login-email-note { font-size: .72rem; color: var(--text-muted); margin: -10px 0 14px; line-height: 1.4; }
  .google-btn { display: inline-flex; align-items: center; gap: 10px; padding: 11px 24px; border-radius: 8px; border: 1px solid var(--border); background: #fff; font-family: 'Inter', sans-serif; font-size: .88rem; font-weight: 500; color: var(--text); cursor: pointer; transition: all .2s; box-shadow: 0 1px 3px rgba(0,0,0,.08); }
  .google-btn:hover { border-color: var(--border-hover); box-shadow: 0 2px 8px rgba(0,0,0,.12); }
  .login-or { display: flex; align-items: center; gap: 12px; margin: 22px 0 18px; color: var(--text-muted); font-size: .74rem; }
  .login-or::before, .login-or::after { content: ''; flex: 1; height: 1px; background: var(--border); }
  .email-form { display: flex; flex-direction: column; gap: 10px; }
  .email-form input { width: 100%; padding: 11px 14px; border: 1px solid var(--border); border-radius: 8px; font-size: .9rem; font-family: 'Inter', sans-serif; background: var(--surface); color: var(--text); text-align: center; }
  .email-form input:focus { outline: none; border-color: var(--accent); }
  .email-btn { padding: 11px 20px; border-radius: 8px; background: var(--text); color: var(--bg); border: 1px solid var(--text); font-family: 'Inter', sans-serif; font-size: .88rem; font-weight: 600; cursor: pointer; transition: all .2s; }
  .email-btn:hover { background: var(--accent); border-color: var(--accent); }
  .email-btn:disabled { opacity: .6; cursor: default; }
  .login-msg { margin-top: 16px; font-size: .82rem; line-height: 1.5; min-height: 24px; }
  .login-msg.error { color: var(--accent-warm); }
  .login-msg.ok { color: #4a7a45; }
</style>

<script>
  import { createClient } from '@supabase/supabase-js';

  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
    { auth: { flowType: 'implicit' } }
  );

  const msg = document.getElementById('loginMsg')!;
  function setMsg(text: string, cls: string) { msg.className = 'login-msg ' + cls; msg.textContent = text; }

  document.getElementById('googleBtn')!.addEventListener('click', async () => {
    const { error } = await supabase.auth.signInWithOAuth({
      provider: 'google',
      options: { redirectTo: `${window.location.origin}/auth/callback` },
    });
    if (error) setMsg('Ошибка: ' + error.message, 'error');
  });

  document.getElementById('emailForm')!.addEventListener('submit', async (e) => {
    e.preventDefault();
    const input = document.getElementById('emailInput') as HTMLInputElement;
    const btn = document.getElementById('emailBtn') as HTMLButtonElement;
    const email = input.value.trim();
    if (!email) return;
    btn.disabled = true; btn.textContent = 'Отправляем…';
    const { error } = await supabase.auth.signInWithOtp({
      email,
      options: { emailRedirectTo: `${window.location.origin}/auth/callback` },
    });
    if (error) { setMsg('Ошибка: ' + error.message, 'error'); btn.disabled = false; btn.textContent = 'Получить ссылку для входа'; }
    else { setMsg('Готово! Отправили ссылку для входа на ' + email + '. Проверьте почту (и папку «Спам»).', 'ok'); btn.textContent = 'Ссылка отправлена'; }
  });
</script>
