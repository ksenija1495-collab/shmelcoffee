---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import { recipesData } from '../data/recipes';
---

<Layout title="Рецепты заваривания — Shmelco">
  <Nav />
  <div class="container">
    <div class="section-anchor page-section">
      <div class="section-title">Рецепты заваривания</div>
      <p class="section-desc">Рецепты чемпионов и проверенные классические рецепты для каждого метода</p>
      <div class="recipe-tabs" id="recipeTabs"></div>
      <div id="recipePages"></div>
    </div>
  </div>
</Layout>

<script define:vars={{ recipesData }}>
const paramLabels = {dose:'Кофе',water:'Вода',ratio:'Пропорция',grind:'Помол',temp:'Температура',time:'Время',yield:'Выход',milk:'Молоко'};
let activeRecipeTab = 'v60';

const params = new URLSearchParams(window.location.search);
const tabParam = params.get('tab');
if (tabParam && recipesData[tabParam]) {
  activeRecipeTab = tabParam;
}

function renderRecipes(){
  const tabs = document.getElementById('recipeTabs');
  const pages = document.getElementById('recipePages');
  tabs.innerHTML = Object.entries(recipesData).map(([k,v])=>
    `<div class="recipe-tab ${k===activeRecipeTab?'active':''}" data-tab="${k}">${v.icon} ${v.name}</div>`
  ).join('');
  pages.innerHTML = Object.entries(recipesData).map(([k,v])=>
    `<div class="recipe-page ${k===activeRecipeTab?'active':''}" id="rp-${k}">
      ${v.recipes.map((r,i)=>`
        <div class="recipe-card" id="rc-${k}-${i}">
          <div class="recipe-card-header" data-method="${k}" data-idx="${i}">
            <div class="recipe-card-left">
              <span class="recipe-badge ${r.badge}">${r.badgeText}</span>
              <div>
                <div class="recipe-card-title">${r.title}</div>
                <div class="recipe-card-sub">${r.sub}</div>
              </div>
            </div>
            <span class="recipe-chevron">▼</span>
          </div>
          <div class="recipe-card-body">
            <div class="recipe-params">
              ${Object.entries(r.params).map(([pk,pv])=>{
                return `<div class="recipe-param"><div class="recipe-param-label">${paramLabels[pk]||pk}</div><div class="recipe-param-value">${pv}</div></div>`;
              }).join('')}
            </div>
            <div class="recipe-steps">
              ${r.steps.map(s=>`<div class="recipe-step">${s}</div>`).join('')}
            </div>
            <div class="recipe-tip"><strong>Совет:</strong> ${r.tip}</div>
          </div>
        </div>
      `).join('')}
    </div>`
  ).join('');

  tabs.querySelectorAll('.recipe-tab').forEach(t => {
    t.addEventListener('click', () => switchRecipeTab(t.dataset.tab));
  });
  document.querySelectorAll('.recipe-card-header').forEach(h => {
    h.addEventListener('click', () => toggleRecipe(h.dataset.method, parseInt(h.dataset.idx)));
  });
}

function switchRecipeTab(tab){
  activeRecipeTab = tab;
  document.querySelectorAll('.recipe-tab').forEach(t=>t.classList.toggle('active', t.dataset.tab === tab));
  document.querySelectorAll('.recipe-page').forEach(p=>p.classList.remove('active'));
  document.getElementById('rp-'+tab).classList.add('active');
}

function toggleRecipe(method,idx){
  document.getElementById('rc-'+method+'-'+idx).classList.toggle('open');
}

renderRecipes();
</script>
