---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import { SITE_URL } from '../lib/seo';

const pageTitle = 'Shmelcoffee — практика вкуса';
const pageDesc = 'Coffee Journeys в лаборатории, бесплатный кофейный дневник и дрип-наборы. Учимся слышать чашку.';
const ogImage = `${SITE_URL}/og/home.png`;

const seatUrl = 'https://t.me/ksenijashmel?text=' + encodeURIComponent('Хочу на Coffee Journey «История кофе», 22 ноября');
const kitUrl = 'https://t.me/ksenijashmel?text=' + encodeURIComponent('Хочу дрип-набор, когда появится');
const threadsUrl = 'https://www.threads.com/@shmelcoffee';
const channelUrl = 'https://t.me/shmel_coffee';

const lots = [
  { flag: '🇪🇹', name: 'Эфиопия', note: 'мытая' },
  { flag: '🇪🇹', name: 'Эфиопия', note: 'натуральная' },
  { flag: '🇮🇩', name: 'Индонезия Гайо', note: '' },
  { flag: '🇷🇼', name: 'Руанда Муремуре', note: '' },
  { flag: '🇰🇪', name: 'Кения Гитура', note: '' },
];
---

<Layout
  title={pageTitle}
  description={pageDesc}
  ogImage={ogImage}
  ogImageAlt="Shmelcoffee — комната, дневник и наборы"
  keywords={['Shmelcoffee', 'Coffee Journeys', 'каппинг', 'дневник кофе', 'дрип-набор', 'specialty coffee']}
>
  <Nav />

  <header class="eco-hero">
    <div class="container">
      <p class="eco-eyebrow">Shmelcoffee</p>
      <h1>Практика вкуса</h1>
      <p class="eco-lead">Комната, дневник и наборы. Чтобы слышать чашку, а не пить её на автомате.</p>
      <div class="eco-doors">
        <a href="#journeys" class="eco-door">
          <b>Coffee Journeys</b>
          <span>Офлайн в лаборатории</span>
        </a>
        <a href="#diary" class="eco-door">
          <b>Дневник</b>
          <span>Бесплатно</span>
        </a>
        <a href="#kits" class="eco-door">
          <b>Дрип-наборы</b>
          <span>Скоро</span>
        </a>
      </div>
    </div>
  </header>

  <div class="container eco-body">

    <section id="journeys" class="eco-block">
      <h2>Coffee Journeys</h2>
      <p class="eco-text">Встречи в моей кофейной лаборатории. Одна тема, несколько чашек, маленькая компания. Разбираем страну, обработку и вкус — и пробуем это в чашке.</p>

      <article class="eco-event">
        <p class="eco-eyebrow">Ближайшая встреча</p>
        <h3>История кофе</h3>
        <p class="eco-event-sub">От эфиопского наследия до современной селекции</p>
        <ul class="eco-meta">
          <li>22 ноября, воскресенье, 11:30</li>
          <li>2 часа · моя кофейная лаборатория</li>
          <li>2 800 ₽</li>
          <li>Осталось 2 из 5</li>
        </ul>
        <p class="eco-text">Пять лотов и есть маршрут. Сравниваем аромат, кислотность, сладость, плотность и послевкусие.</p>
        <ul class="eco-lots">
          {lots.map((lot) => (
            <li>
              <span aria-hidden="true">{lot.flag}</span>
              <b>{lot.name}</b>
              {lot.note && <small>{lot.note}</small>}
            </li>
          ))}
        </ul>
        <p class="eco-text">Домой каждый уносит дрип-пакеты с этой дегустации — продолжить те же чашки уже у себя.</p>
        <p class="eco-fit">Подойдёт и тем, кто только знакомится со specialty, и тем, кто уже в кофе и хочет глубже.</p>
        <a class="btn btn-primary" href={seatUrl} target="_blank" rel="noopener">Занять место</a>
      </article>
    </section>

    <section id="diary" class="eco-block">
      <h2>Дневник</h2>
      <p class="eco-text">Бесплатно. Записываешь чашку — остаётся язык, которым потом пользуешься на встрече.</p>
      <div class="eco-pair">
        <a class="eco-link" href="/quiz">
          <b>Твой дневник</b>
          <span>Кабинет: чашки, полка, страны</span>
        </a>
        <a class="eco-link" href={threadsUrl} target="_blank" rel="noopener">
          <b>Мой дневник</b>
          <span>Threads · @shmelcoffee</span>
        </a>
      </div>
    </section>

    <section id="kits" class="eco-block">
      <h2>Дрип-наборы</h2>
      <p class="eco-text">Домашнее погружение между встречами: набор дрип-пакетов, чтобы самой пройти вкусы. Скоро в продаже.</p>
      <p class="eco-note">Пакеты с встречи 22 ноября — продолжение той дегустации. Набор — отдельный продукт.</p>
      <a class="btn" href={kitUrl} target="_blank" rel="noopener">Написать, когда выйдет</a>
    </section>

    <section class="eco-materials">
      <a href={channelUrl} target="_blank" rel="noopener">Канал с анонсами · @shmel_coffee</a>
      <a href="/blog">Блог</a>
    </section>

  </div>
</Layout>

<style>
  .eco-hero {
    padding: 108px 0 48px;
    background: linear-gradient(180deg, var(--surface) 0%, var(--bg) 100%);
    border-bottom: 1px solid var(--border);
  }
  .eco-eyebrow {
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 12px;
  }
  .eco-hero h1 {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 3.4rem;
    line-height: 1.02;
    font-weight: 600;
    letter-spacing: -.02em;
    margin-bottom: 14px;
  }
  .eco-lead {
    max-width: 460px;
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--text-dim);
    margin-bottom: 28px;
  }
  .eco-doors {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    max-width: 720px;
  }
  .eco-door {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 18px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    text-decoration: none;
    color: inherit;
    box-shadow: var(--shadow);
  }
  .eco-door:hover { border-color: var(--border-hover); box-shadow: var(--shadow-hover); }
  .eco-door b { font-size: .92rem; }
  .eco-door span { font-size: .78rem; color: var(--text-muted); }

  .eco-body { padding-top: 8px; }
  .eco-block { padding: 56px 0 8px; }
  .eco-block h2 {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 2rem;
    font-weight: 600;
    margin-bottom: 10px;
  }
  .eco-text {
    max-width: 560px;
    color: var(--text-dim);
    font-size: .92rem;
    line-height: 1.65;
    margin-bottom: 16px;
  }
  .eco-event {
    margin-top: 8px;
    padding: 28px 26px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 18px;
    box-shadow: var(--shadow);
    max-width: 640px;
  }
  .eco-event h3 {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 2.1rem;
    font-weight: 600;
    line-height: 1.1;
    margin-bottom: 6px;
  }
  .eco-event-sub {
    color: var(--text-dim);
    font-size: .92rem;
    margin-bottom: 16px;
  }
  .eco-meta {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 18px;
  }
  .eco-meta li {
    font-size: .78rem;
    font-weight: 600;
    color: var(--text);
    background: var(--surface-2);
    border-radius: 8px;
    padding: 6px 10px;
  }
  .eco-lots {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 16px;
  }
  .eco-lots li {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: .9rem;
  }
  .eco-lots small { color: var(--text-muted); font-size: .78rem; }
  .eco-fit {
    font-size: .84rem;
    color: var(--text-dim);
    line-height: 1.55;
    margin-bottom: 18px;
    max-width: 520px;
  }
  .eco-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    max-width: 640px;
  }
  .eco-link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 18px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    text-decoration: none;
    color: inherit;
  }
  .eco-link:hover { border-color: var(--border-hover); box-shadow: var(--shadow-hover); }
  .eco-link b { font-size: .92rem; }
  .eco-link span { font-size: .78rem; color: var(--text-muted); }
  .eco-note {
    font-size: .82rem;
    color: var(--text-muted);
    max-width: 520px;
    margin: -6px 0 16px;
    line-height: 1.5;
  }
  .eco-materials {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
    padding: 48px 0 24px;
  }
  .eco-materials a {
    font-size: .84rem;
    font-weight: 600;
    color: var(--text-dim);
    text-decoration: none;
  }
  .eco-materials a:hover { color: var(--accent); }

  @media (max-width: 700px) {
    .eco-hero { padding-top: 88px; }
    .eco-hero h1 { font-size: 2.5rem; }
    .eco-doors, .eco-pair { grid-template-columns: 1fr; }
    .eco-event { padding: 22px 18px; }
  }
</style>
