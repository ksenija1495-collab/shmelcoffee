---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import { wheelData } from '../data/wheel';
import { DB, countryOrder } from '../data/countries';
import { heroImg } from '../data/heroImg';
const SUPA_URL = import.meta.env.PUBLIC_SUPABASE_URL || '';
const SUPA_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '';
---

<Layout title="А ты знаешь свой вкус кофе? — Shmelco" description="Путешествие в мир кофе: узнай свой вкус, колесо вкусов и география вкусов.">
  <Nav />

  <section class="hero-full" id="heroFull">
    <img src={heroImg} alt="" loading="eager" onerror="document.getElementById('heroFull').classList.add('noimg')"/>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <div class="hero-eyebrow">Путешествие в&nbsp;мир кофе</div>
      <h1>А ты знаешь свой вкус кофе?</h1>
      <p class="hero-sub">Проведём тебя за&nbsp;руку через зёрна, обработки и&nbsp;методы заваривания, чтобы ты&nbsp;узнал, какой кофе именно твой.</p>
      <p class="hero-mini">У&nbsp;каждого человека свой вкус. Где-то рядом может быть твой вкусовой близнец. Или полная противоположность! Найди&nbsp;их.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/quiz">Узнать свой вкус →</a>
        <a class="btn hero-ghost" href="/account">Войти в&nbsp;кабинет</a>
      </div>
    </div>
  </section>

  <div class="container">

    <section class="preview-section">
      <div class="preview-grid">
        <div class="preview-text">
          <h2 class="sec-heading prev-h">Что ты получишь</h2>
          <p class="preview-lead">За&nbsp;2&nbsp;минуты — твой вкусовой профиль и&nbsp;красивый паспорт, которым можно поделиться. Плюс карта стран, которые стоит открыть первыми, и&nbsp;персональные гиды под твоё зерно.</p>
          <a class="btn btn-primary" href="/quiz">Узнать свой вкус →</a>
        </div>
        <div class="preview-card">
          <div class="pv-eyebrow">Пример паспорта</div>
          <div class="pv-emoji">🍓</div>
          <div class="pv-arch">Фруктовый&nbsp;исследователь</div>
          <div class="pv-line">ищет яркость и&nbsp;сочную кислотность</div>
          <div class="pv-fams"><span class="pv-fam">Ягоды</span><span class="pv-fam">Цитрус</span><span class="pv-fam">Цветочный</span></div>
          <div class="pv-stat"><b>5&nbsp;/&nbsp;12</b> стран ждут открытия</div>
        </div>
      </div>
    </section>

    <section class="curio">
      <p class="curio-fact">В одной чашке кофе больше <b>800&nbsp;ароматов</b>. Больше,&nbsp;чем&nbsp;в&nbsp;вине.</p>
      <p class="curio-lead">Если знать, можно управлять вкусом через&nbsp;выбор:</p>
      <div class="curio-factors">
        <span class="cf">Зерно</span><span class="cf-sep">·</span><span class="cf">Обработка</span><span class="cf-sep">·</span><span class="cf">Метод заварки</span>
      </div>
    </section>

    <section class="wheel-section" id="wheel">
      <h2 class="sec-heading">Колесо вкусов</h2>
      <p class="sec-sub">От жасмина и&nbsp;чёрной смородины до&nbsp;шоколада и&nbsp;специй: это язык, на&nbsp;котором говорит кофе. Нажми на&nbsp;сегмент и&nbsp;узнай, где рождается этот вкус</p>
      <svg id="wheelSvg" class="wheel-svg" viewBox="0 0 720 720" aria-label="Колесо вкусов кофе"></svg>
      <div class="wheel-tooltip" id="wheelTooltip"><div class="wheel-tooltip-title" id="tooltipTitle"></div><div class="wheel-tooltip-origins" id="tooltipOrigins"></div></div>
      <div class="wheel-info-panel" id="wheelInfoPanel"></div>
    </section>

    <section class="geo-section" id="geo">
      <h2 class="sec-heading">География вкусов</h2>
      <p class="sec-sub">Кофе растёт вдоль экватора. Подсвеченные страны кликабельны: наведи и&nbsp;нажми, чтобы увидеть палитру вкусов</p>
      <div class="map-wrap"><svg id="geoMap" class="geo-map" viewBox="0 110 640 90"><text x="320" y="155" text-anchor="middle" font-family="'Inter',sans-serif" font-size="13" fill="var(--text-muted)">Загружаем карту…</text></svg></div>
      <div class="geo-info" id="geoInfo"></div>
    </section>

    <section class="comm-section">
      <h2 class="sec-heading">Карта вкусов сообщества</h2>
      <p class="sec-sub">Нет «правильного» вкуса, есть твой. Посмотри, что любят другие, и&nbsp;где среди них&nbsp;ты</p>
      <div id="commCard" class="comm-card"><div class="comm-empty">Загружаем…</div></div>
      <a class="btn btn-primary" href="/quiz" style="margin-top:22px">Найти свой профиль →</a>
    </section>

    <section class="twin-section">
      <h2 class="sec-heading">У каждого есть вкусовой близнец</h2>
      <p class="sec-sub">Где-то рядом — человек, который любит ровно твой кофе. А&nbsp;где-то — полная противоположность. Найди и&nbsp;тех, и&nbsp;других.</p>
      <div class="twin-grid">
        <div class="twin-card"><div class="twin-emoji">🤝</div><div class="twin-t">Вкусовой близнец</div><div class="twin-d">Тот, у&nbsp;кого профиль совпадает с&nbsp;твоим. Делитесь находками и&nbsp;зёрнами.</div></div>
        <div class="twin-card opp"><div class="twin-emoji">🌗</div><div class="twin-t">Противоположность</div><div class="twin-d">Полный контраст вкуса — отличный повод попробовать что-то совсем новое.</div></div>
      </div>
      <a class="btn btn-primary" href="/quiz" style="margin-top:24px">Найти своих →</a>
    </section>

    <section class="steps-section">
      <h2 class="sec-heading">Как это работает</h2>
      <div class="steps">
        <div class="step"><div class="step-n">1</div><div class="step-t">Короткая диагностика</div><div class="step-d">4 вопроса о&nbsp;вкусе</div></div>
        <div class="step"><div class="step-n">2</div><div class="step-t">Карта вкуса и&nbsp;открытий</div><div class="step-d">что любишь и&nbsp;что ещё не&nbsp;пробовал</div></div>
        <div class="step"><div class="step-n">3</div><div class="step-t">Исследуй и&nbsp;записывай</div><div class="step-d">зёрна, страны, методы; карта открывается</div></div>
      </div>
    </section>

    <section class="final-cta">
      <h2 class="sec-heading">Готов узнать, какой кофе твой?</h2>
      <a class="btn btn-primary" href="/quiz">Начать путешествие →</a>
    </section>

    <section class="contacts-section">
      <div class="contacts-grid">
        <a href="https://t.me/shmel_coffee" target="_blank" class="contact-card"><span class="contact-name">Telegram</span><span class="contact-handle">@shmel_coffee</span></a>
        <a href="https://www.threads.net/@shmelcoffee" target="_blank" class="contact-card"><span class="contact-name">Threads</span><span class="contact-handle">@shmelcoffee</span></a>
        <a href="https://t.me/ksenijashmel" target="_blank" class="contact-card"><span class="contact-name">Связаться</span><span class="contact-handle">@ksenijashmel</span></a>
      </div>
    </section>

  </div>
</Layout>

<style>
  .hero-full { position: relative; width: 100vw; margin-left: calc(50% - 50vw); min-height: 560px; height: 80vh; max-height: 660px; display: flex; align-items: center; justify-content: center; background: #2b1d14; overflow: hidden; }
  .hero-full img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero-full.noimg img { display: none; }
  .hero-overlay { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(43,29,20,.45) 0%, rgba(43,29,20,.55) 45%, rgba(43,29,20,.82) 100%); }
  .hero-content { position: relative; z-index: 2; text-align: center; color: #fff; padding: 90px 24px 40px; max-width: 780px; }
  .hero-eyebrow { text-transform: uppercase; letter-spacing: .22em; font-size: .72rem; color: #e9d8c2; font-weight: 600; margin-bottom: 18px; }
  .hero-content h1 { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 3.6rem; line-height: 1.08; font-weight: 600; color: #fff; margin-bottom: 18px; letter-spacing: -.01em; }
  .hero-sub { font-size: 1.05rem; color: #f3ece2; max-width: 600px; margin: 0 auto 14px; line-height: 1.6; }
  .hero-mini { font-size: .92rem; color: #d8c8b8; max-width: 560px; margin: 0 auto 28px; line-height: 1.55; }
  .hero-actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .hero-ghost { background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.5); color: #fff; backdrop-filter: blur(4px); }
  .hero-ghost:hover { background: rgba(255,255,255,.22); color: #fff; border-color: #fff; }

  .container > section { margin-bottom: 72px; }
  .container > section:first-child { margin-top: 56px; }

  .preview-grid { display: grid; grid-template-columns: 1.05fr .95fr; gap: 30px; align-items: center; max-width: 900px; margin: 0 auto; }
  .prev-h { text-align: left; margin-bottom: 12px; }
  .preview-lead { font-size: .98rem; color: var(--text-dim); line-height: 1.6; margin-bottom: 22px; }
  .preview-card { background: linear-gradient(160deg, #fffaf2 0%, #f6ecdc 100%); border: 1px solid var(--border); border-radius: 20px; box-shadow: var(--shadow-hover); padding: 26px 24px; text-align: center; }
  .pv-eyebrow { text-transform: uppercase; letter-spacing: .18em; font-size: .62rem; color: var(--accent); font-weight: 700; }
  .pv-emoji { font-size: 2.2rem; margin: 8px 0 2px; }
  .pv-arch { font-family: 'Cormorant Garamond', serif; font-size: 1.5rem; font-weight: 700; line-height: 1.1; }
  .pv-line { font-size: .84rem; color: var(--text-dim); margin-bottom: 12px; }
  .pv-fams { display: flex; flex-wrap: wrap; gap: 6px; justify-content: center; margin-bottom: 14px; }
  .pv-fam { font-size: .74rem; padding: 4px 11px; border-radius: 20px; background: rgba(168,124,79,.12); border: 1px solid rgba(168,124,79,.25); color: var(--accent); font-weight: 600; }
  .pv-stat { font-size: .82rem; color: var(--text-muted); border-top: 1px solid var(--border); padding-top: 12px; }
  .pv-stat b { font-family: 'Cormorant Garamond', serif; font-size: 1.1rem; color: var(--accent); }

  .curio { text-align: center; max-width: 820px; margin-left: auto; margin-right: auto; padding: 36px 28px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); box-shadow: var(--shadow); }
  .curio-fact { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1.9rem; font-weight: 500; line-height: 1.25; margin: 0 0 18px; }
  .curio-fact b { color: var(--accent); font-weight: 600; }
  .curio-lead { font-size: .95rem; color: var(--text-dim); margin: 0 0 14px; }
  .curio-factors { display: flex; gap: 12px; justify-content: center; align-items: center; flex-wrap: wrap; }
  .cf { font-weight: 600; color: var(--text); background: var(--surface-2); border: 1px solid var(--border); padding: 8px 20px; border-radius: 24px; font-size: .95rem; }
  .cf-sep { color: var(--border-hover); }

  .sec-heading { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 2rem; font-weight: 600; margin-bottom: 8px; text-align: center; letter-spacing: -.01em; }
  .sec-sub { color: var(--text-dim); font-size: .9rem; margin: 0 auto 28px; text-align: center; max-width: 600px; line-height: 1.65; }

  .wheel-section { text-align: center; scroll-margin-top: 72px; }
  .wheel-svg { max-width: min(680px, 96vw); width: 100%; height: auto; margin: 0 auto; display: block; }

  .map-wrap { max-width: 860px; margin: 0 auto; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 18px; box-shadow: var(--shadow); }
  .geo-map { width: 100%; display: block; }
  .geo-map path[data-k] { transition: fill .15s; cursor: pointer; }
  .geo-info { max-width: 560px; margin: 16px auto 0; display: none; }
  .geo-info.active { display: block; padding: 20px 22px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); box-shadow: var(--shadow); animation: fadein .2s ease; }
  @keyframes fadein { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }
  .geo-info h3 { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1.4rem; font-weight: 600; margin-bottom: 2px; }

  .wheel-info-panel { max-width: 620px; margin: 18px auto 0; display: none; }
  .wheel-info-panel.active { display: block; padding: 22px 24px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); box-shadow: var(--shadow); text-align: left; animation: fadein .2s ease; }
  .wheel-tooltip { position: fixed; z-index: 50; pointer-events: none; background: var(--text); color: #fff; padding: 8px 12px; border-radius: 8px; font-size: .8rem; max-width: 240px; opacity: 0; transition: opacity .12s; box-shadow: 0 6px 20px rgba(0,0,0,.25); }
  .wheel-tooltip.visible { opacity: 1; }
  .wheel-tooltip-title { font-weight: 700; margin-bottom: 2px; }
  .wheel-tooltip-origins { font-size: .74rem; opacity: .9; }

  .comm-section { text-align: center; }
  .comm-card { max-width: 760px; margin: 0 auto; padding: 24px 28px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); box-shadow: var(--shadow); }

  .twin-section { text-align: center; }
  .twin-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; max-width: 720px; margin: 0 auto; }
  .twin-card { padding: 26px 22px; border-radius: var(--radius-lg); border: 1px solid var(--border); background: var(--surface); box-shadow: var(--shadow); }
  .twin-card.opp { background: var(--surface-2); }
  .twin-emoji { font-size: 2rem; margin-bottom: 8px; }
  .twin-t { font-weight: 700; font-size: 1rem; margin-bottom: 6px; }
  .twin-d { font-size: .84rem; color: var(--text-dim); line-height: 1.55; }

  .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; max-width: 820px; margin: 0 auto; }
  .step { text-align: center; padding: 26px 18px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); box-shadow: var(--shadow); }
  .step-n { width: 36px; height: 36px; border-radius: 50%; background: var(--accent); color: #fff; font-weight: 700; display: flex; align-items: center; justify-content: center; margin: 0 auto 14px; }
  .step-t { font-weight: 700; font-size: .92rem; }
  .step-d { font-size: .82rem; color: var(--text-muted); margin-top: 5px; line-height: 1.45; }

  .final-cta { text-align: center; }
  .final-cta .sec-heading { margin-bottom: 20px; }

  .contacts-section { margin-bottom: 64px; }
  .contacts-grid { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .contact-card { display: inline-flex; flex-direction: column; align-items: center; gap: 2px; padding: 12px 22px; border-radius: 10px; background: var(--surface); border: 1px solid var(--border); text-decoration: none; color: inherit; transition: all .2s; box-shadow: var(--shadow); }
  .contact-card:hover { border-color: var(--border-hover); box-shadow: var(--shadow-hover); }
  .contact-name { font-weight: 600; font-size: .84rem; }
  .contact-handle { font-size: .78rem; color: var(--accent); font-weight: 500; }

  @media (max-width: 768px) {
    .hero-content h1 { font-size: 2.4rem; }
    .hero-full { min-height: 480px; height: 70vh; }
    .preview-grid { grid-template-columns: 1fr; gap: 22px; }
    .prev-h { text-align: center; }
    .preview-text { text-align: center; }
    .twin-grid { grid-template-columns: 1fr; }
    .curio-fact { font-size: 1.5rem; }
    .sec-heading { font-size: 1.6rem; }
    .steps { grid-template-columns: 1fr; }
    .contacts-grid { flex-direction: column; align-items: center; }
    .container > section { margin-bottom: 52px; }
  }
</style>

<style is:global>
  /* Блоки, которые рисует скрипт через innerHTML — Astro scoped-стили до них не доходят, поэтому здесь глобально (с привязкой к id-контейнерам, чтобы не текло) */
  #commCard .comm-empty { color: var(--text-muted); font-size: .88rem; text-align: center; padding: 14px 0; }
  #commCard .comm-compact { display: flex; align-items: center; gap: 28px; flex-wrap: wrap; justify-content: center; }
  #commCard .comm-num { text-align: center; flex-shrink: 0; }
  #commCard .comm-num b { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 2.8rem; font-weight: 600; color: var(--accent); display: block; line-height: 1; }
  #commCard .comm-num span { font-size: .72rem; color: var(--text-muted); }
  #commCard .comm-mid { flex: 1; min-width: 260px; }
  #commCard .cs-bar { display: flex; height: 20px; border-radius: 10px; overflow: hidden; box-shadow: inset 0 0 0 1px rgba(70,41,24,.05); }
  #commCard .cs-seg { height: 100%; }
  #commCard .cs-legwrap { display: flex; flex-wrap: wrap; gap: 8px 16px; margin-top: 12px; }
  #commCard .cs-leg { display: flex; align-items: center; gap: 6px; font-size: .8rem; color: var(--text-dim); }
  #commCard .cs-leg i { width: 11px; height: 11px; border-radius: 3px; flex-shrink: 0; }
  #commCard .comm-cc { display: flex; align-items: center; gap: 9px; flex-wrap: wrap; justify-content: center; margin-top: 18px; padding-top: 16px; border-top: 1px solid var(--border); }
  #commCard .cc-h { font-size: .72rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: .06em; }
  #commCard .cc-chip { display: inline-flex; align-items: center; gap: 8px; font-size: .82rem; background: var(--surface-2); border: 1px solid var(--border); border-radius: 20px; padding: 5px 6px 5px 13px; color: var(--text-dim); }
  #commCard .cc-n { display: inline-flex; align-items: center; justify-content: center; min-width: 22px; height: 20px; padding: 0 7px; background: var(--accent); color: #fff; font-size: .74rem; font-weight: 700; border-radius: 11px; }

  #wheelInfoPanel h3 { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1.5rem; font-weight: 600; margin: 0 0 14px; text-align: center; }
  #wheelInfoPanel .wheel-flavor-list { display: grid; gap: 12px; }
  #wheelInfoPanel .wheel-flavor-item { padding: 12px 14px; background: var(--surface-2); border: 1px solid var(--border); border-radius: 12px; }
  #wheelInfoPanel .wheel-flavor-name { font-weight: 700; font-size: .92rem; margin-bottom: 4px; }
  #wheelInfoPanel .wheel-flavor-origins { font-size: .84rem; color: var(--text-dim); line-height: 1.55; }
  #wheelInfoPanel .wheel-flavor-origins a { color: var(--accent); font-weight: 600; text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: 2px; cursor: pointer; }
  #wheelInfoPanel .wheel-flavor-origins a:hover { background: rgba(168,124,79,.12); }

  #geoInfo h3 { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1.4rem; font-weight: 600; margin-bottom: 2px; }
  #geoInfo .geo-region { font-size: .78rem; color: var(--text-muted); margin-bottom: 12px; }
  #geoInfo .geo-tags { display: flex; flex-wrap: wrap; gap: 7px; margin-bottom: 14px; }
  #geoInfo .geo-tag { padding: 5px 13px; border-radius: 20px; background: rgba(168,124,79,.1); border: 1px solid rgba(168,124,79,.22); font-size: .8rem; color: var(--accent); font-weight: 600; }
  #geoInfo .geo-link { color: var(--accent); font-weight: 600; font-size: .84rem; text-decoration: none; }
  #geoInfo .geo-link:hover { text-decoration: underline; }
</style>

<script is:inline src="https://cdn.jsdelivr.net/npm/d3@7/dist/d3.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/topojson-client@3/dist/topojson-client.min.js"></script>

<script define:vars={{ wheelData, DB, countryOrder, SUPA_URL, SUPA_KEY }}>
import { initFlavorWheel } from '../lib/flavorWheel';
const countryMap={ 'Эфиопия':'ethiopia','Кения':'kenya','Колумбия':'colombia','Бразилия':'brazil','Гватемала':'guatemala','Коста-Рика':'costarica','Панама':'panama','Руанда':'rwanda','Индонезия':'indonesia','Йемен':'yemen','Гондурас':'honduras','Перу':'peru' };
function linkOrigins(text){ let out=text; for(const [name,key] of Object.entries(countryMap)){ out=out.replace(new RegExp(name,'g'),`<a href="/countries?c=${key}">${name}</a>`); } return out; }
function buildWheel(){ initFlavorWheel(wheelData, { centerLabel: 'single', linkOrigins }); }

function showGeo(k){ const c=DB[k]; const el=document.getElementById('geoInfo'); if(!c||!el) return; el.innerHTML=`<h3>${c.flag} ${c.name}</h3><div class="geo-region">${c.region||''}</div><div class="geo-tags">${(c.flavors||[]).map(f=>`<span class="geo-tag">${f}</span>`).join('')}</div><a href="/countries?c=${k}" class="geo-link" style="color:var(--accent)">Подробнее о&nbsp;стране →</a>`; el.classList.add('active'); }
const ENG={ ethiopia:'Ethiopia',kenya:'Kenya',rwanda:'Rwanda',yemen:'Yemen',colombia:'Colombia',brazil:'Brazil',guatemala:'Guatemala',honduras:'Honduras',costarica:'Costa Rica',panama:'Panama',peru:'Peru',indonesia:'Indonesia' };
async function drawMap(){
  const svg=document.getElementById('geoMap'); if(!svg) return;
  if(!window.d3||!window.topojson){ svg.innerHTML='<text x="320" y="155" text-anchor="middle" font-family="Inter,sans-serif" font-size="13" fill="var(--text-muted)">Карта недоступна</text>'; return; }
  try{
    const W=640,H=300;
    const world=await fetch('https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json').then(r=>r.json());
    const feats=window.topojson.feature(world, world.objects.countries).features;
    const proj=window.d3.geoNaturalEarth1().fitExtent([[8,8],[W-8,H-8]], {type:'Sphere'});
    const path=window.d3.geoPath(proj);
    const nameToKey={}; Object.entries(ENG).forEach(([k,v])=>nameToKey[v]=k);
    let html='';
    feats.forEach(f=>{ const d=path(f); if(!d) return; const k=nameToKey[f.properties.name]; if(k){ html+=`<path d="${d}" fill="#BA7517" stroke="var(--surface)" stroke-width="0.6" data-k="${k}"><title>${DB[k].flag} ${DB[k].name}</title></path>`; } else { html+=`<path d="${d}" fill="var(--surface-2)" stroke="var(--border)" stroke-width="0.4"></path>`; } });
    svg.innerHTML=html;
    const yTop=proj([0,32])[1], yBot=proj([0,-34])[1];
    svg.setAttribute('viewBox', `0 ${Math.round(yTop)} ${W} ${Math.round(yBot-yTop)}`);
    svg.querySelectorAll('path[data-k]').forEach(p=>{
      p.addEventListener('mouseenter',()=>{ if(p.dataset.sel!=='1') p.setAttribute('fill','#9a6212'); });
      p.addEventListener('mouseleave',()=>{ if(p.dataset.sel!=='1') p.setAttribute('fill','#BA7517'); });
      p.addEventListener('click',()=>{ svg.querySelectorAll('path[data-k]').forEach(q=>{q.setAttribute('fill','#BA7517');q.dataset.sel='';}); p.setAttribute('fill','#854F0B'); p.dataset.sel='1'; showGeo(p.dataset.k); });
    });
  }catch(e){ svg.innerHTML='<text x="320" y="155" text-anchor="middle" font-family="Inter,sans-serif" font-size="13" fill="var(--text-muted)">Не удалось загрузить карту</text>'; }
}

const FLC={fruity:'#C47070',floral:'#D4A0B8',chocolate:'#8B6B4A',caramel:'#D4B870',spicy:'#C0A060',tropical:'#C49080'};
const FL={fruity:'Фруктовые',floral:'Цветочные и чайные',chocolate:'Шоколад и орехи',caramel:'Карамель и мёд',spicy:'Пряные',tropical:'Тропические'};
async function loadCommunity(){
  const el=document.getElementById('commCard'); if(!el) return;
  if(!SUPA_URL||!SUPA_KEY){ el.innerHTML='<div class="comm-empty">Статистика появится позже.</div>'; return; }
  try{
    const res=await fetch(`${SUPA_URL}/rest/v1/rpc/get_community_stats`,{ method:'POST', headers:{ 'Content-Type':'application/json','apikey':SUPA_KEY,'Authorization':`Bearer ${SUPA_KEY}` }, body:'{}' });
    if(!res.ok){ el.innerHTML='<div class="comm-empty">Пока нет данных.</div>'; return; }
    let data=await res.json(); if(Array.isArray(data)) data=data[0];
    const flagByName={}; for(const k of Object.keys(DB)) flagByName[DB[k].name]=DB[k].flag;
    const total=(data&&data.total_users)||0; const flavors=((data&&data.flavors)||[]).slice(0,6); const countries=((data&&data.countries)||[]).slice(0,6);
    if(!flavors.length&&!countries.length){ el.innerHTML='<div class="comm-empty">Станешь одним из первых. Пройди тест и появишься на карте.</div>'; return; }
    const fsum=flavors.reduce((s,x)=>s+x.users,0)||1;
    const stack=flavors.map(x=>`<span class="cs-seg" style="width:${(x.users/fsum*100).toFixed(1)}%;background:${FLC[x.flavor]||'#BA7517'}" title="${FL[x.flavor]||x.flavor}"></span>`).join('');
    const leg=flavors.map(x=>`<span class="cs-leg"><i style="background:${FLC[x.flavor]||'#BA7517'}"></i>${FL[x.flavor]||x.flavor}</span>`).join('');
    let html=`<div class="comm-compact"><div class="comm-num"><b>${total}</b><span>профилей сообщества</span></div><div class="comm-mid"><div class="cs-bar">${stack}</div><div class="cs-legwrap">${leg}</div></div></div>`;
    if(countries.length){ html+='<div class="comm-cc"><span class="cc-h">Чаще открывают:</span>'+countries.map(x=>`<span class="cc-chip">${flagByName[x.origin]||''} ${x.origin}<span class="cc-n">${x.users}</span></span>`).join('')+'</div>'; }
    const roasters=((data&&data.roasters)||[]).slice(0,4);
    if(roasters.length){ html+='<div class="comm-cc"><span class="cc-h">Топ обжarщиков:</span>'+roasters.map(x=>`<span class="cc-chip">☕ ${x.roaster}<span class="cc-n">${x.clicks}</span></span>`).join('')+'</div>'; }
    el.innerHTML=html;
  }catch(e){ el.innerHTML='<div class="comm-empty">Не удалось загрузить статистику.</div>'; }
}
buildWheel(); drawMap(); loadCommunity();
</script>
