---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import { wheelData } from '../data/wheel';
import { DB, countryOrder } from '../data/countries';
const SUPA_URL = import.meta.env.PUBLIC_SUPABASE_URL || '';
const SUPA_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '';
---

<Layout title="А ты знаешь свой вкус кофе? — Shmelco" description="Путешествие в мир кофе: узнай свой вкус, колесо вкусов и география вкусов.">
  <Nav />
  <div class="container">

    <section class="hero">
      <div class="hero-photo" id="heroPhoto">
        <img src="https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&w=1200&q=80" alt="Чашка кофе" loading="eager" onerror="document.getElementById('heroPhoto').classList.add('noimg')"/>
      </div>
      <div class="hero-eyebrow">Путешествие в мир кофе</div>
      <h1>А ты знаешь свой вкус кофе?</h1>
      <p class="subtitle">Проведу тебя за руку через зёрна, обработки и методы заваривания, пока ты не поймёшь, какой кофе именно твой.</p>
      <p class="hero-mini">У каждого человека свой вкус. Где-то рядом может быть твой вкусовой близнец. Или полная противоположность! Найди их.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/quiz">Узнать свой вкус →</a>
        <a class="btn btn-ghost home-account-btn" href="/account">Войти в кабинет</a>
      </div>
    </section>

    <section class="curio">
      <p class="curio-fact">В одной чашке кофе больше <b>800 ароматов</b>. Больше, чем в вине.</p>
      <p class="curio-lead">Если знать, можно управлять вкусом через выбор:</p>
      <div class="curio-factors">
        <span class="cf">Зерно</span><span class="cf-sep">·</span><span class="cf">Обработка</span><span class="cf-sep">·</span><span class="cf">Метод заварки</span>
      </div>
    </section>

    <section class="wheel-section" id="wheel">
      <h2 class="sec-heading">Колесо вкусов</h2>
      <p class="sec-sub">От жасмина и чёрной смородины до шоколада и специй: это язык, на котором говорит кофе. Нажми на сегмент и узнай, где рождается этот вкус</p>
      <svg id="wheelSvg" class="wheel-svg" viewBox="0 0 620 620"></svg>
      <div class="wheel-tooltip" id="wheelTooltip"><div class="wheel-tooltip-title" id="tooltipTitle"></div><div class="wheel-tooltip-origins" id="tooltipOrigins"></div></div>
      <div class="wheel-info-panel" id="wheelInfoPanel"></div>
    </section>

    <section class="geo-section" id="geo">
      <h2 class="sec-heading">География вкусов</h2>
      <p class="sec-sub">Кофе растёт вдоль экватора. Подсвеченные страны кликабельны: нажми и увидишь их палитру вкусов</p>
      <div class="map-wrap"><svg id="geoMap" class="geo-map" viewBox="0 110 640 90"><text x="320" y="155" text-anchor="middle" font-family="'Inter',sans-serif" font-size="13" fill="var(--text-muted)">Загружаем карту…</text></svg></div>
      <div class="geo-info" id="geoInfo"></div>
    </section>

    <section class="comm-section">
      <h2 class="sec-heading">Карта вкусов сообщества</h2>
      <p class="sec-sub">Нет «правильного» вкуса, есть твой. Посмотри, что любят другие, и где среди них ты</p>
      <div id="commCard" class="comm-card"><div class="comm-empty">Загружаем…</div></div>
      <a class="btn btn-primary" href="/quiz" style="margin-top:20px">Найти свой профиль →</a>
    </section>

    <section class="steps-section">
      <h2 class="sec-heading">Как это работает</h2>
      <div class="steps">
        <div class="step"><div class="step-n">1</div><div class="step-t">Короткая диагностика</div><div class="step-d">4 вопроса о вкусе</div></div>
        <div class="step"><div class="step-n">2</div><div class="step-t">Карта вкуса и открытий</div><div class="step-d">что любишь и что ещё не пробовал</div></div>
        <div class="step"><div class="step-n">3</div><div class="step-t">Исследуй и записывай</div><div class="step-d">зёрна, страны, методы; карта открывается</div></div>
      </div>
    </section>

    <section class="final-cta">
      <h2 class="sec-heading">Готов узнать, какой кофе твой?</h2>
      <a class="btn btn-primary" href="/quiz">Начать путешествие →</a>
    </section>

    <section class="contacts-section">
      <div class="contacts-grid">
        <a href="https://t.me/shmel_coffee" target="_blank" class="contact-card"><span class="contact-name">Telegram</span><span class="contact-handle">@shmel_coffee</span></a>
        <a href="https://www.threads.net/@shmelcoffee" target="_blank" class="contact-card"><span class="contact-name">Threads</span><span class="contact-handle">@shmelcoffee</span></a>
        <a href="https://t.me/ksenijashmel" target="_blank" class="contact-card"><span class="contact-name">Связаться</span><span class="contact-handle">@ksenijashmel</span></a>
      </div>
    </section>

  </div>
</Layout>

<style>
  .container > section { margin-bottom: 64px; }
  .hero { text-align: center; padding-top: 92px; }
  .hero-photo { width: 100%; max-width: 640px; height: 260px; margin: 0 auto 28px; border-radius: var(--radius); overflow: hidden; background: #2b1d14; box-shadow: var(--shadow); }
  .hero-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hero-photo.noimg { background: linear-gradient(135deg, #3b271e, #8a5a2b); }
  .hero-photo.noimg img { display: none; }
  .hero-eyebrow { text-transform: uppercase; letter-spacing: .16em; font-size: .72rem; color: var(--accent); font-weight: 700; margin-bottom: 12px; }
  .hero-mini { font-size: .9rem; color: var(--text-muted); margin-top: 10px; max-width: 560px; margin-left: auto; margin-right: auto; line-height: 1.55; }
  .hero-actions { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; align-items: center; margin-top: 24px; }
  .home-account-btn { white-space: nowrap; }

  .curio { text-align: center; padding: 30px 22px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); }
  .curio-fact { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1.5rem; font-weight: 500; line-height: 1.3; margin: 0 0 16px; }
  .curio-fact b { color: var(--accent); font-weight: 600; }
  .curio-lead { font-size: .9rem; color: var(--text-dim); margin: 0 0 12px; }
  .curio-factors { display: flex; gap: 10px; justify-content: center; align-items: center; flex-wrap: wrap; }
  .cf { font-weight: 700; color: var(--text); background: var(--surface-2); border: 1px solid var(--border); padding: 6px 16px; border-radius: 20px; font-size: .9rem; }
  .cf-sep { color: var(--border-hover); }

  .sec-heading { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1.6rem; font-weight: 600; margin-bottom: 6px; text-align: center; }
  .sec-sub { color: var(--text-muted); font-size: .86rem; margin: 0 auto 24px; text-align: center; max-width: 560px; line-height: 1.6; }

  .wheel-section { text-align: center; scroll-margin-top: 72px; }

  .map-wrap { max-width: 640px; margin: 0 auto; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 14px; box-shadow: var(--shadow); }
  .geo-map { width: 100%; display: block; }
  .geo-map path[data-k] { transition: fill .15s; }
  .geo-info { max-width: 520px; margin: 14px auto 0; display: none; }
  .geo-info.active { display: block; padding: 18px 20px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow); animation: fadein .2s ease; }
  @keyframes fadein { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }
  .geo-info h3 { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1.3rem; font-weight: 600; margin-bottom: 2px; }
  .geo-region { font-size: .76rem; color: var(--text-muted); margin-bottom: 10px; }
  .geo-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; }
  .geo-tag { padding: 4px 11px; border-radius: 20px; background: var(--surface-2); border: 1px solid var(--border); font-size: .78rem; color: var(--text-dim); }
  .geo-link { color: var(--accent); font-weight: 600; font-size: .82rem; text-decoration: none; }
  .geo-link:hover { text-decoration: underline; }

  .comm-section { text-align: center; }
  .comm-card { max-width: 560px; margin: 0 auto; padding: 24px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow); text-align: left; }
  .comm-empty { color: var(--text-muted); font-size: .86rem; text-align: center; padding: 8px 0; }
  .comm-flex { display: flex; gap: 20px; align-items: center; flex-wrap: wrap; justify-content: center; }
  .comm-donut { flex-shrink: 0; }
  .comm-legend { flex: 1; min-width: 200px; }
  .leg-row { display: flex; align-items: center; gap: 8px; font-size: .82rem; margin: 5px 0; }
  .leg-dot { width: 11px; height: 11px; border-radius: 3px; flex-shrink: 0; }
  .leg-name { flex: 1; color: var(--text-dim); }
  .leg-n { font-weight: 700; color: var(--text); }
  .comm-h { font-size: .74rem; font-weight: 700; color: var(--accent); text-transform: uppercase; letter-spacing: .05em; margin: 20px 0 10px; }
  .comm-row { display: flex; align-items: center; gap: 10px; margin: 8px 0; font-size: .82rem; }
  .comm-row .l { min-width: 120px; }
  .comm-bar { flex: 1; height: 10px; background: var(--surface-2); border-radius: 6px; overflow: hidden; }
  .comm-bar > i { display: block; height: 100%; background: var(--accent); border-radius: 6px; }
  .comm-row .n { font-weight: 700; min-width: 24px; text-align: right; color: var(--text); }

  .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; max-width: 720px; margin: 0 auto; }
  .step { text-align: center; padding: 22px 16px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow); }
  .step-n { width: 34px; height: 34px; border-radius: 50%; background: var(--accent); color: #fff; font-weight: 700; display: flex; align-items: center; justify-content: center; margin: 0 auto 12px; }
  .step-t { font-weight: 700; font-size: .88rem; }
  .step-d { font-size: .78rem; color: var(--text-muted); margin-top: 4px; line-height: 1.45; }

  .final-cta { text-align: center; }
  .final-cta .sec-heading { margin-bottom: 18px; }

  .contacts-section { margin-bottom: 56px; }
  .contacts-grid { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }
  .contact-card { display: inline-flex; flex-direction: column; align-items: center; gap: 2px; padding: 10px 18px; border-radius: 8px; background: var(--surface); border: 1px solid var(--border); text-decoration: none; color: inherit; transition: all .2s; box-shadow: var(--shadow); }
  .contact-card:hover { border-color: var(--border-hover); box-shadow: var(--shadow-hover); }
  .contact-name { font-weight: 600; font-size: .82rem; }
  .contact-handle { font-size: .76rem; color: var(--accent); font-weight: 500; }

  @media (max-width: 768px) { .steps { grid-template-columns: 1fr; } .contacts-grid { flex-direction: column; align-items: center; } .container > section { margin-bottom: 48px; } .hero { padding-top: 80px; } .hero-photo { height: 200px; } }
</style>

<script is:inline src="https://cdn.jsdelivr.net/npm/d3@7/dist/d3.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/topojson-client@3/dist/topojson-client.min.js"></script>

<script define:vars={{ wheelData, DB, countryOrder, SUPA_URL, SUPA_KEY }}>
function polarToXY(cx,cy,r,deg){ const rad=(deg-90)*Math.PI/180; return{x:cx+r*Math.cos(rad),y:cy+r*Math.sin(rad)}; }
function arcSector(cx,cy,ri,ro,a1,a2){ const p1=polarToXY(cx,cy,ro,a1), p2=polarToXY(cx,cy,ro,a2); const p3=polarToXY(cx,cy,ri,a2), p4=polarToXY(cx,cy,ri,a1); const lg=(a2-a1)>180?1:0; return `M${p1.x},${p1.y} A${ro},${ro},0,${lg},1,${p2.x},${p2.y} L${p3.x},${p3.y} A${ri},${ri},0,${lg},0,${p4.x},${p4.y}Z`; }
function hexToHSL(hex){ let r=parseInt(hex.slice(1,3),16)/255, g=parseInt(hex.slice(3,5),16)/255, b=parseInt(hex.slice(5,7),16)/255; const mx=Math.max(r,g,b), mn=Math.min(r,g,b); let h,s,l=(mx+mn)/2; if(mx===mn){h=s=0;}else{ const d=mx-mn; s=l>.5?d/(2-mx-mn):d/(mx+mn); if(mx===r)h=((g-b)/d+(g<b?6:0))/6; else if(mx===g)h=((b-r)/d+2)/6; else h=((r-g)/d+4)/6; } return{h:Math.round(h*360),s:Math.round(s*100),l:Math.round(l*100)}; }
function buildWheel(){
  const svg=document.getElementById('wheelSvg'); if(!svg) return;
  const cx=310,cy=310, ir1=70,ir2=155, or1=160,or2=260, gap=1.2; const n=wheelData.length, catAng=360/n; let html='';
  html+=`<circle cx="${cx}" cy="${cy}" r="${ir1-5}" fill="#F8F7ED"/>`;
  html+=`<text x="${cx}" y="${cy}" text-anchor="middle" dominant-baseline="middle" font-family="'Cormorant Garamond',Georgia,serif" font-size="14" font-weight="600" fill="#462918">ВКУСЫ</text>`;
  wheelData.forEach((cat,i)=>{
    const a1=i*catAng+gap, a2=(i+1)*catAng-gap;
    html+=`<path d="${arcSector(cx,cy,ir1,ir2,a1,a2)}" fill="${cat.color}" data-type="cat" data-idx="${i}" style="cursor:pointer;stroke:#F8F7ED;stroke-width:1.5"/>`;
    const midA=(a1+a2)/2, lR=(ir1+ir2)/2; const pos=polarToXY(cx,cy,lR,midA); let rot=midA; if(rot>90&&rot<270) rot+=180;
    html+=`<text x="${pos.x}" y="${pos.y}" text-anchor="middle" dominant-baseline="middle" transform="rotate(${rot},${pos.x},${pos.y})" font-family="'Inter',sans-serif" font-size="10" font-weight="600" fill="#462918" style="pointer-events:none">${cat.name}</text>`;
    const subAng=(a2-a1)/cat.subs.length;
    cat.subs.forEach((sub,j)=>{
      const sa1=a1+j*subAng+gap*.4, sa2=a1+(j+1)*subAng-gap*.4; const hsl=hexToHSL(cat.color); const lShift=(j%2===0)?4:-4;
      html+=`<path d="${arcSector(cx,cy,or1,or2,sa1,sa2)}" fill="hsl(${hsl.h},${hsl.s}%,${hsl.l+lShift}%)" data-type="sub" data-cat="${i}" data-sub="${j}" style="cursor:pointer;stroke:#F8F7ED;stroke-width:1"/>`;
      const smA=(sa1+sa2)/2, sR=(or1+or2)/2; const sp=polarToXY(cx,cy,sR,smA); let sr=smA; if(sr>90&&sr<270) sr+=180;
      html+=`<text x="${sp.x}" y="${sp.y}" text-anchor="middle" dominant-baseline="middle" transform="rotate(${sr},${sp.x},${sp.y})" font-family="'Inter',sans-serif" font-size="8" font-weight="500" fill="#462918" style="pointer-events:none">${sub.name}</text>`;
    });
  });
  svg.innerHTML = html;
  svg.querySelectorAll('path[data-type]').forEach(p => {
    p.addEventListener('mouseenter', e => {
      const cat=wheelData[p.dataset.type==='cat'?p.dataset.idx:p.dataset.cat]; const tt=document.getElementById('wheelTooltip');
      if(p.dataset.type==='cat'){ document.getElementById('tooltipTitle').textContent=cat.name; document.getElementById('tooltipOrigins').textContent='Нажмите для подробностей'; }
      else { const sub=cat.subs[p.dataset.sub]; document.getElementById('tooltipTitle').textContent=sub.name; document.getElementById('tooltipOrigins').innerHTML=sub.org; }
      tt.classList.add('visible'); tt.style.left=(e.clientX+14)+'px'; tt.style.top=(e.clientY+14)+'px';
    });
    p.addEventListener('mousemove', e => { const tt=document.getElementById('wheelTooltip'); tt.style.left=(e.clientX+14)+'px'; tt.style.top=(e.clientY+14)+'px'; });
    p.addEventListener('mouseleave', ()=>{ document.getElementById('wheelTooltip').classList.remove('visible'); });
    p.addEventListener('click', ()=>{ const idx=p.dataset.type==='cat'?p.dataset.idx:p.dataset.cat; showWheelCat(parseInt(idx)); });
    p.style.transition='opacity .15s, filter .15s';
    p.addEventListener('mouseenter',()=>{p.style.opacity='.8';p.style.filter='brightness(1.1)';});
    p.addEventListener('mouseleave',()=>{p.style.opacity='1';p.style.filter='none';});
  });
}
const countryMap={ 'Эфиопия':'ethiopia','Кения':'kenya','Колумбия':'colombia','Бразилия':'brazil','Гватемала':'guatemala','Коста-Рика':'costarica','Панама':'panama','Руанда':'rwanda','Индонезия':'indonesia','Йемен':'yemen','Гондурас':'honduras','Перу':'peru' };
function linkOrigins(text){ let out=text; for(const [name,key] of Object.entries(countryMap)){ out=out.replace(new RegExp(name,'g'),`<a href="/countries?c=${key}" style="color:var(--accent);text-decoration:underline;text-decoration-color:var(--border)">${name}</a>`); } return out; }
function showWheelCat(idx){ const cat=wheelData[idx]; const panel=document.getElementById('wheelInfoPanel'); panel.innerHTML=`<h3>${cat.name}</h3><div class="wheel-flavor-list">${cat.subs.map(s=>`<div class="wheel-flavor-item"><div class="wheel-flavor-name">${s.name}</div><div class="wheel-flavor-origins">${linkOrigins(s.org)}</div></div>`).join('')}</div>`; panel.classList.add('active'); panel.scrollIntoView({behavior:'smooth',block:'nearest'}); }

function showGeo(k){ const c=DB[k]; const el=document.getElementById('geoInfo'); if(!c||!el) return; el.innerHTML=`<h3>${c.flag} ${c.name}</h3><div class="geo-region">${c.region||''}</div><div class="geo-tags">${(c.flavors||[]).map(f=>`<span class="geo-tag">${f}</span>`).join('')}</div><a href="/countries?c=${k}" class="geo-link">Подробнее о стране →</a>`; el.classList.add('active'); }
const ENG={ ethiopia:'Ethiopia',kenya:'Kenya',rwanda:'Rwanda',yemen:'Yemen',colombia:'Colombia',brazil:'Brazil',guatemala:'Guatemala',honduras:'Honduras',costarica:'Costa Rica',panama:'Panama',peru:'Peru',indonesia:'Indonesia' };
async function drawMap(){
  const svg=document.getElementById('geoMap'); if(!svg) return;
  if(!window.d3||!window.topojson){ svg.innerHTML='<text x="320" y="155" text-anchor="middle" font-family="Inter,sans-serif" font-size="13" fill="var(--text-muted)">Карта недоступна</text>'; return; }
  try{
    const W=640,H=300;
    const world=await fetch('https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json').then(r=>r.json());
    const feats=window.topojson.feature(world, world.objects.countries).features;
    const proj=window.d3.geoNaturalEarth1().fitExtent([[8,8],[W-8,H-8]], {type:'Sphere'});
    const path=window.d3.geoPath(proj);
    const nameToKey={}; Object.entries(ENG).forEach(([k,v])=>nameToKey[v]=k);
    let html='';
    feats.forEach(f=>{ const d=path(f); if(!d) return; const k=nameToKey[f.properties.name]; if(k){ html+=`<path d="${d}" fill="#BA7517" stroke="var(--surface)" stroke-width="0.5" style="cursor:pointer" data-k="${k}"></path>`; } else { html+=`<path d="${d}" fill="var(--surface-2)" stroke="var(--border)" stroke-width="0.4"></path>`; } });
    svg.innerHTML=html;
    const yTop=proj([0,32])[1], yBot=proj([0,-34])[1];
    svg.setAttribute('viewBox', `0 ${Math.round(yTop)} ${W} ${Math.round(yBot-yTop)}`);
    svg.querySelectorAll('path[data-k]').forEach(p=>p.addEventListener('click',()=>{ svg.querySelectorAll('path[data-k]').forEach(q=>q.setAttribute('fill','#BA7517')); p.setAttribute('fill','#854F0B'); showGeo(p.dataset.k); }));
  }catch(e){ svg.innerHTML='<text x="320" y="155" text-anchor="middle" font-family="Inter,sans-serif" font-size="13" fill="var(--text-muted)">Не удалось загрузить карту</text>'; }
}

const FLC={fruity:'#C47070',floral:'#D4A0B8',chocolate:'#8B6B4A',caramel:'#D4B870',spicy:'#C0A060',tropical:'#C49080'};
const FL={fruity:'Фруктовые',floral:'Цветочные и чайные',chocolate:'Шоколад и орехи',caramel:'Карамель и мёд',spicy:'Пряные',tropical:'Тропические'};
function donut(flavors,total){
  const sum=flavors.reduce((s,x)=>s+x.users,0)||1; const cx=70,cy=70,r0=42,r1=64; let a0=-Math.PI/2; let s='';
  flavors.forEach(x=>{ const a1=a0+(x.users/sum)*2*Math.PI; const A=[cx+r1*Math.cos(a0),cy+r1*Math.sin(a0)],B=[cx+r1*Math.cos(a1),cy+r1*Math.sin(a1)],Cc=[cx+r0*Math.cos(a1),cy+r0*Math.sin(a1)],D=[cx+r0*Math.cos(a0),cy+r0*Math.sin(a0)]; const big=(a1-a0)>Math.PI?1:0; s+=`<path d="M${A} A${r1} ${r1} 0 ${big} 1 ${B} L${Cc} A${r0} ${r0} 0 ${big} 0 ${D} Z" fill="${FLC[x.flavor]||'#BA7517'}"/>`; a0=a1; });
  return `<svg width="140" height="140" viewBox="0 0 140 140">${s}<text x="70" y="66" text-anchor="middle" font-family="'Cormorant Garamond',serif" font-size="24" font-weight="600" fill="var(--text)">${total}</text><text x="70" y="86" text-anchor="middle" font-family="Inter,sans-serif" font-size="10" fill="var(--text-muted)">профилей</text></svg>`;
}
async function loadCommunity(){
  const el=document.getElementById('commCard'); if(!el) return;
  if(!SUPA_URL||!SUPA_KEY){ el.innerHTML='<div class="comm-empty">Статистика появится позже.</div>'; return; }
  try{
    const res=await fetch(`${SUPA_URL}/rest/v1/rpc/get_community_stats`,{ method:'POST', headers:{ 'Content-Type':'application/json','apikey':SUPA_KEY,'Authorization':`Bearer ${SUPA_KEY}` }, body:'{}' });
    if(!res.ok){ el.innerHTML='<div class="comm-empty">Пока нет данных.</div>'; return; }
    let data=await res.json(); if(Array.isArray(data)) data=data[0];
    const flagByName={}; for(const k of Object.keys(DB)) flagByName[DB[k].name]=DB[k].flag;
    const total=(data&&data.total_users)||0; const flavors=((data&&data.flavors)||[]).slice(0,6); const countries=((data&&data.countries)||[]).slice(0,5);
    if(!flavors.length&&!countries.length){ el.innerHTML='<div class="comm-empty">Станешь одним из первых. Пройди тест и появишься на карте.</div>'; return; }
    const maxC=Math.max(1,...countries.map(x=>x.users));
    let html='<div class="comm-flex">';
    html+=`<div class="comm-donut">${donut(flavors,total)}</div>`;
    html+='<div class="comm-legend">'+flavors.map(x=>`<div class="leg-row"><span class="leg-dot" style="background:${FLC[x.flavor]||'#BA7517'}"></span><span class="leg-name">${FL[x.flavor]||x.flavor}</span><span class="leg-n">${x.users}</span></div>`).join('')+'</div>';
    html+='</div>';
    if(countries.length){ html+='<div class="comm-h">Чаще открывают страны</div>'+countries.map(x=>`<div class="comm-row"><span class="l">${flagByName[x.origin]||''} ${x.origin}</span><div class="comm-bar"><i style="width:${Math.round(x.users/maxC*100)}%"></i></div><span class="n">${x.users}</span></div>`).join(''); }
    el.innerHTML=html;
  }catch(e){ el.innerHTML='<div class="comm-empty">Не удалось загрузить статистику.</div>'; }
}
buildWheel(); drawMap(); loadCommunity();
</script>
