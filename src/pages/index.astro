---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import { SITE_URL } from '../lib/seo';

const pageTitle = 'Shmelco — личный кабинет для дегустации кофе';
const pageDesc = 'Дневник чашек, полка зерна, карта стран и AI-ассистент. Бесплатный профиль вкуса за 2 минуты — для домашней дегустации specialty.';
const ogImage = `${SITE_URL}/og/home.png`;
---

<Layout
  title={pageTitle}
  description={pageDesc}
  ogImage={ogImage}
  ogImageAlt="Shmelco — полка, дневник и карта вкуса"
  keywords={['дневник кофе', 'полка зерна', 'дегустация кофе', 'specialty coffee', 'личный кабинет']}
>
  <Nav />

  <section class="lp-hero">
    <div class="container lp-hero-grid">
      <div class="lp-hero-copy">
        <p class="lp-eyebrow">Личный кабинет · specialty at home</p>
        <h1>Полка, дневник и&nbsp;карта вкуса&nbsp;— в&nbsp;одном месте</h1>
        <p class="lp-lead">Записывай чашки, храни зерно, открывай страны на карте. AI подскажет, с&nbsp;чем сравнить лот и&nbsp;как заварить.</p>
        <div class="lp-actions">
          <a class="btn btn-primary" href="/quiz">Создать кабинет бесплатно →</a>
          <a class="btn btn-ghost" href="/account">Войти</a>
        </div>
        <p class="lp-note">Тест вкуса · 2&nbsp;мин · без карты на старте</p>
      </div>

      <div class="lp-mock" aria-hidden="true">
        <div class="lp-mock-window">
          <div class="lp-mock-bar">
            <span></span><span></span><span></span>
            <div class="lp-mock-title">Кабинет · Полка</div>
          </div>
          <div class="lp-mock-tabs">
            <span class="on">🪵 Полка</span><span>📔 Дневник</span><span>🗺 Карта</span><span>🎯 Профиль</span>
          </div>
          <div class="lp-mock-body">
            <div class="lp-bean">
              <div class="lp-bean-cover c1"></div>
              <div><b>Китай Синган</b><small>Submarine · natural</small></div>
              <span class="lp-tag ok">на полке</span>
            </div>
            <div class="lp-bean">
              <div class="lp-bean-cover c2"></div>
              <div><b>Эфиопия Ворка</b><small>Welder · washed</small></div>
              <span class="lp-tag">заканчивается</span>
            </div>
            <div class="lp-assist">
              <div class="lp-assist-h">🤖 AI-ассистент</div>
              <p>С чем сегодня сравнить китайские лоты? Дай рецепт AeroPress с&nbsp;байпасом.</p>
            </div>
            <div class="lp-cup-row">
              <span>📔 Вчера · V60 · 4★</span>
              <span class="lp-open">+ чашка</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="container">

    <section class="lp-proof">
      <div id="commProof" class="lp-proof-inner"><span class="lp-proof-muted">Загружаем…</span></div>
    </section>

    <section class="lp-features">
      <h2 class="lp-h2">Что внутри кабинета</h2>
      <p class="lp-sub">Не медиа и&nbsp;не магазин зерна&nbsp;— рабочее место для домашней дегустации.</p>
      <div class="lp-feat-grid">
        <article class="lp-feat">
          <div class="lp-feat-icon">📔</div>
          <h3>Дневник чашек</h3>
          <p>Рецепт, проливы, баланс, ноты и&nbsp;оценка. Вся история&nbsp;— под рукой, когда завариваешь снова.</p>
        </article>
        <article class="lp-feat">
          <div class="lp-feat-icon">🪵</div>
          <h3>Полка зерна</h3>
          <p>Лоты с&nbsp;обжарщиком, страной, обработкой и&nbsp;сортом. Статус «на полке / заканчивается» и&nbsp;запуск чашки в&nbsp;один клик.</p>
        </article>
        <article class="lp-feat">
          <div class="lp-feat-icon">🗺</div>
          <h3>Карта открытий</h3>
          <p>Страна открывается, когда ты&nbsp;реально пробовал зерно&nbsp;— чашка или полка, не&nbsp;просто тест.</p>
        </article>
        <article class="lp-feat">
          <div class="lp-feat-icon">🎯</div>
          <h3>Профиль вкуса</h3>
          <p>Короткий тест → паспорт и&nbsp;подборки. Понимаешь, что любишь, и&nbsp;куда идти дальше.</p>
        </article>
        <article class="lp-feat">
          <div class="lp-feat-icon">🤖</div>
          <h3>AI-ассистент на&nbsp;полке</h3>
          <p>Сравнения лотов, рецепты под метод, план дегустации&nbsp;— по&nbsp;твоей полке и&nbsp;дневнику. Подписка.</p>
        </article>
        <article class="lp-feat">
          <div class="lp-feat-icon">📖</div>
          <h3>Гиды дегустации</h3>
          <p>Персональный план на&nbsp;неделю под твоё зерно: что заварить, с&nbsp;чем сравнить, на&nbsp;что смотреть.</p>
        </article>
      </div>
    </section>

    <section class="lp-steps">
      <h2 class="lp-h2">Как начать</h2>
      <div class="lp-steps-row">
        <div class="lp-step"><span class="lp-step-n">1</span><b>Профиль вкуса</b><span>2&nbsp;мин, бесплатно</span></div>
        <div class="lp-step-arrow">→</div>
        <div class="lp-step"><span class="lp-step-n">2</span><b>Полка + первая чашка</b><span>запиши, что заварила</span></div>
        <div class="lp-step-arrow">→</div>
        <div class="lp-step"><span class="lp-step-n">3</span><b>Карта и&nbsp;углубление</b><span>страны, сравнения, AI</span></div>
      </div>
      <a class="btn btn-primary lp-steps-cta" href="/quiz">Создать кабинет →</a>
    </section>

    <section class="lp-tools">
      <h2 class="lp-h2">Справочники</h2>
      <p class="lp-sub">Обучение вынесено из&nbsp;главной&nbsp;— кабинет остаётся продуктом, знания&nbsp;— рядом.</p>
      <div class="lp-tools-grid">
        <a href="/wheel" class="lp-tool"><span>☕</span><b>Колесо вкусов</b><small>язык ароматов</small></a>
        <a href="/countries" class="lp-tool"><span>🌍</span><b>Страны кофе</b><small>география вкуса</small></a>
        <a href="/blog" class="lp-tool lp-tool-accent"><span>📖</span><b>Блог</b><small>методы, зерно, дегустация</small></a>
        <a href="/blog/chempionskie-recepty" class="lp-tool"><span>🏆</span><b>Рецепты</b><small>чемпионские проливы</small></a>
      </div>
    </section>

    <section class="lp-blog">
      <div class="lp-blog-head">
        <div>
          <h2 class="lp-h2 lp-h2-left">Блог</h2>
          <p class="lp-sub lp-sub-left">Статьи для углубления&nbsp;— когда нужна теория, не&nbsp;когда завариваешь.</p>
        </div>
        <a href="/blog" class="lp-blog-all">Все статьи →</a>
      </div>
      <div class="lp-blog-grid">
        <a href="/blog/kofejnoe-zerno/strany-kofe" class="lp-blog-card">
          <span class="lp-blog-tag">Зерно</span>
          <b>20 стран specialty</b>
          <p>Карта происхождений и&nbsp;что ждать во&nbsp;вкусе</p>
        </a>
        <a href="/blog/degustaciya-kofe" class="lp-blog-card">
          <span class="lp-blog-tag">Дегустация</span>
          <b>Как чувствовать чашку</b>
          <p>Баланс, ноты, сравнения без&nbsp;снобизма</p>
        </a>
        <a href="/blog/metody-zavarivaniya" class="lp-blog-card">
          <span class="lp-blog-tag">Методы</span>
          <b>V60, AeroPress, cold brew</b>
          <p>Переменные и&nbsp;рецепты под домашнюю кухню</p>
        </a>
      </div>
    </section>

    <section class="lp-pricing">
      <h2 class="lp-h2">Тарифы</h2>
      <div class="lp-price-grid">
        <div class="lp-price">
          <div class="lp-price-label">Бесплатно</div>
          <ul>
            <li>Профиль вкуса и&nbsp;паспорт</li>
            <li>Дневник и&nbsp;полка</li>
            <li>Карта открытий</li>
          </ul>
          <a href="/quiz" class="btn btn-primary">Начать →</a>
        </div>
        <div class="lp-price lp-price-pro">
          <div class="lp-price-label">Платно · по&nbsp;запросу</div>
          <ul>
            <li>Персональные гиды дегустации</li>
            <li>AI-ассистент на&nbsp;полке</li>
            <li>Сравнения и&nbsp;рецепты под твоё зерно</li>
          </ul>
          <a href="/account?tab=shelf" class="btn btn-ghost">В кабинет →</a>
        </div>
      </div>
    </section>

    <section class="lp-final">
      <h2 class="lp-h2">Кофе, который ты&nbsp;пьёшь дома, заслуживает системы</h2>
      <a class="btn btn-primary" href="/quiz">Создать кабинет бесплатно →</a>
    </section>

    <section class="lp-contacts">
      <a href="https://t.me/shmel_coffee" target="_blank" rel="noopener" class="lp-contact">Telegram · @shmel_coffee</a>
      <a href="https://t.me/ksenijashmel" target="_blank" rel="noopener" class="lp-contact">Связаться · @ksenijashmel</a>
    </section>

  </div>

<style>
  .lp-hero {
    padding: 88px 0 56px;
    background: linear-gradient(180deg, var(--surface) 0%, var(--bg) 100%);
    border-bottom: 1px solid var(--border);
  }
  .lp-hero-grid {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: 40px;
    align-items: center;
  }
  .lp-eyebrow {
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 14px;
  }
  .lp-hero-copy h1 {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 3rem;
    line-height: 1.08;
    font-weight: 600;
    letter-spacing: -.01em;
    margin-bottom: 16px;
  }
  .lp-lead {
    font-size: 1.02rem;
    color: var(--text-dim);
    line-height: 1.65;
    max-width: 480px;
    margin-bottom: 24px;
  }
  .lp-actions { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 12px; }
  .lp-note { font-size: .78rem; color: var(--text-muted); }

  .lp-mock-window {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    box-shadow: var(--shadow-hover);
    overflow: hidden;
  }
  .lp-mock-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    background: var(--surface-2);
    border-bottom: 1px solid var(--border);
  }
  .lp-mock-bar span {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--border-hover);
  }
  .lp-mock-title {
    margin-left: auto;
    font-size: .68rem;
    font-weight: 600;
    color: var(--text-muted);
    letter-spacing: .04em;
  }
  .lp-mock-tabs {
    display: flex;
    gap: 4px;
    padding: 8px 10px;
    border-bottom: 1px solid var(--border);
    font-size: .68rem;
    flex-wrap: wrap;
  }
  .lp-mock-tabs span {
    padding: 5px 9px;
    border-radius: 8px;
    color: var(--text-muted);
  }
  .lp-mock-tabs span.on {
    background: var(--text);
    color: var(--bg);
    font-weight: 600;
  }
  .lp-mock-body { padding: 12px; display: flex; flex-direction: column; gap: 8px; }
  .lp-bean {
    display: grid;
    grid-template-columns: 44px 1fr auto;
    gap: 10px;
    align-items: center;
    padding: 10px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg);
  }
  .lp-bean-cover {
    width: 44px; height: 44px; border-radius: 8px;
  }
  .lp-bean-cover.c1 { background: linear-gradient(135deg, #c4a574, #8b6b4a); }
  .lp-bean-cover.c2 { background: linear-gradient(135deg, #7a9a6e, #4a6b52); }
  .lp-bean b { display: block; font-size: .82rem; }
  .lp-bean small { font-size: .68rem; color: var(--text-muted); }
  .lp-tag {
    font-size: .62rem;
    font-weight: 700;
    padding: 4px 8px;
    border-radius: 6px;
    background: var(--surface-2);
    color: var(--text-muted);
    white-space: nowrap;
  }
  .lp-tag.ok { background: rgba(107,143,113,.15); color: var(--accent-green); }
  .lp-assist {
    padding: 10px 12px;
    border-radius: 10px;
    border: 1px dashed var(--border-hover);
    background: rgba(168,124,79,.06);
  }
  .lp-assist-h { font-size: .72rem; font-weight: 700; margin-bottom: 4px; }
  .lp-assist p { font-size: .72rem; color: var(--text-dim); line-height: 1.45; }
  .lp-cup-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: .72rem;
    color: var(--text-dim);
    padding: 8px 10px;
    border-top: 1px solid var(--border);
    margin-top: 2px;
  }
  .lp-open {
    font-weight: 700;
    color: var(--accent);
  }

  .container > section { margin-bottom: 64px; }
  .container > section:first-child { margin-top: 40px; }

  .lp-proof-inner {
    text-align: center;
    padding: 16px 20px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    font-size: .88rem;
    color: var(--text-dim);
  }
  .lp-proof-inner b {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.6rem;
    color: var(--accent);
    margin-right: 6px;
  }
  .lp-proof-muted { color: var(--text-muted); }

  .lp-h2 {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 2rem;
    font-weight: 600;
    text-align: center;
    margin-bottom: 8px;
  }
  .lp-h2-left { text-align: left; }
  .lp-sub {
    text-align: center;
    color: var(--text-dim);
    font-size: .9rem;
    max-width: 560px;
    margin: 0 auto 28px;
    line-height: 1.6;
  }
  .lp-sub-left { margin-left: 0; text-align: left; }

  .lp-feat-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  .lp-feat {
    padding: 22px 20px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
  }
  .lp-feat-icon { font-size: 1.5rem; margin-bottom: 8px; }
  .lp-feat h3 { font-size: .92rem; font-weight: 700; margin-bottom: 6px; }
  .lp-feat p { font-size: .82rem; color: var(--text-dim); line-height: 1.55; }

  .lp-steps-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }
  .lp-step {
    flex: 1;
    min-width: 160px;
    max-width: 220px;
    text-align: center;
    padding: 20px 16px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }
  .lp-step-n {
    display: inline-flex;
    width: 28px; height: 28px;
    align-items: center; justify-content: center;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    font-size: .78rem;
    font-weight: 700;
    margin-bottom: 8px;
  }
  .lp-step b { display: block; font-size: .88rem; margin-bottom: 4px; }
  .lp-step span { font-size: .78rem; color: var(--text-muted); }
  .lp-step-arrow { color: var(--text-muted); font-size: 1.2rem; }
  .lp-steps-cta { display: block; width: fit-content; margin: 0 auto; }

  .lp-tools-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }
  .lp-tool {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 18px 16px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: var(--surface);
    text-decoration: none;
    color: inherit;
    transition: border-color .2s, box-shadow .2s;
  }
  .lp-tool:hover { border-color: var(--border-hover); box-shadow: var(--shadow-hover); }
  .lp-tool span { font-size: 1.3rem; }
  .lp-tool b { font-size: .88rem; }
  .lp-tool small { font-size: .74rem; color: var(--text-muted); }
  .lp-tool-accent { border-color: rgba(168,124,79,.35); background: rgba(168,124,79,.06); }

  .lp-blog-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }
  .lp-blog-all {
    font-size: .84rem;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
  }
  .lp-blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  .lp-blog-card {
    padding: 20px 18px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    text-decoration: none;
    color: inherit;
    transition: box-shadow .2s;
  }
  .lp-blog-card:hover { box-shadow: var(--shadow-hover); }
  .lp-blog-tag {
    font-size: .64rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .lp-blog-card b { display: block; font-size: .95rem; margin: 8px 0 6px; }
  .lp-blog-card p { font-size: .8rem; color: var(--text-dim); line-height: 1.5; }

  .lp-price-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    max-width: 720px;
    margin: 0 auto;
  }
  .lp-price {
    padding: 24px 22px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  .lp-price-pro { border-color: var(--accent); background: rgba(168,124,79,.05); }
  .lp-price-label {
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 14px;
  }
  .lp-price ul {
    list-style: none;
    margin-bottom: 18px;
    font-size: .86rem;
    color: var(--text-dim);
    line-height: 1.7;
  }
  .lp-price li::before { content: '✓ '; color: var(--accent-green); font-weight: 700; }

  .lp-final { text-align: center; padding: 40px 0 20px; }
  .lp-final .lp-h2 { margin-bottom: 20px; max-width: 520px; margin-left: auto; margin-right: auto; }

  .lp-contacts {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 48px;
  }
  .lp-contact {
    font-size: .82rem;
    font-weight: 600;
    padding: 10px 18px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
    text-decoration: none;
    color: var(--text-dim);
  }
  .lp-contact:hover { border-color: var(--border-hover); color: var(--accent); }

  @media (max-width: 900px) {
    .lp-hero-grid { grid-template-columns: 1fr; }
    .lp-mock { order: -1; max-width: 420px; margin: 0 auto; }
    .lp-hero-copy h1 { font-size: 2.2rem; }
    .lp-feat-grid { grid-template-columns: 1fr 1fr; }
    .lp-tools-grid { grid-template-columns: 1fr 1fr; }
    .lp-blog-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .lp-feat-grid, .lp-price-grid, .lp-tools-grid { grid-template-columns: 1fr; }
    .lp-step-arrow { display: none; }
  }
</style>

<script>
const SUPA_URL = import.meta.env.PUBLIC_SUPABASE_URL || '';
const SUPA_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '';

async function loadProof() {
  const el = document.getElementById('commProof');
  if (!el || !SUPA_URL || !SUPA_KEY) {
    if (el) el.innerHTML = '<span class="lp-proof-muted">Кабинет для домашней дегустации specialty</span>';
    return;
  }
  try {
    const res = await fetch(`${SUPA_URL}/rest/v1/rpc/get_community_stats`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', apikey: SUPA_KEY, Authorization: `Bearer ${SUPA_KEY}` },
      body: '{}',
    });
    if (!res.ok) throw new Error('stats');
    let data = await res.json();
    if (Array.isArray(data)) data = data[0];
    const n = (data && data.total_users) || 0;
    el.innerHTML = n
      ? `<b>${n}</b> профилей вкуса в&nbsp;сообществе · дневник · полка · карта стран`
      : '<span class="lp-proof-muted">Стань одной из первых — создай кабинет</span>';
  } catch {
    el.innerHTML = '<span class="lp-proof-muted">Личный кабинет для дегустации дома</span>';
  }
}
loadProof();
</script>

</Layout>
