---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Вход... — Shmelco">
  <div class="container" style="padding-top:120px;text-align:center;min-height:60vh">
    <p style="color:var(--text-dim);font-size:.9rem" id="statusMsg">Авторизация...</p>
  </div>
</Layout>

<script>
  import { createClient } from '@supabase/supabase-js';

  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY
  );

  async function handleCallback() {
    const { data: { session }, error } = await supabase.auth.getSession();

    if (error || !session) {
      const hash = window.location.hash;
      if (hash) {
        const params = new URLSearchParams(hash.replace('#', ''));
        const accessToken = params.get('access_token');
        const refreshToken = params.get('refresh_token');
        if (accessToken && refreshToken) {
          await supabase.auth.setSession({ access_token: accessToken, refresh_token: refreshToken });
        }
      }
    }

    const { data: { user } } = await supabase.auth.getUser();

    if (user) {
      const pending = sessionStorage.getItem('pendingSelection');
      if (pending) {
        sessionStorage.removeItem('pendingSelection');
        const sel = JSON.parse(pending);
        try {
          const profRes = await fetch('/api/save-profile', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              userId: user.id,
              answers: sel.answers || {},
              profileType: sel.profileType || '',
              brewMethod: sel.brewMethod || null,
              tastes: sel.tastes || [],
              notes: [],
            }),
          });
          const profile = await profRes.json();

          await fetch('/api/save-selection', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              userId: user.id,
              profileId: profile.id,
              coffees: sel.coffees || [],
              format: sel.format || 'mixed',
            }),
          });
        } catch (e) { console.error('Failed to save pending selection:', e); }
      }
      window.location.href = '/account';
    } else {
      document.getElementById('statusMsg')!.textContent = 'Не удалось войти. Попробуйте ещё раз.';
      setTimeout(() => { window.location.href = '/login'; }, 2000);
    }
  }

  handleCallback();
</script>
