---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Вход... — Shmelco">
  <div class="container" style="padding-top:120px;text-align:center;min-height:60vh">
    <div style="width:28px;height:28px;border:2px solid var(--border);border-top-color:var(--text);border-radius:50%;animation:spin .6s linear infinite;margin:0 auto 16px" id="spinner"></div>
    <p style="color:var(--text-dim);font-size:.9rem" id="statusMsg">Авторизация...</p>
    <p style="margin-top:12px" id="statusActions"></p>
  </div>
</Layout>

<style>
  @keyframes spin { to { transform: rotate(360deg); } }
  .cb-retry { display:inline-block;margin-top:8px;padding:10px 18px;border-radius:8px;background:var(--text);color:var(--bg);text-decoration:none;font-size:.84rem;font-weight:600; }
</style>

<script>
  import { createClient } from '@supabase/supabase-js';

  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
    { auth: { flowType: 'implicit', detectSessionInUrl: true } }
  );

  let handled = false;

  async function postLoginPath(user: { id: string }) {
    const { data } = await supabase.from('taste_profiles').select('id').eq('user_id', user.id).limit(1);
    if (data?.length) return '/account';
    const { count } = await supabase.from('coffee_selections').select('id', { count: 'exact', head: true }).eq('user_id', user.id);
    return count ? '/account' : '/quiz';
  }

  function showSaveError() {
    document.getElementById('spinner')!.style.display = 'none';
    document.getElementById('statusMsg')!.textContent = 'Вошли, но не удалось сохранить профиль или подборку.';
    document.getElementById('statusActions')!.innerHTML =
      '<a class="cb-retry" href="/quiz">Вернуться к тесту →</a> <a class="cb-retry" href="/account" style="margin-left:8px;background:var(--surface-2);color:var(--text);border:1px solid var(--border)">В кабинет</a>';
  }

  async function finishLogin(user: { id: string }, accessToken?: string) {
    const hadPending = !!(sessionStorage.getItem('pendingProfile') || sessionStorage.getItem('pendingSelection'));
    const saved = await savePendingData(accessToken);
    if (hadPending && !saved) {
      showSaveError();
      return;
    }
    window.location.href = await postLoginPath(user);
  }

  supabase.auth.onAuthStateChange(async (event, session) => {
    if (handled) return;
    if (event === 'SIGNED_IN' && session?.user) {
      handled = true;
      document.getElementById('statusMsg')!.textContent = 'Добро пожаловать!';
      await finishLogin(session.user, session.access_token);
    }
  });

  async function savePendingData(accessToken?: string): Promise<boolean> {
    const token = accessToken || (await supabase.auth.getSession()).data.session?.access_token;
    if (!token) return false;

    const headers: Record<string, string> = {
      'Content-Type': 'application/json',
      Authorization: 'Bearer ' + token,
    };

    const pendingProfile = sessionStorage.getItem('pendingProfile');
    if (pendingProfile) {
      const pp = JSON.parse(pendingProfile);
      try {
        const res = await fetch('/api/save-profile', {
          method: 'POST',
          headers,
          body: JSON.stringify({
            answers: pp.answers || {},
            profileType: pp.profileType || '',
            brewMethod: pp.brewMethod || null,
            tastes: pp.tastes || [],
            notes: [],
          }),
        });
        if (!res.ok) return false;
        sessionStorage.removeItem('pendingProfile');
        return true;
      } catch {
        return false;
      }
    }

    const pending = sessionStorage.getItem('pendingSelection');
    if (!pending) return true;

    const sel = JSON.parse(pending);
    try {
      const profRes = await fetch('/api/save-profile', {
        method: 'POST',
        headers,
        body: JSON.stringify({
          answers: sel.answers || {},
          profileType: sel.profileType || '',
          brewMethod: sel.brewMethod || null,
          tastes: sel.tastes || [],
          notes: [],
        }),
      });
      if (!profRes.ok) return false;
      const profile = await profRes.json();

      const selRes = await fetch('/api/save-selection', {
        method: 'POST',
        headers,
        body: JSON.stringify({
          profileId: profile.id,
          coffees: sel.coffees || [],
          format: sel.format || 'mixed',
        }),
      });
      if (!selRes.ok) return false;

      sessionStorage.removeItem('pendingSelection');
      return true;
    } catch {
      return false;
    }
  }

  setTimeout(async () => {
    if (handled) return;
    const hash = window.location.hash;
    if (hash) {
      const params = new URLSearchParams(hash.replace('#', ''));
      const accessToken = params.get('access_token');
      const refreshToken = params.get('refresh_token');
      if (accessToken && refreshToken) {
        const { error } = await supabase.auth.setSession({ access_token: accessToken, refresh_token: refreshToken });
        if (!error) {
          const { data: { user } } = await supabase.auth.getUser();
          if (user) {
            handled = true;
            const { data: { session } } = await supabase.auth.getSession();
            await finishLogin(user, session?.access_token);
            return;
          }
        }
      }
    }
    const code = new URLSearchParams(window.location.search).get('code');
    if (code) {
      const { error } = await supabase.auth.exchangeCodeForSession(code);
      if (!error) {
        const { data: { user } } = await supabase.auth.getUser();
        if (user) {
          handled = true;
          const { data: { session } } = await supabase.auth.getSession();
          await finishLogin(user, session?.access_token);
          return;
        }
      }
    }
    if (!handled) {
      document.getElementById('statusMsg')!.textContent = 'Не удалось войти. Перенаправляем...';
      setTimeout(() => { window.location.href = '/login'; }, 2000);
    }
  }, 2000);
</script>
