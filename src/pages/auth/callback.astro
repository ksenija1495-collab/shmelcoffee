---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Вход... — Shmelco">
  <div class="container" style="padding-top:120px;text-align:center;min-height:60vh">
    <div style="width:28px;height:28px;border:2px solid var(--border);border-top-color:var(--text);border-radius:50%;animation:spin .6s linear infinite;margin:0 auto 16px"></div>
    <p style="color:var(--text-dim);font-size:.9rem" id="statusMsg">Авторизация...</p>
  </div>
</Layout>

<style>
  @keyframes spin { to { transform: rotate(360deg); } }
</style>

<script>
  import { createClient } from '@supabase/supabase-js';

  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
    { auth: { flowType: 'implicit', detectSessionInUrl: true } }
  );

  let handled = false;

  async function postLoginPath(user: { id: string }) {
    if (sessionStorage.getItem('pendingProfile') || sessionStorage.getItem('pendingSelection')) {
      return '/account';
    }
    const { data } = await supabase.from('taste_profiles').select('id').eq('user_id', user.id).limit(1);
    return data?.length ? '/account' : '/quiz';
  }

  supabase.auth.onAuthStateChange(async (event, session) => {
    if (handled) return;
    if (event === 'SIGNED_IN' && session?.user) {
      handled = true;
      document.getElementById('statusMsg')!.textContent = 'Добро пожаловать!';
      await savePendingData(session.user, session.access_token);
      window.location.href = await postLoginPath(session.user);
    }
  });

  async function savePendingData(user: any, accessToken?: string) {
    const token = accessToken || (await supabase.auth.getSession()).data.session?.access_token;
    const headers: Record<string, string> = { 'Content-Type': 'application/json' };
    if (token) headers.Authorization = 'Bearer ' + token;

    const pendingProfile = sessionStorage.getItem('pendingProfile');
    if (pendingProfile) {
      sessionStorage.removeItem('pendingProfile');
      const pp = JSON.parse(pendingProfile);
      try {
        const res = await fetch('/api/save-profile', {
          method: 'POST',
          headers,
          body: JSON.stringify({
            answers: pp.answers || {},
            profileType: pp.profileType || '',
            brewMethod: pp.brewMethod || null,
            tastes: pp.tastes || [],
            notes: [],
          }),
        });
        if (!res.ok) console.error('Pending profile save failed:', await res.text());
      } catch (e) { console.error('Pending profile save error:', e); }
      return;
    }

    const pending = sessionStorage.getItem('pendingSelection');
    if (!pending) return;
    sessionStorage.removeItem('pendingSelection');
    const sel = JSON.parse(pending);
    try {
      const profRes = await fetch('/api/save-profile', {
        method: 'POST',
        headers,
        body: JSON.stringify({
          answers: sel.answers || {},
          profileType: sel.profileType || '',
          brewMethod: sel.brewMethod || null,
          tastes: sel.tastes || [],
          notes: [],
        }),
      });
      if (!profRes.ok) { console.error('Pending profile save failed:', await profRes.text()); return; }
      const profile = await profRes.json();
      const selRes = await fetch('/api/save-selection', {
        method: 'POST',
        headers,
        body: JSON.stringify({
          profileId: profile.id,
          coffees: sel.coffees || [],
          format: sel.format || 'mixed',
        }),
      });
      if (!selRes.ok) console.error('Pending selection save failed:', await selRes.text());
    } catch (e) { console.error('Pending save error:', e); }
  }

  setTimeout(async () => {
    if (handled) return;
    const hash = window.location.hash;
    if (hash) {
      const params = new URLSearchParams(hash.replace('#', ''));
      const accessToken = params.get('access_token');
      const refreshToken = params.get('refresh_token');
      if (accessToken && refreshToken) {
        const { error } = await supabase.auth.setSession({ access_token: accessToken, refresh_token: refreshToken });
        if (!error) {
          const { data: { user } } = await supabase.auth.getUser();
          if (user) { handled = true; const { data: { session } } = await supabase.auth.getSession(); await savePendingData(user, session?.access_token); window.location.href = await postLoginPath(user); return; }
        }
      }
    }
    const code = new URLSearchParams(window.location.search).get('code');
    if (code) {
      const { error } = await supabase.auth.exchangeCodeForSession(code);
      if (!error) {
        const { data: { user } } = await supabase.auth.getUser();
        if (user) { handled = true; const { data: { session } } = await supabase.auth.getSession(); await savePendingData(user, session?.access_token); window.location.href = await postLoginPath(user); return; }
      }
    }
    if (!handled) {
      document.getElementById('statusMsg')!.textContent = 'Не удалось войти. Перенаправляем...';
      setTimeout(() => { window.location.href = '/login'; }, 2000);
    }
  }, 2000);
</script>
