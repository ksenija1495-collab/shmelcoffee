/* ═══ PHASE: SET RESULTS ═══ */
function renderSetResults(card) {
  const targetSize = state.setSize === 'small' ? 4 : 6;
  const wantDrip = state.setFormat === 'drip';
  const topNames = state.topCountries.map(k => DB[k].name);

  const wantedTags = [];
  state.answers.flavors.forEach(f => {
    if (f==='fruity') wantedTags.push('фруктовый','ягодный');
    if (f==='floral') wantedTags.push('цветочный','лёгкий');
    if (f==='chocolate') wantedTags.push('шоколадный','ореховый');
    if (f==='caramel') wantedTags.push('сладкий');
    if (f==='spicy') wantedTags.push('пряный','сложный');
    if (f==='tropical') wantedTags.push('фруктовый','сладкий');
  });

  let pool = COFFEE_DB.slice();

  const scored = pool.map(c => {
    let score = 0;
    if (topNames.includes(c.country)) score += 20;
    wantedTags.forEach(t => { if (c.tags.includes(t)) score += 8; });
    if (wantDrip && c.format === 'дрип') score += 15;
    if (!wantDrip && c.format === 'зерно') score += 5;
    return { coffee: c, score };
  });

  scored.sort((a,b) => b.score - a.score);

  const set = [];
  const usedCountries = new Set();
  const usedRoasters = new Set();

  for (const item of scored) {
    if (set.length >= targetSize) break;
    const c = item.coffee;
    if (wantDrip && c.format !== 'дрип') continue;

    const countryCount = [...set].filter(s => s.coffee.country === c.country).length;
    if (countryCount >= 2) continue;

    set.push(item);
    usedCountries.add(c.country);
    usedRoasters.add(c.roaster);
  }

  if (set.length < targetSize && wantDrip) {
    for (const item of scored) {
      if (set.length >= targetSize) break;
      if (item.coffee.format === 'дрип') continue;
      if (set.some(s => s.coffee.name === item.coffee.name)) continue;
      set.push({ ...item, fallback: true });
    }
  }

  if (set.length < targetSize) {
    for (const item of scored) {
      if (set.length >= targetSize) break;
      if (set.some(s => s.coffee.name === item.coffee.name)) continue;
      set.push(item);
    }
  }

  const totalPrice = set.reduce((sum, s) => sum + s.coffee.price, 0);

  const flags = {'Руанда':'🇷🇼','Колумбия':'🇨🇴','Эфиопия':'🇪🇹','Кения':'🇰🇪','Индонезия':'🇮🇩','Коста-Рика':'🇨🇷','Бразилия':'🇧🇷','Перу':'🇵🇪'};
  const getFlag = (c) => flags[c] || '🌍';

  const getWhy = (item) => {
    const c = item.coffee;
    if (topNames[0] === c.country) return `Ваш основной профиль — ${c.country}`;
    if (topNames.includes(c.country)) return `Рекомендованный регион`;
    return 'Для сравнения и обучения';
  };

  let dripNote = '';
  if (wantDrip && set.some(s => s.fallback)) {
    dripNote = `<div class="equip-feedback ok" style="margin-bottom:14px">
      <strong>☕ Дрип-пакетов с вашим профилем пока мало</strong>
      Добавили зерно — его можно заварить в воронке. <a href="/recipes" style="color:var(--accent);font-weight:600">Рецепт V60 →</a>
    </div>`;
  }

  card.innerHTML = `
    <h3 class="quiz-question">Ваш дегустационный сет</h3>
    <p class="quiz-hint">${set.length} лотов от ${usedRoasters.size} обжарщиков · ${usedCountries.size} стран</p>
    ${dripNote}
    <div class="set-result">
      ${set.map((item, i) => {
        const c = item.coffee;
        const isFallback = item.fallback;
        return `
        <div class="set-result-card" ${isFallback ? 'style="opacity:.85"' : ''}>
          <div class="set-result-head">
            <div>
              <div class="set-result-name">${i+1}. ${c.name} ${isFallback ? '<span style="font-size:.7rem;color:var(--accent)">(зерно)</span>' : ''}</div>
              <div class="set-result-roaster">${c.roaster}</div>
            </div>
            <div style="text-align:right">
              <div class="set-result-price">${c.price} ₽</div>
              <a href="${beanOutLink(c, 'quiz-set')}" target="_blank" rel="noopener" class="set-result-buy">Купить →</a>
            </div>
          </div>
          <div class="set-result-meta">
            <span class="set-meta-chip">${getFlag(c.country)} ${c.country}</span>
            <span class="set-meta-chip">${c.processing}</span>
            ${c.notes.slice(0,3).map(n => `<span class="set-meta-chip">${n}</span>`).join('')}
          </div>
          <div class="set-result-why">${getWhy(item)}</div>
        </div>`;
      }).join('')}
    </div>

    <div class="set-total">
      Итого за сет: <strong>${totalPrice.toLocaleString('ru-RU')} ₽</strong> <span style="color:var(--text-muted);font-size:.78rem">(${set.length} × 250 г)</span>
    </div>

    <div class="guide-block">
      <h3>📖 Гид по дегустации</h3>
      <p>К вашему сету мы подготовим персональный гид: как дегустировать каждый лот, на что обращать внимание, вопросы для сравнения и карту предпочтений.</p>
      <div class="guide-features">
        <span class="guide-feat">☕ Вопросы к каждому лоту</span>
        <span class="guide-feat">📊 Карта предпочтений</span>
        <span class="guide-feat">🔄 Что с чем сравнивать</span>
        <span class="guide-feat">📝 Заметки для дегустации</span>
      </div>
      <div style="display:flex;flex-direction:column;gap:10px;align-items:center">
        <button class="btn btn-primary" id="saveAndOrder" style="font-size:.88rem;padding:10px 24px">
          Сохранить подборку →
        </button>
      </div>
      <p style="font-size:.75rem;color:var(--text-muted);margin-top:10px">Закажите сами у обжарщиков — ссылки выше. Гид по дегустации — на следующем шаге.</p>
    </div>

    <div class="quiz-nav" style="margin-top:20px">
      <button class="btn-ghost" id="backToPrefs">← Изменить настройки</button>
      <button class="btn" id="restartAll">Пройти заново</button>
    </div>
  `;

  document.getElementById('saveAndOrder').addEventListener('click', async () => {
    const btn = document.getElementById('saveAndOrder');
    btn.textContent = 'Сохраняем...';
    btn.disabled = true;

    const selectionData = {
      coffees: set.map(s => {
        const cf = s.coffee;
        return { name: cf.name, roaster: cf.roaster, origin: cf.country, process: cf.processing, notes: (cf.notes||[]).join(', '), price: cf.price, url: cf.url };
      }),
      format: state.setFormat,
      answers: state.answers,
      profileType: state.topCountries.map(k => DB[k].name).join(', '),
      brewMethod: state.equipment,
      tastes: state.answers.flavors,
    };

    let user = await getUser();
    if (!user) {
      sessionStorage.setItem('pendingSelection', JSON.stringify(selectionData));
      window.location.href = '/login';
      return;
    }

    try {
      const token = await getAccessToken();
      if (!token) throw new Error('no token');
      const profileRes = await fetch('/api/save-profile', {
        method: 'POST',
        headers: {'Content-Type':'application/json', 'Authorization': 'Bearer ' + token},
        body: JSON.stringify({
          answers: state.answers,
          profileType: state.topCountries.map(k => DB[k].name).join(', '),
          brewMethod: state.equipment,
          tastes: state.answers.flavors,
          notes: [],
        }),
      });
      if (!profileRes.ok) throw new Error(await profileRes.text());
      const profile = await profileRes.json();

      const selRes = await fetch('/api/save-selection', {
        method: 'POST',
        headers: {'Content-Type':'application/json', 'Authorization': 'Bearer ' + token},
        body: JSON.stringify({
          profileId: profile.id,
          coffees: selectionData.coffees,
          format: state.setFormat,
        }),
      });
      if (!selRes.ok) throw new Error(await selRes.text());

      btn.textContent = '✓ Сохранено';
      state.selectionSaved = true;
      state.phase = 'guide-upsell';
      renderStep();
    } catch (e) {
      alert('Ошибка сохранения: ' + e.message);
      btn.textContent = 'Сохранить подборку →'; btn.disabled = false;
    }
  });

  document.getElementById('backToPrefs').addEventListener('click', () => {
    state.phase = 'set-prefs';
    renderStep();
  });
  document.getElementById('restartAll').addEventListener('click', () => {
    state = { phase:'quiz', step:0, answers:{flavors:[],acidity:null,body:null,sweetness:null}, topCountries:[], wantPractice:null, equipment:null, setFormat:null, setSize:null, profileSaved:false, profileSaving:false, selectionSaved:false };
    renderStep();
  });
}
</script>

</Layout>
