---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import { DB } from '../data/countries';
import { COFFEE_DB } from '../data/coffees';

const SUPA_URL = import.meta.env.PUBLIC_SUPABASE_URL || '';
const SUPA_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '';
const PRODAMUS_URL = import.meta.env.PUBLIC_PRODAMUS_URL || '';
---

<Layout title="Диагностика вкуса — Shmelco">
  <Nav />
  <div class="container">
    <div class="section-anchor quiz-page-wrap" style="padding-top:72px">
      <div class="quiz-progress" id="quizProgress"></div>
      <div class="quiz-card" id="quizCard"></div>
    </div>
  </div>
<style is:global>
  .result-cta {
    display: flex; flex-direction: column; gap: 10px; align-items: center; margin-top: 24px;
  }
  .result-cta .btn-primary { width: 100%; max-width: 420px; }

  .equip-feedback {
    padding: 16px 18px; border-radius: var(--radius); margin: 14px 0;
    border: 1px solid var(--border); line-height: 1.6; font-size: .88rem;
  }
  .equip-feedback.great { background: rgba(107,143,113,.08); border-color: rgba(107,143,113,.25); }
  .equip-feedback.ok { background: rgba(168,124,79,.06); border-color: rgba(168,124,79,.2); }
  .equip-feedback.warn { background: rgba(181,112,77,.06); border-color: rgba(181,112,77,.2); }
  .equip-feedback strong { display: block; font-size: .92rem; margin-bottom: 4px; }
  .equip-feedback .equip-tip { font-size: .78rem; color: var(--text-dim); margin-top: 8px; font-style: italic; }

  .pourover-guide {
    margin-top: 16px; padding: 18px; border-radius: var(--radius);
    background: var(--surface); border: 1px solid var(--border);
  }
  .pourover-guide h4 { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1.05rem; margin-bottom: 10px; }
  .pourover-guide-items { display: grid; gap: 8px; }
  .pourover-guide-item {
    display: flex; gap: 10px; align-items: flex-start;
    padding: 10px 12px; border-radius: 8px; background: var(--surface-2);
    font-size: .82rem; line-height: 1.45;
  }
  .pourover-guide-item .pg-icon { font-size: 1.2rem; flex-shrink: 0; }
  .pourover-guide-item strong { display: block; font-size: .84rem; }

  .practice-choice {
    display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 18px 0;
  }
  .practice-card {
    padding: 20px 16px; border-radius: var(--radius); border: 1px solid var(--border);
    background: var(--surface); text-align: center; cursor: pointer;
    transition: all .2s; box-shadow: var(--shadow);
  }
  .practice-card:hover { border-color: var(--border-hover); box-shadow: var(--shadow-hover); transform: translateY(-2px); }
  .practice-card-icon { font-size: 1.8rem; margin-bottom: 8px; }
  .practice-card-title { font-weight: 700; font-size: .92rem; margin-bottom: 4px; }
  .practice-card-desc { font-size: .78rem; color: var(--text-dim); line-height: 1.45; }

  .offramp {
    text-align: center; padding: 32px 20px;
  }
  .offramp h3 { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1.4rem; margin-bottom: 8px; }
  .offramp p { color: var(--text-dim); font-size: .88rem; margin-bottom: 20px; line-height: 1.6; max-width: 480px; margin-left: auto; margin-right: auto; }
  .offramp-links { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; margin-top: 16px; }
  .offramp-link {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 10px 18px; border-radius: 8px; border: 1px solid var(--border);
    font-size: .82rem; font-weight: 600; color: var(--text-dim);
    text-decoration: none; transition: all .2s; background: var(--surface);
  }
  .offramp-link:hover { border-color: var(--border-hover); color: var(--text); box-shadow: var(--shadow-hover); }
  .offramp-back { margin-top: 18px; font-size: .78rem; color: var(--text-muted); }
  .offramp-back a { color: var(--accent); text-decoration: none; font-weight: 600; cursor: pointer; }
  .quiz-step-hint {
    margin-top: 12px; font-size: .78rem; color: var(--accent-warm); text-align: center;
  }

  .set-pref { display: grid; gap: 14px; margin: 16px 0; }
  .set-pref-group label {
    display: block; font-weight: 700; font-size: .88rem; margin-bottom: 8px;
  }
  .set-pref-options { display: flex; gap: 8px; flex-wrap: wrap; }
  .set-pref-opt {
    padding: 10px 18px; border-radius: 8px; border: 1px solid var(--border);
    font-size: .84rem; cursor: pointer; transition: all .2s; background: var(--surface);
  }
  .set-pref-opt:hover { border-color: var(--border-hover); }
  .set-pref-opt.selected { border-color: var(--text); background: var(--text); color: var(--bg); font-weight: 600; }

  .set-result { margin-top: 18px; }
  .set-result-card {
    padding: 14px 16px; border-radius: var(--radius); border: 1px solid var(--border);
    background: var(--surface); margin-bottom: 10px; box-shadow: var(--shadow);
  }
  .set-result-card:hover { border-color: var(--border-hover); box-shadow: var(--shadow-hover); }
  .set-result-head { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; }
  .set-result-name { font-weight: 700; font-size: .9rem; }
  .set-result-roaster { font-size: .75rem; color: var(--text-muted); }
  .set-result-meta { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 6px; }
  .set-meta-chip {
    padding: 3px 8px; border-radius: 4px; font-size: .7rem;
    background: var(--surface-2); color: var(--text-dim); border: 1px solid var(--border);
  }
  .set-result-why {
    font-size: .75rem; color: var(--accent); margin-top: 6px; font-style: italic;
  }
  .set-result-price { font-weight: 700; font-size: .88rem; white-space: nowrap; }
  .set-result-buy {
    display: inline-flex; padding: 6px 14px; border-radius: 6px;
    background: var(--text); color: var(--bg); font-size: .76rem;
    font-weight: 600; text-decoration: none; transition: all .2s;
  }
  .set-result-buy:hover { background: var(--accent); }

  .set-total {
    text-align: center; margin-top: 16px; padding: 14px;
    background: var(--surface-2); border-radius: var(--radius); font-size: .88rem;
  }
  .set-total strong { font-size: 1.1rem; }

  .guide-block {
    margin-top: 24px; padding: 20px; border-radius: var(--radius);
    background: var(--surface); border: 1px solid var(--border); text-align: center;
  }
  .guide-block h3 { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1.2rem; margin-bottom: 6px; }
  .guide-block p { font-size: .82rem; color: var(--text-dim); margin-bottom: 14px; line-height: 1.55; }
  .guide-features { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin-bottom: 14px; }
  .guide-feat {
    padding: 6px 12px; border-radius: 6px; background: var(--surface-2);
    font-size: .76rem; font-weight: 600; color: var(--text-dim);
  }

  @media (max-width: 768px) {
    .practice-choice { grid-template-columns: 1fr; }
  }
</style>

<script define:vars={{ DB, COFFEE_DB, SUPA_URL, SUPA_KEY, PRODAMUS_URL }}>

async function supaAuth(method, body) {
  const res = await fetch(`${SUPA_URL}/auth/v1/${method}`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'apikey': SUPA_KEY },
    body: JSON.stringify(body),
  });
  return res.json();
}

async function getAccessToken() {
  const ref = SUPA_URL.replace('https://','').split('.')[0];
  const stored = localStorage.getItem(`sb-${ref}-auth-token`);
  if (!stored) return null;
  try { return JSON.parse(stored).access_token || null; } catch { return null; }
}

async function getUser() {
  const ref = SUPA_URL.replace('https://','').split('.')[0];
  const stored = localStorage.getItem(`sb-${ref}-auth-token`);
  if (!stored) return null;
  try {
    const parsed = JSON.parse(stored);
    const token = parsed.access_token;
    if (!token) return null;
    const res = await fetch(`${SUPA_URL}/auth/v1/user`, {
      headers: { 'Authorization': `Bearer ${token}`, 'apikey': SUPA_KEY },
    });
    if (!res.ok) return null;
    return await res.json();
  } catch { return null; }
}

const TOTAL_STEPS = 10;

const quizSteps = [
  { question:'Какие вкусы вам ближе?', hint:'Выберите 1–3 варианта', multi:true, options:[
    {id:'fruity',icon:'🍒',label:'Фруктовые',desc:'Ягоды, цитрусы, косточковые'},
    {id:'floral',icon:'🌸',label:'Цветочные и чайные',desc:'Жасмин, роза, бергамот, чай'},
    {id:'chocolate',icon:'🍫',label:'Шоколадные и ореховые',desc:'Какао, фундук, миндаль'},
    {id:'caramel',icon:'🍯',label:'Карамельные и медовые',desc:'Карамель, мёд, коричневый сахар'},
    {id:'spicy',icon:'🌿',label:'Пряные и землистые',desc:'Специи, табак, дерево, земля'},
    {id:'tropical',icon:'🥭',label:'Тропические фрукты',desc:'Манго, личи, маракуйя'},
  ]},
  { question:'Как вы относитесь к кислотности?', hint:'Кислотность — не «кислый» вкус, а яркость и сочность', multi:false, options:[
    {id:'high',icon:'⚡',label:'Люблю яркую, сочную',desc:'Как откусить спелый фрукт'},
    {id:'medium',icon:'⚖️',label:'Предпочитаю сбалансированную',desc:'Заметная, но не доминирующая'},
    {id:'low',icon:'🌊',label:'Хочу мягкий, гладкий вкус',desc:'Минимальная кислотность, комфорт'},
  ]},
  { question:'Какое тело напитка?', hint:'Тело — ощущение плотности кофе на языке', multi:false, options:[
    {id:'light',icon:'🍵',label:'Лёгкое, чайное',desc:'Прозрачное, как хороший чай'},
    {id:'med',icon:'🥛',label:'Среднее, шелковистое',desc:'Приятная плотность, баланс'},
    {id:'heavy',icon:'🫗',label:'Плотное, сиропистое',desc:'Тяжёлое, обволакивающее'},
  ]},
  { question:'Какой тип сладости ближе?', hint:'Кофе — сладкий напиток, просто по-разному', multi:false, options:[
    {id:'fruitSw',icon:'🍓',label:'Фруктовая сладость',desc:'Ягоды, спелые фрукты'},
    {id:'honeySw',icon:'🍯',label:'Медовая, карамельная',desc:'Мёд, тростниковый сахар, ириска'},
    {id:'chocoSw',icon:'🍫',label:'Шоколадная, какао',desc:'Тёмный шоколад, горьковатая'},
    {id:'drySw',icon:'🌰',label:'Сухая, минимальная',desc:'Орехи, древесина, сухой финиш'},
  ]}
];

const EQUIP_OPTIONS = [
  {id:'pourover', icon:'🫖', label:'Воронка (V60, Калита, Кемекс)', desc:'Пуровер — ручной пролив через фильтр'},
  {id:'drip', icon:'☕', label:'Дрип-пакеты', desc:'Залить водой — без оборудования'},
  {id:'frenchpress', icon:'🫕', label:'Френч-пресс', desc:'Иммерсионный метод — погружение'},
  {id:'espresso', icon:'⚙️', label:'Кофемашина / эспрессо', desc:'Автомат или рожковая машина'},
];

const EQUIP_FEEDBACK = {
  pourover: {
    cls: 'great',
    title: '🫖 Отличный выбор!',
    text: 'Воронка — лучший способ погрузиться в мир specialty-кофе. Чистая чашка без масел, каждая нота читается. Вы сможете менять переменные (помол, температура, пролив) и слышать, как это влияет на вкус.',
    showGuide: false,
  },
  drip: {
    cls: 'ok',
    title: '☕ Хорошее начало!',
    text: 'Дрип-пакеты — простой способ попробовать specialty. Но выбор стран и обработок будет сильно ограничен, а настроить вкус (помол, температура) не получится. Для серьёзного погружения рекомендуем воронку — она раскроет в десятки раз больше.',
    showGuide: true,
  },
  frenchpress: {
    cls: 'ok',
    title: '🫕 Для начала — ок!',
    text: 'Френч-пресс даёт плотную, маслянистую чашку. Для ежедневного кофе — отлично. Но для изучения вкусов он не идеален: масла и мелкие частицы «смазывают» ноты. Цветочный жасмин или ягодную кислотность в нём сложно расслышать. Для обучения советуем воронку.',
    showGuide: true,
  },
  espresso: {
    cls: 'warn',
    title: '⚙️ Для изучения вкусов — не лучший вариант',
    text: 'Кофемашина скрывает переменные: температура, давление, предсмачивание — всё автоматическое. Эспрессо усиливает ошибки, а малый объём воды делает любое отклонение критическим. Новичок не сможет отличить «плохо настроил» от «зерно такое». Для исследования вкусов настоятельно рекомендуем воронку.',
    showGuide: true,
  },
};

let state = {
  phase: 'quiz',
  step: 0,
  answers: { flavors:[], acidity:null, body:null, sweetness:null },
  topCountries: [],
  wantPractice: null,
  equipment: null,
  setFormat: null,
  setSize: null,
  profileSaved: false,
  profileSaving: false,
  selectionSaved: false,
};

function beanOutLink(c, source) {
  const q = new URLSearchParams({ url: c.url, name: c.name, roaster: c.roaster, source });
  return `/api/bean-out?${q.toString()}`;
}

function buildBuyUrl(user) {
  if (!PRODAMUS_URL || !user) return '';
  const sep = PRODAMUS_URL.includes('?') ? '&' : '?';
  const q = new URLSearchParams();
  q.set('order_id', crypto.randomUUID());
  q.set('order_num', user.id);
  q.set('customer_extra', user.id);
  if (user.email) q.set('customer_email', user.email);
  q.set('urlSuccess', `${window.location.origin}/account?paid=1`);
  q.set('urlReturn', `${window.location.origin}/account`);
  return PRODAMUS_URL + sep + q.toString();
}

renderStep();

function getProgressDots() {
  let total, current;
  if (state.phase === 'quiz') { total = 4; current = state.step; }
  else if (state.phase === 'results') { total = 4; current = 4; }
  else if (state.phase === 'practice-choice') { total = 6; current = 4; }
  else if (state.phase === 'offramp') { total = 6; current = 5; }
  else if (state.phase === 'equipment') { total = 8; current = 5; }
  else if (state.phase === 'equip-feedback') { total = 8; current = 6; }
  else if (state.phase === 'set-offer') { total = 10; current = 7; }
  else if (state.phase === 'set-prefs') { total = 10; current = 8; }
  else if (state.phase === 'set-results') { total = 10; current = 9; }
  else { total = 10; current = 10; }

  let html = '';
  for (let i = 0; i < total; i++) {
    const cls = i < current ? 'done' : (i === current ? 'active' : '');
    html += `<div class="quiz-dot ${cls}"></div>`;
  }
  return html;
}

function renderStep() {
  const progress = document.getElementById('quizProgress');
  const card = document.getElementById('quizCard');
  progress.innerHTML = getProgressDots();

  if (state.phase === 'quiz') renderQuiz(card);
  else if (state.phase === 'results') renderResults(card);
  else if (state.phase === 'practice-choice') renderPracticeChoice(card);
  else if (state.phase === 'offramp') renderOfframp(card);
  else if (state.phase === 'guide-upsell') renderGuideUpsell(card);
  else if (state.phase === 'equipment') renderEquipment(card);
  else if (state.phase === 'equip-feedback') renderEquipFeedback(card);
  else if (state.phase === 'set-offer') renderSetOffer(card);
  else if (state.phase === 'set-prefs') renderSetPrefs(card);
  else if (state.phase === 'set-results') renderSetResults(card);

  window.scrollTo({top: 0, behavior: 'smooth'});
}

/* ═══ PHASE: QUIZ (steps 0-3) ═══ */
function renderQuiz(card) {
  const step = quizSteps[state.step];
  let sel = [];
  if (state.step===0) sel = state.answers.flavors;
  else if (state.step===1) sel = state.answers.acidity ? [state.answers.acidity] : [];
  else if (state.step===2) sel = state.answers.body ? [state.answers.body] : [];
  else if (state.step===3) sel = state.answers.sweetness ? [state.answers.sweetness] : [];

  card.innerHTML = `
    <h3 class="quiz-question">${step.question}</h3>
    <p class="quiz-hint">${step.hint}</p>
    <div class="quiz-options">
      ${step.options.map(o => `
        <div class="quiz-option ${sel.includes(o.id)?'selected':''}" data-id="${o.id}" data-multi="${step.multi}">
          <div class="quiz-option-icon">${o.icon}</div>
          <div>
            <div class="quiz-option-label">${o.label}</div>
            <div class="quiz-option-desc">${o.desc}</div>
          </div>
        </div>
      `).join('')}
    </div>
    <div class="quiz-nav">
      ${state.step > 0 ? '<button class="btn-ghost" id="prevBtn">← Назад</button>' : '<span></span>'}
      <button class="btn btn-primary" id="nextBtn" style="font-size:.82rem;padding:8px 18px">
        ${state.step === 3 ? 'Узнать свой профиль →' : 'Далее →'}
      </button>
    </div>
  `;

  card.querySelectorAll('.quiz-option').forEach(el => {
    el.addEventListener('click', () => {
      const id = el.dataset.id;
      if (state.step===0) {
        const idx = state.answers.flavors.indexOf(id);
        if (idx>-1) state.answers.flavors.splice(idx,1);
        else if (state.answers.flavors.length<3) state.answers.flavors.push(id);
      } else if (state.step===1) state.answers.acidity = state.answers.acidity===id ? null : id;
      else if (state.step===2) state.answers.body = state.answers.body===id ? null : id;
      else if (state.step===3) state.answers.sweetness = state.answers.sweetness===id ? null : id;
      renderStep();
    });
  });

  const prevBtn = document.getElementById('prevBtn');
  if (prevBtn) prevBtn.addEventListener('click', () => { state.step--; renderStep(); });
  document.getElementById('nextBtn').addEventListener('click', () => {
    const hintEl = document.getElementById('quizStepHint');
    const needHint = (msg) => {
      let el = hintEl;
      if (!el) {
        el = document.createElement('p');
        el.id = 'quizStepHint';
        el.className = 'quiz-step-hint';
        card.querySelector('.quiz-nav')?.before(el);
      }
      el.textContent = msg;
    };
    if (state.step===0 && state.answers.flavors.length===0) { needHint('Выберите от 1 до 3 вкусов'); return; }
    if (state.step===1 && !state.answers.acidity) { needHint('Выберите уровень кислотности'); return; }
    if (state.step===2 && !state.answers.body) { needHint('Выберите тело чашки'); return; }
    if (state.step===3 && !state.answers.sweetness) { needHint('Выберите сладость'); return; }
    document.getElementById('quizStepHint')?.replaceChildren();
    if (state.step < 3) { state.step++; renderStep(); }
    else { calcResults(); state.phase = 'results'; renderStep(); autoSaveProfileSilent(); }
  });
}

async function autoSaveProfileSilent() {
  if (state.profileSaved || state.profileSaving) return;
  state.profileSaving = true;
  updateProfileBadge();

  const user = await getUser();
  if (!user) { state.profileSaving = false; updateProfileBadge(); return; }

  try {
    const token = await getAccessToken();
    if (!token) return;
    const res = await fetch('/api/save-profile', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
      body: JSON.stringify({
        answers: state.answers,
        profileType: state.topCountries.map(k => DB[k].name).join(', '),
        brewMethod: state.equipment || null,
        tastes: state.answers.flavors,
        notes: [],
      }),
    });
    if (res.ok) state.profileSaved = true;
  } catch (e) { console.error('Profile auto-save:', e); }

  state.profileSaving = false;
  updateProfileBadge();
}

function updateProfileBadge() {
  const el = document.getElementById('profileSaveBadge');
  if (!el) return;
  if (state.profileSaved) el.textContent = '✓ Профиль сохранён в кабинете';
  else if (state.profileSaving) el.textContent = 'Сохраняем профиль…';
  else el.textContent = 'Войдите, чтобы сохранить профиль';
}

async function ensureProfileSaved() {
  if (state.profileSaved) return true;
  const user = await getUser();
  if (!user) {
    sessionStorage.setItem('pendingProfile', JSON.stringify({
      answers: state.answers,
      profileType: state.topCountries.map(k => DB[k].name).join(', '),
      brewMethod: state.equipment || null,
      tastes: state.answers.flavors,
    }));
    window.location.href = '/login';
    return false;
  }
  await autoSaveProfileSilent();
  return state.profileSaved;
}

function calcResults() {
  const scores = {};
  for (const [k,c] of Object.entries(DB)) {
    let s = 0;
    state.answers.flavors.forEach(f => { s += (c.sc[f]||0); });
    if (state.answers.acidity) s += (c.sc[state.answers.acidity]||0);
    if (state.answers.body) s += (c.sc[state.answers.body]||0);
    if (state.answers.sweetness) s += (c.sc[state.answers.sweetness]||0);
    scores[k] = s;
  }
  const sorted = Object.entries(scores).sort((a,b) => b[1]-a[1]);
  state.topCountries = sorted.slice(0,3).map(([k]) => k);
}

/* ═══ PHASE: RESULTS ═══ */
function renderResults(card) {
  const top = state.topCountries;
  const m = DB[top[0]];

  card.innerHTML = `
    <div class="result-main">
      <div class="result-hero-block">
        <div class="result-flag">${m.flag}</div>
