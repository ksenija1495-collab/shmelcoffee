---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import { DB, countryOrder } from '../data/countries';
---

<Layout title="Добавить на полку — Shmelco" description="Добавьте зерно или оборудование на свою полку">
  <Nav />
  <div class="container">
    <div class="shelf-form-page">
      <a href="/account" class="sf-back">← В кабинет</a>
      <h1 id="sfTitle">Добавить на полку</h1>
      <p class="sf-sub">Что у вас есть дома — зерно или оборудование. Можно с фото.</p>
      <div class="sf-card" id="sfFormCard">
        <div class="kind-toggle">
          <button type="button" class="kind-btn" data-kind="bean">🫘 Зерно</button>
          <button type="button" class="kind-btn" data-kind="equipment">⚙️ Оборудование</button>
        </div>
        <label class="fl">Название *</label>
        <input type="text" id="f_name" placeholder="напр. Эфиопия Гедео / Воронка V60"/>
        <div id="beanFields">
          <label class="fl">Сорт</label>
          <select id="f_variety"></select>
          <div id="varietyCustomRow" class="variety-custom" style="display:none">
            <input type="text" id="f_variety_custom" placeholder="Какой сорт? напр. Sidra, Pink Bourbon"/>
          </div>
          <label class="fl">Обжарщик</label>
          <input type="text" id="f_roaster" placeholder="напр. Tasty Coffee"/>
          <div class="row2">
            <div><label class="fl">Страна</label><select id="f_country"></select></div>
            <div><label class="fl">Обработка</label><select id="f_process"></select></div>
          </div>
          <div id="brewPreview" class="brew-preview" hidden></div>
        </div>
        <div id="equipFields" style="display:none">
          <label class="fl">Категория</label>
          <select id="f_category"></select>
        </div>
        <label class="fl">Фото</label>
        <input type="file" id="f_photo" accept="image/*"/>
        <div id="preview" class="photo-preview"></div>
        <button type="button" class="btn btn-primary sf-save" id="saveBtn">Добавить на полку</button>
        <div id="msg" class="sf-msg"></div>
      </div>
      <div id="brewDone" class="brew-done" hidden></div>
    </div>
  </div>
<style is:global>
  .shelf-form-page { padding-top: 88px; max-width: 600px; margin: 0 auto; padding-bottom: 100px; }
  .sf-back { font-size: .8rem; color: var(--text-muted); text-decoration: none; }
  .sf-back:hover { color: var(--accent); }
  .shelf-form-page h1 { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1.6rem; font-weight: 600; margin: 12px 0 4px; }
  .sf-sub { font-size: .84rem; color: var(--text-dim); margin-bottom: 20px; }
  .sf-card { padding: 22px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow); }
  .sf-card .fl { display: block; font-size: .8rem; font-weight: 600; color: var(--text); margin: 14px 0 6px; }
  .sf-card input[type=text], .sf-card select { width: 100%; padding: 11px 12px; border: 1px solid var(--border); border-radius: 10px; font-size: .92rem; background: var(--bg); color: var(--text); font-family: 'Inter', sans-serif; }
  .sf-card input[type=file] { font-size: .82rem; }
  .variety-custom { margin-top: 8px; }
  .variety-custom input {
    width: 100%; padding: 11px 12px; border: 1px solid var(--border); border-radius: 10px;
    font-size: .92rem; background: var(--bg); color: var(--text); font-family: 'Inter', sans-serif;
  }
  .row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .kind-toggle { display: flex; gap: 8px; margin-bottom: 6px; }
  .kind-btn { flex: 1; padding: 11px; border-radius: 10px; border: 1px solid var(--border); background: var(--bg); font-size: .88rem; cursor: pointer; font-family: 'Inter', sans-serif; transition: .15s; }
  .kind-btn.on { background: var(--accent); color: #fff; border-color: var(--accent); }
  .photo-preview { margin-top: 10px; }
  .photo-preview img { max-width: 100%; max-height: 180px; border-radius: 10px; border: 1px solid var(--border); }
  .sf-save { width: 100%; margin-top: 20px; }
  .sf-msg { margin-top: 12px; font-size: .84rem; text-align: center; min-height: 20px; }
  .sf-msg.error { color: var(--accent-warm); }
  .brew-preview, .brew-done {
    margin-top: 16px; padding: 14px 16px; border-radius: 12px;
    background: var(--bg); border: 1px solid var(--border);
  }
  .brew-done { margin-top: 0; box-shadow: var(--shadow); background: var(--surface); }
  .brew-rec-h { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1.2rem; font-weight: 600; margin: 0 0 4px; }
  .brew-rec-sub { font-size: .78rem; color: var(--text-muted); margin-bottom: 12px; }
  .brew-rec-card { padding: 10px 0; }
  .brew-rec-card + .brew-rec-card { border-top: 1px solid var(--border); }
  .brew-rec-label { font-size: .78rem; font-weight: 700; color: var(--text); }
  .brew-rec-params { font-size: .84rem; color: var(--text); margin-top: 3px; line-height: 1.4; }
  .brew-rec-time { font-size: .76rem; color: var(--text-dim); margin-top: 2px; }
  .brew-rec-note { font-size: .76rem; color: var(--text-muted); margin-top: 4px; line-height: 1.4; }
  .brew-rec-why, .brew-rec-avoid { font-size: .76rem; color: var(--text-dim); margin-top: 10px; line-height: 1.45; }
  .brew-done-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }
  .brew-done-actions a, .brew-done-actions button {
    flex: 1; min-width: 140px; text-align: center; padding: 11px 14px; border-radius: 10px;
    font-size: .84rem; font-weight: 600; font-family: 'Inter', sans-serif; cursor: pointer; text-decoration: none;
  }
  .brew-done-primary { background: var(--text); color: var(--bg); border: 1px solid var(--text); }
  .brew-done-primary:hover { background: var(--accent); border-color: var(--accent); }
  .brew-done-secondary { background: var(--bg); color: var(--text); border: 1px solid var(--border); }
  .brew-done-secondary:hover { border-color: var(--accent); color: var(--accent); }
  @media (max-width: 600px) { .shelf-form-page { padding-top: 72px; } .row2 { grid-template-columns: 1fr; } }
</style>

<script>
  import { createClient } from '@supabase/supabase-js';
  import { DB, countryOrder } from '../data/countries';
  import { BEAN_VARIETIES } from '../data/varieties';
  import { bindVarietyOther, readVarietyValue } from '../lib/beanVarietyField';
  import { PROCESS_OPTIONS } from '../data/processing';
  import { recommendBrew, renderBrewRecHtml } from '../lib/brewRecommend';

  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
    { auth: { flowType: 'implicit' } }
  );

  const PROCESSES = PROCESS_OPTIONS;
  const CATEGORIES = ['Воронка','Кофемолка','Весы','Чайник с тонким носиком','Эспрессо-машина','Гейзерная','Френч-пресс','Аэропресс','Кемекс','Турка','Капсульная','Другое'];
  let kind = 'bean';
  let photoFile: File | null = null;

  function fill(id: string, arr: readonly string[], ph: string) {
    const s = document.getElementById(id) as HTMLSelectElement;
    s.innerHTML = `<option value="">${ph}</option>` + arr.map(x => `<option>${x}</option>`).join('');
  }

  function setSelect(id: string, value: string) {
    const s = document.getElementById(id) as HTMLSelectElement;
    if (!s || !value) return;
    if (![...s.options].some((o) => o.value === value)) {
      const opt = document.createElement('option');
      opt.value = value; opt.textContent = value;
      s.appendChild(opt);
    }
    s.value = value;
  }

  async function guard() {
    const { data: { user } } = await supabase.auth.getUser();
    if (!user) { window.location.href = '/login'; return null; }
    return user;
  }

  function beanInput() {
    return {
      name: (document.getElementById('f_name') as HTMLInputElement).value.trim(),
      variety: readVarietyValue(),
      country: (document.getElementById('f_country') as HTMLSelectElement).value || null,
      process: (document.getElementById('f_process') as HTMLSelectElement).value || null,
    };
  }

  function updateBrewPreview() {
    const box = document.getElementById('brewPreview')!;
    if (kind !== 'bean') { box.hidden = true; box.innerHTML = ''; return; }
    const input = beanInput();
    if (!input.country && !input.process) { box.hidden = true; box.innerHTML = ''; return; }
    const rec = recommendBrew(input);
    if (!rec) { box.hidden = true; box.innerHTML = ''; return; }
    box.hidden = false;
    box.innerHTML = renderBrewRecHtml(rec);
  }

  function showBrewDone(payload: any, addCupUrl: string) {
    const form = document.getElementById('sfFormCard')!;
    const done = document.getElementById('brewDone')!;
    form.hidden = true;
    const rec = recommendBrew(payload);
    const tip = rec
      ? renderBrewRecHtml(rec)
      : `<div class="brew-rec-h">Зерно на полке</div><div class="brew-rec-sub">Укажи страну и обработку в следующий раз — появится рецепт.</div>`;
    done.hidden = false;
    done.innerHTML = `
      <div style="font-size:.78rem;color:var(--text-muted);margin-bottom:8px">✓ Добавлено на полку</div>
      ${tip}
      <div class="brew-done-actions">
        <a class="brew-done-primary" href="${addCupUrl}">Заварить сейчас →</a>
        <a class="brew-done-secondary" href="/account?tab=shelf">К полке</a>
      </div>`;
  }

  function setKind(k: string) {
    kind = k;
    document.querySelectorAll('.kind-btn').forEach(b => b.classList.toggle('on', (b as HTMLElement).dataset.kind === k));
    (document.getElementById('beanFields') as HTMLElement).style.display = k === 'bean' ? 'block' : 'none';
    (document.getElementById('equipFields') as HTMLElement).style.display = k === 'equipment' ? 'block' : 'none';
    document.getElementById('sfTitle')!.textContent = k === 'bean' ? 'Добавить зерно' : 'Добавить оборудование';
    updateBrewPreview();
  }

  function build() {
    fill('f_variety', BEAN_VARIETIES, '— не знаю / смесь');
    bindVarietyOther();
    fill('f_country', countryOrder.map((k: string) => (DB as any)[k].name), 'выберите страну');
    fill('f_process', PROCESSES, 'выберите обработку');
    fill('f_category', CATEGORIES, 'выберите категорию');
    document.querySelectorAll('.kind-btn').forEach(b => b.addEventListener('click', () => setKind((b as HTMLElement).dataset.kind!)));
    const params = new URLSearchParams(window.location.search);
    setKind(params.get('kind') === 'equipment' ? 'equipment' : 'bean');
    const preCountry = params.get('country');
    if (preCountry) setSelect('f_country', preCountry);
    const fileInp = document.getElementById('f_photo') as HTMLInputElement;
    fileInp.addEventListener('change', () => {
      photoFile = fileInp.files && fileInp.files[0] ? fileInp.files[0] : null;
      const prev = document.getElementById('preview')!;
      if (photoFile) { prev.innerHTML = `<img src="${URL.createObjectURL(photoFile)}"/>`; } else { prev.innerHTML = ''; }
    });
    ['f_name', 'f_country', 'f_process', 'f_variety', 'f_variety_custom'].forEach((id) => {
      document.getElementById(id)?.addEventListener('input', updateBrewPreview);
      document.getElementById(id)?.addEventListener('change', updateBrewPreview);
    });
    document.getElementById('saveBtn')!.addEventListener('click', save);
    updateBrewPreview();
  }

  async function save() {
    const user = await guard();
    if (!user) return;
    const name = (document.getElementById('f_name') as HTMLInputElement).value.trim();
    const msg = document.getElementById('msg')!;
    if (!name) { msg.className = 'sf-msg error'; msg.textContent = 'Добавьте название'; return; }
    const btn = document.getElementById('saveBtn') as HTMLButtonElement;
    btn.disabled = true; btn.textContent = 'Сохраняем...';
    let photo_url: string | null = null;
    try {
      if (photoFile) {
        const ext = (photoFile.name.split('.').pop() || 'jpg').toLowerCase();
        const path = `${user.id}/${Date.now()}.${ext}`;
        const { error: upErr } = await supabase.storage.from('shelf').upload(path, photoFile, { upsert: false, contentType: photoFile.type });
        if (upErr) throw upErr;
        const { data: pub } = supabase.storage.from('shelf').getPublicUrl(path);
        photo_url = pub.publicUrl;
      }
      const payload: any = {
        user_id: user.id, kind, name,
        variety: kind === 'bean' ? readVarietyValue() : null,
        roaster: kind === 'bean' ? ((document.getElementById('f_roaster') as HTMLInputElement).value.trim() || null) : null,
        country: kind === 'bean' ? ((document.getElementById('f_country') as HTMLSelectElement).value || null) : null,
        process: kind === 'bean' ? ((document.getElementById('f_process') as HTMLSelectElement).value || null) : null,
        category: kind === 'equipment' ? ((document.getElementById('f_category') as HTMLSelectElement).value || null) : null,
        photo_url, source: 'manual',
      };
      const { error } = await supabase.from('shelf_items').insert(payload);
      if (error) throw error;
      if (kind === 'bean') {
        const q = new URLSearchParams();
        q.set('name', name);
        if (payload.roaster) q.set('roaster', payload.roaster);
        if (payload.country) q.set('country', payload.country);
        if (payload.process) q.set('process', payload.process);
        q.set('from_shelf', '1');
        showBrewDone(payload, `/add-cup?${q.toString()}`);
      } else {
        window.location.href = '/account?tab=shelf';
      }
    } catch (e: any) {
      msg.className = 'sf-msg error'; msg.textContent = 'Ошибка: ' + (e.message || e);
      btn.disabled = false; btn.textContent = 'Добавить на полку';
    }
  }

  (async () => { if (await guard()) build(); })();
</script>

</Layout>
