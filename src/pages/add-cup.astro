---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import { wheelData } from '../data/wheel';
import { DB, countryOrder } from '../data/countries';
---

<Layout title="Добавить кофе — Shmelco" description="Запишите кофе, который пьёте дома или заказали сами">
  <Nav />
  <div class="container">
    <div class="addcup-page">
      <a href="/account" class="addcup-back">← В кабинет</a>
      <h1>Добавить своё кофе</h1>
      <p class="addcup-sub">Кофе из дома или заказанный вне подборок. Запись наполнит вашу Карту вкуса и откроет страны.</p>
      <div class="addcup-card" id="formCard">
        <div id="fromGuide" class="fromguide" style="display:none"></div>
        <div id="shelfBeanPicker" class="shelf-bean-picker" style="display:none">
          <label class="fl" for="f_shelf_bean">Зерно с полки</label>
          <select id="f_shelf_bean">
            <option value="">— выбрать зерно с полки —</option>
          </select>
        </div>
        <label class="fl">Кофе / зерно *</label>
        <input type="text" id="f_name" placeholder="напр. Эфиопия Гедео"/>
        <label class="fl">Обжарщик</label>
        <input type="text" id="f_roaster" placeholder="напр. Tasty Coffee, Rockets"/>
        <label class="fl">Сорт</label>
        <select id="f_variety"></select>
        <div id="varietyCustomRow" class="variety-custom" style="display:none">
          <input type="text" id="f_variety_custom" placeholder="Какой сорт? напр. Sidra, Pink Bourbon"/>
        </div>
        <div class="row2">
          <div><label class="fl">Страна</label><select id="f_country"></select>
            <div id="countryCustomRow" class="variety-custom" style="display:none">
              <input type="text" id="f_country_custom" placeholder="Напр. Гавайи, Панама, Уганда"/>
            </div>
            <p class="field-hint">Не нашла в списке — выбери «Другая страна…» и введи вручную</p></div>
          <div><label class="fl">Обработка</label><select id="f_process"></select></div>
        </div>
        <div class="shelf-add-row" id="shelfAddRow">
          <label class="shelf-add-check"><input type="checkbox" id="f_to_shelf" checked/><span>Добавить зерно на полку</span></label>
          <p class="field-hint shelf-add-hint" id="shelfAddHint">Полка помнит зерно между чашками — заваришь его снова в один клик и не будешь заполнять поля заново.</p>
        </div>
        <label class="fl">Способ заваривания</label>
        <select id="f_brew"></select>
        <details class="recipe-picker" id="recipePicker">
          <summary class="recipe-picker-summary">Выбрать рецепт</summary>
          <div class="recipe-picker-body">
            <p class="field-hint recipe-picker-hint">Сначала свои сохранённые — чемпионские раскрываются отдельно.</p>
            <details class="my-recipes-details" id="myRecipesDetails">
              <summary class="my-recipes-summary"><span id="myRecipesSummaryLabel">📋 Мои рецепты</span></summary>
              <div id="myRecipesPanel" class="my-recipes-panel"></div>
            </details>
            <details class="champ-recipes-details" id="champRecipesDetails">
              <summary class="champ-recipes-summary"><span class="champ-recipes-toggle-label">🏆 Чемпионские рецепты</span></summary>
              <div id="champRecipesPanel" class="champ-recipes-panel"></div>
            </details>
          </div>
        </details>
        <label class="fl">Рецепт — как ты заваривал</label>
        <div class="recipe-grid">
          <input type="number" id="r_coffee_g" inputmode="decimal" min="0" step="0.1" placeholder="Зерно, г (напр. 15)"/>
          <input type="number" id="r_water_g" inputmode="decimal" min="0" step="1" placeholder="Вода, г (напр. 250)"/>
          <input type="text" id="r_grind" placeholder="Помол (напр. средний)"/>
          <select id="r_grinder"><option value="">— молка с полки —</option></select>
          <input type="text" id="r_temp" placeholder="Вода °C (напр. 94)"/>
          <input type="text" id="r_time" class="brew-time-inp" inputmode="numeric" placeholder="2:30"/>
        </div>
        <p class="field-hint brew-time-hint">Время в формате м:сс — набираешь 150, получаешь 1:50</p>
        <div id="grinderHint" class="recipe-hint" style="display:none;margin-top:4px">Отметь кофемолку во вкладке <a href="/account?tab=shelf#equipSection">Зерно</a> — она появится в списке.</div>
        <label class="fl">Проливы</label>
        <p class="pour-block-hint">Пролив — порция воды через кофе. «до» — итоговый вес на весах (долила до 150 мл), без флага — сколько мл влила в этот пролив. «байпас» — вода мимо кофе (разбавление после пресса).</p>
        <div class="pour-block-head">
          <span class="pour-col-spacer"></span>
          <span class="pour-col-h">мл</span>
          <span class="pour-col-h">время</span>
          <span class="pour-col-spacer pour-col-spacer--btn"></span>
        </div>
        <div class="pour-block">
          <div class="pour-row pour-row--bloom">
            <span class="pour-lbl">Предсмачивание<span class="pour-lbl-sub">блум</span></span>
            <input type="number" id="p_bloom_ml" class="pour-inp pour-ml-inp" inputmode="decimal" min="0" step="1" placeholder="40"/>
            <input type="text" id="p_bloom" class="pour-inp brew-time-inp" inputmode="numeric" placeholder="0:30"/>
          </div>
          <div id="pourList"></div>
          <div class="pour-add-row">
            <button type="button" class="pour-add" id="addPourBtn">+ Пролив</button>
            <button type="button" class="pour-add pour-add-bypass" id="addBypassBtn">+ Байпас</button>
          </div>
        </div>
        <div id="recipeHint" class="recipe-hint" style="display:none">Подставлен рецепт — поправь под то, как заварил на самом деле.</div>
        <div id="recipeActions" class="recipe-actions">
          <button type="button" class="recipe-act-btn" id="saveBaseRecipeBtn">⭐ Сохранить в мои рецепты</button>
        </div>
        <label class="fl">Баланс вкуса</label>
        <p class="balance-hint">Слайдер — сила. Теги — характер, можно несколько.</p>
        <div id="tasteSection" class="taste-panel"></div>
        <label class="fl">Вкус и ароматы — что чувствуешь в чашке</label>
        <p class="note-cat-hint">Колесо вкусов — нажми сектор или выбери подсказку в списке ниже</p>
        <div id="selectedNotes" class="note-selected"></div>
        <div class="note-wheel-wrap">
          <svg id="noteWheelSvg" class="note-wheel-svg" viewBox="0 0 720 720" aria-label="Колесо вкусов для выбора нот"></svg>
        </div>
        <div id="noteWheelPanel" class="note-wheel-panel"></div>
        <label class="fl">Оценка</label>
        <div id="rating" class="rating"></div>
        <label class="fl">Заметка</label>
        <textarea id="f_comment" rows="3" placeholder="Ваши впечатления, рецепт, мысли…"></textarea>
        <button class="btn btn-primary save-btn" id="saveBtn">Сохранить чашку</button>
        <div id="msg" class="addcup-msg"></div>
      </div>
    </div>
  </div>
<style is:global>
  .addcup-page { padding-top: 88px; max-width: 600px; margin: 0 auto; padding-bottom: 100px; }
  .addcup-back { font-size: .8rem; color: var(--text-muted); text-decoration: none; }
  .addcup-back:hover { color: var(--accent); }
  .addcup-page h1 { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1.6rem; font-weight: 600; margin: 12px 0 4px; }
  .addcup-sub { font-size: .84rem; color: var(--text-dim); margin-bottom: 20px; line-height: 1.5; }
  .addcup-card { padding: 22px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow); }
  .addcup-card[inert] { opacity: .5; pointer-events: none; }
  .addcup-card .fl { display: block; font-size: .8rem; font-weight: 600; color: var(--text); margin: 14px 0 6px; }
  .addcup-card input[type=text], .addcup-card input[type=number], .addcup-card select, .addcup-card textarea {
    width: 100%; padding: 11px 12px; border: 1px solid var(--border); border-radius: 10px;
    font-size: .92rem; background: var(--bg); color: var(--text); font-family: 'Inter', sans-serif;
  }
  .addcup-card textarea { resize: vertical; }
  .row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .recipe-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .pour-block { margin-top: 4px; display: flex; flex-direction: column; gap: 8px; }
  .pour-block-head {
    display: grid; grid-template-columns: 92px 1fr 1fr 32px; gap: 8px; align-items: center;
    padding: 0 0 2px;
  }
  .pour-col-h { font-size: .62rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: var(--text-muted); text-align: center; }
  .pour-col-spacer--btn { width: 32px; }
  .pour-row {
    display: grid; grid-template-columns: 92px 1fr 1fr 32px; gap: 6px 8px; align-items: center;
  }
  .pour-row--bloom { grid-template-columns: 92px 1fr 1fr; }
  .pour-row.is-bypass { background: rgba(90,140,90,.06); border-radius: 10px; padding: 6px 4px; }
  .pour-lbl { font-size: .78rem; color: var(--text-dim); font-weight: 600; line-height: 1.25; }
  .pour-lbl-sub { display: block; font-size: .62rem; font-weight: 500; color: var(--text-muted); }
  .pour-block-hint { font-size: .68rem; color: var(--text-muted); margin: 0 0 8px; line-height: 1.45; }
  .pour-ml-wrap { display: flex; gap: 4px; align-items: center; min-width: 0; }
  .pour-inp {
    width: 100%; padding: 10px 12px; border: 1px solid var(--border); border-radius: 10px;
    font-size: .92rem; background: var(--bg); color: var(--text); font-family: 'Inter', sans-serif;
  }
  .pour-flag {
    flex-shrink: 0; padding: 7px 8px; border: 1px solid var(--border); border-radius: 8px;
    background: var(--bg); color: var(--text-muted); font-size: .68rem; font-weight: 700;
    cursor: pointer; font-family: 'Inter', sans-serif; line-height: 1; letter-spacing: .02em;
  }
  .pour-flag[aria-pressed="true"] {
    background: var(--text); color: var(--bg); border-color: var(--text);
  }
  .pour-flag.pour-bypass-flag[aria-pressed="true"] {
    background: var(--accent); border-color: var(--accent); color: #fff;
  }
  .pour-flags { grid-column: 2 / 4; display: flex; gap: 6px; flex-wrap: wrap; }
  .pour-rm {
    width: 32px; height: 32px; border: 1px solid var(--border); border-radius: 8px;
    background: var(--bg); color: var(--text-muted); cursor: pointer; font-size: 1rem; line-height: 1;
  }
  .pour-rm:hover { border-color: var(--accent-warm); color: var(--accent-warm); }
  .pour-add-row { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 2px; }
  .pour-add {
    padding: 7px 12px; border: 1px dashed var(--border);
    border-radius: 8px; background: none; color: var(--accent); font-size: .78rem; font-weight: 600;
    cursor: pointer; font-family: 'Inter', sans-serif;
  }
  .pour-add:hover { border-color: var(--accent); background: rgba(168,124,79,.06); }
  .pour-add-bypass { color: var(--text-dim); }
  .pour-add-bypass:hover { color: var(--accent); }
  .note-selected {
    min-height: 44px; padding: 10px 12px; border: 1px dashed var(--border); border-radius: 12px;
    display: flex; flex-wrap: wrap; gap: 7px; align-items: center; margin-bottom: 10px; background: var(--bg);
  }
  .note-empty { font-size: .78rem; color: var(--text-muted); line-height: 1.45; }
  .note-tag {
    display: inline-flex; align-items: center; gap: 4px; padding: 5px 10px; border-radius: 20px;
    background: var(--accent); color: #fff; font-size: .78rem; font-weight: 600;
  }
  .note-tag-rm {
    background: none; border: 0; color: rgba(255,255,255,.9); cursor: pointer; font-size: 1rem;
    line-height: 1; padding: 0 2px;
  }
  .note-cat { border: 1px solid var(--border); border-radius: 12px; margin-bottom: 8px; overflow: hidden; background: var(--surface); }
  .note-cat-sum {
    list-style: none; cursor: pointer; padding: 12px 14px; font-size: .86rem; font-weight: 700;
    display: flex; align-items: center; gap: 8px; user-select: none;
  }
  .note-cat-sum::-webkit-details-marker { display: none; }
  .note-cat-sum::marker { content: ''; }
  .note-cat-name { flex: 1; min-width: 0; }
  .note-cat-chevron {
    flex-shrink: 0; font-size: 1.05rem; line-height: 1; color: var(--text-muted);
    transition: transform .18s ease; margin-left: auto;
  }
  .note-cat[open] .note-cat-chevron { transform: rotate(90deg); color: var(--accent); }
  .note-cat-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--cat-color, var(--accent)); flex-shrink: 0; }
  .note-cat-badge {
    font-size: .68rem; font-weight: 700; padding: 2px 8px; border-radius: 20px;
    background: var(--surface-2); color: var(--text-muted); min-width: 22px; text-align: center; flex-shrink: 0;
  }
  .note-cat-badge.has { background: rgba(168,124,79,.15); color: var(--accent); }
  .note-cat-body { padding: 0 14px 14px; border-top: 1px solid var(--border); }
  .note-cat-hint {
    font-size: .72rem; color: var(--text-muted); margin: 0 0 10px; line-height: 1.45;
  }
  .note-hint { font-size: .72rem; color: var(--text-muted); margin: 10px 0 8px; }
  .note-custom-row { display: grid; grid-template-columns: 1fr auto; gap: 8px; margin-top: 10px; }
  .note-custom-inp {
    padding: 9px 11px; border: 1px solid var(--border); border-radius: 10px; font-size: .86rem;
    background: var(--bg); color: var(--text); font-family: 'Inter', sans-serif; width: 100%;
  }
  .note-custom-add {
    width: 40px; border: 1px solid var(--border); border-radius: 10px; background: var(--bg);
    color: var(--accent); font-size: 1.1rem; font-weight: 700; cursor: pointer;
  }
  .note-custom-add:hover { border-color: var(--accent); background: rgba(168,124,79,.06); }
  .template-row { margin-bottom: 4px; }
  .template-hint { font-size: .72rem; color: var(--text-muted); margin-top: 4px; line-height: 1.4; }
  .recipe-picker { margin: 4px 0 12px; border: 1px solid var(--border); border-radius: 12px; background: var(--bg); overflow: hidden; }
  .recipe-picker-summary, .my-recipes-summary, .champ-recipes-summary {
    padding: 11px 14px; font-size: .82rem; font-weight: 700; color: var(--text); cursor: pointer;
    list-style: none; user-select: none; display: flex; align-items: center; justify-content: space-between;
  }
  .recipe-picker-summary::-webkit-details-marker, .my-recipes-summary::-webkit-details-marker, .champ-recipes-summary::-webkit-details-marker { display: none; }
  .recipe-picker-summary::after, .my-recipes-summary::after, .champ-recipes-summary::after {
    content: '▼'; font-size: .62rem; opacity: .55; transition: transform .2s;
  }
  .recipe-picker[open] > .recipe-picker-summary::after,
  .my-recipes-details[open] > .my-recipes-summary::after,
  .champ-recipes-details[open] > .champ-recipes-summary::after { transform: rotate(180deg); }
  .recipe-picker-body { padding: 0 14px 14px; }
  .recipe-picker-hint { margin: 0 0 10px; }
  .my-recipes-details, .champ-recipes-details { margin-bottom: 10px; border: 1px dashed var(--border); border-radius: 10px; overflow: hidden; }
  .my-recipes-summary, .champ-recipes-summary { font-size: .78rem; font-weight: 600; color: var(--text-dim); padding: 9px 12px; background: var(--surface); }
  .my-recipes-panel, .champ-recipes-panel { display: flex; flex-direction: column; gap: 8px; padding: 0 10px 10px; }
  .my-recipes-empty {
    padding: 12px 14px; border-radius: 10px; border: 1px dashed var(--border);
    font-size: .76rem; color: var(--text-muted); line-height: 1.45;
  }
  .my-recipe-card {
    display: block; width: 100%; text-align: left; padding: 11px 12px; border-radius: 10px;
    border: 1px solid var(--border); background: var(--bg); cursor: pointer; transition: .12s;
    font-family: 'Inter', sans-serif;
  }
  .my-recipe-card:hover { border-color: var(--accent); }
  .my-recipe-card.on { border-color: var(--text); background: rgba(168,124,79,.08); box-shadow: inset 0 0 0 1px var(--text); }
  .my-recipe-card-h { font-size: .82rem; font-weight: 700; color: var(--text); }
  .my-recipe-card-sub { font-size: .7rem; color: var(--text-muted); margin-top: 3px; line-height: 1.35; }
  .champ-recipes-empty { font-size: .76rem; color: var(--text-muted); line-height: 1.45; padding: 8px 2px; }
  .champ-recipes-empty a { color: var(--accent); font-weight: 600; }
  .champ-pick-card {
    display: block; width: 100%; text-align: left; padding: 10px 12px; border-radius: 10px;
    border: 1px solid var(--border); background: var(--surface); cursor: pointer; transition: .12s;
    font-family: 'Inter', sans-serif;
  }
  .champ-pick-card:hover { border-color: var(--accent); }
  .champ-pick-badge { font-size: .62rem; font-weight: 800; letter-spacing: .06em; color: var(--accent); }
  .champ-pick-title { font-size: .8rem; font-weight: 700; color: var(--text); margin-top: 2px; }
  .champ-pick-sub { font-size: .68rem; color: var(--text-muted); margin-top: 2px; }
  .variety-custom { margin-top: 8px; }
  .variety-custom input {
    width: 100%; padding: 11px 12px; border: 1px solid var(--border); border-radius: 10px;
    font-size: .92rem; background: var(--bg); color: var(--text); font-family: 'Inter', sans-serif;
  }
  .recipe-hint { font-size: .76rem; color: var(--accent); margin-top: 8px; }
  .recipe-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  .recipe-act-btn {
    flex: 1; min-width: 148px; padding: 9px 12px; border-radius: 10px;
    border: 1px solid var(--border); background: var(--bg); color: var(--text-dim);
    font-size: .78rem; font-weight: 600; cursor: pointer; text-align: center;
    font-family: 'Inter', sans-serif; transition: .15s;
  }
  .recipe-act-btn:hover { border-color: var(--accent); color: var(--accent); }
  .sliderrow { margin: 12px 0; }
  .sliderrow .top { display: flex; justify-content: space-between; font-size: .82rem; margin-bottom: 3px; }
  .sliderrow .val { color: var(--accent); font-weight: 700; }
  .sliderrow input[type=range] { width: 100%; accent-color: var(--accent); }
  .balance-hint { font-size: .72rem; color: var(--text-muted); margin: -4px 0 12px; line-height: 1.45; }
  .field-hint { font-size: .68rem; color: var(--text-muted); margin: 4px 0 0; line-height: 1.4; }
  .shelf-bean-picker { margin-bottom: 2px; }
  .shelf-bean-picker .fl { margin-top: 0; }
  .shelf-add-row { margin: 10px 0 4px; padding: 10px 12px; border: 1px solid var(--border); border-radius: 10px; background: var(--bg); }
  .shelf-add-check { display: flex; align-items: center; gap: 8px; font-size: .8rem; font-weight: 600; color: var(--text); cursor: pointer; }
  .shelf-add-check input { width: 16px; height: 16px; accent-color: var(--accent); cursor: pointer; }
  .shelf-add-row.is-on-shelf { border-color: var(--accent); }
  .shelf-add-row.is-on-shelf .shelf-add-check { color: var(--text-muted); cursor: default; }
  .shelf-add-hint { margin-top: 6px; }
  .brew-time-inp, .pour-inp.brew-time-inp { font-variant-numeric: tabular-nums; letter-spacing: .02em; }
  .pour-ml-inp { font-variant-numeric: tabular-nums; text-align: center; }
  .brew-time-hint { margin-top: 6px; }
  .taste-panel {
    padding: 2px 14px 6px; border: 1px solid var(--border); border-radius: 14px; background: var(--bg);
  }
  .taste-row { padding: 14px 0; }
  .taste-row--body { padding-bottom: 10px; }
  .taste-sep { height: 1px; background: var(--border); }
  .taste-row-head {
    display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin-bottom: 8px;
  }
  .taste-row-label { font-size: .84rem; font-weight: 600; color: var(--text); }
  .taste-row-val {
    font-size: .88rem; color: var(--accent); font-weight: 700; font-variant-numeric: tabular-nums;
    min-width: 1.1em; text-align: right;
  }
  .taste-row input[type=range] { width: 100%; accent-color: var(--accent); margin: 0 0 8px; display: block; }
  .taste-row-hint { font-size: .68rem; color: var(--text-muted); margin: 0 0 10px; line-height: 1.4; }
  .taste-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .char-chip {
    padding: 6px 12px; border-radius: 20px; border: 1px solid var(--border); background: var(--surface);
    font-size: .76rem; cursor: pointer; transition: .12s; font-family: 'Inter', sans-serif; color: var(--text);
    line-height: 1.2;
  }
  .char-chip--skip { color: var(--text-muted); background: transparent; border-style: dashed; }
  .char-chip.on { background: var(--accent); color: #fff; border-color: var(--accent); }
  .char-chip.on.char-chip--skip { background: var(--text-muted); border-color: var(--text-muted); border-style: solid; }
  .note-wheel-wrap { margin: 4px 0 12px; text-align: center; }
  .note-wheel-svg {
    width: 100%; max-width: min(520px, 92vw); height: auto; margin: 0 auto; display: block;
  }
  .note-wheel-svg path[data-type] { touch-action: manipulation; }
  .note-wheel-svg path.wheel-seg-selected {
    stroke: var(--text) !important; stroke-width: 3 !important; filter: brightness(0.92);
  }
  .note-wheel-panel {
    display: none; padding: 16px 14px; border: 1px solid var(--border); border-radius: 12px;
    background: var(--surface); margin-bottom: 8px;
  }
  .note-wheel-panel.active { display: block; }
  .note-wheel-panel-head { display: flex; align-items: center; gap: 8px; margin-bottom: 4px; flex-wrap: wrap; }
  .note-wheel-panel-head h3 {
    font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1.15rem; font-weight: 600; margin: 0; flex: 1;
  }
  .note-wheel-panel-dot { width: 12px; height: 12px; border-radius: 50%; flex-shrink: 0; }
  .note-wheel-panel-count { font-size: .68rem; color: var(--text-muted); font-weight: 600; }
  .note-wheel-panel-hint { font-size: .72rem; color: var(--text-muted); margin: 0 0 10px; }
  .note-wheel-chip-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(148px, 1fr)); gap: 7px; }
  .note-wheel-chip {
    text-align: left; padding: 8px 10px; border-radius: 10px; border: 1px solid var(--border);
    background: var(--bg); cursor: pointer; transition: .12s; font-family: 'Inter', sans-serif;
  }
  .note-wheel-chip:hover { border-color: var(--accent); background: rgba(168,124,79,.05); }
  .note-wheel-chip.on { background: var(--accent); border-color: var(--accent); color: #fff; }
  .note-wheel-chip-name { display: block; font-size: .78rem; font-weight: 700; line-height: 1.25; }
  .note-wheel-chip-org { display: block; font-size: .64rem; color: var(--text-muted); margin-top: 2px; line-height: 1.35; }
  .note-wheel-chip.on .note-wheel-chip-org { color: rgba(255,255,255,.82); }
  .note-wheel-custom { margin-top: 12px; }
  .famhdr { font-size: .72rem; font-weight: 700; color: var(--text-muted); margin: 12px 0 5px; text-transform: uppercase; letter-spacing: .04em; }
  .chips { display: flex; flex-wrap: wrap; gap: 7px; }
  .chip {
    padding: 6px 12px; border-radius: 20px; border: 1px solid var(--border); background: var(--bg);
    font-size: .8rem; cursor: pointer; transition: .12s; font-family: 'Inter', sans-serif; color: var(--text);
  }
  .chip.on { background: var(--accent); color: #fff; border-color: var(--accent); }
  .rating { display: flex; gap: 6px; }
  .star { font-size: 1.6rem; cursor: pointer; color: var(--border); transition: .12s; }
  .star.on { color: #E0B81E; }
  .save-btn { width: 100%; margin-top: 20px; }
  .addcup-msg { margin-top: 12px; font-size: .84rem; text-align: center; min-height: 20px; }
  .addcup-msg.error { color: var(--accent-warm); }
  .fromguide { padding: 14px 16px; margin-bottom: 8px; border-radius: 12px; background: rgba(168,124,79,.08); border: 1px solid rgba(168,124,79,.3); }
  .fromguide .fg-h { font-size: .78rem; font-weight: 700; color: var(--accent); margin-bottom: 8px; }
  .fromguide .fg-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 8px; }
  .fromguide .fg-chip { font-size: .78rem; padding: 4px 11px; border-radius: 20px; background: var(--surface); border: 1px solid var(--border); color: var(--text-dim); font-weight: 600; }
  .fromguide .fg-note { font-size: .8rem; color: var(--text-dim); line-height: 1.5; }
  .fromguide .fg-note b { color: var(--text); }
  @media (max-width: 600px) {
    .addcup-page { padding-top: 72px; }
    .row2 { grid-template-columns: 1fr; }
    .pour-block-head, .pour-row { grid-template-columns: 72px 1fr 1fr 28px; gap: 6px; }
    .pour-row--bloom { grid-template-columns: 72px 1fr 1fr; }
    .pour-flags { grid-column: 2 / 4; }
    .pour-lbl { font-size: .72rem; }
  }
</style>

<script>
  import { createClient } from '@supabase/supabase-js';
  import { wheelData } from '../data/wheel';
  import { DB, countryOrder } from '../data/countries';
  import { BEAN_VARIETIES } from '../data/varieties';
  import { applyRecipeToParams, decodePoursParam, normalizeRecipe, recipeHasData, parseGramsFromRatioText, type BrewPour } from '../lib/cupRecipe';
  import { normalizePour, pourHasData } from '../lib/brewPour';
  import { brewMethodForForm } from '../lib/brewMethodMap';
  import { bindVarietyOther, readVarietyValue, setVarietyValue } from '../lib/beanVarietyField';
  import {
    BEAN_COUNTRY_OTHER,
    bindCountryOther,
    countriesForSelect,
    readCountryValue,
    setCountryValue,
  } from '../lib/beanCountryField';
  import { tableHasColumn } from '../lib/supabaseSchema';
  import { bindBrewTimeInput, readBrewTimeInput, setBrewTimeInputValue } from '../lib/brewTime';
  import { TASTE_CHARACTER, TASTE_CHARACTER_DIMS } from '../data/tasteCharacter';
  import { normalizeTasteCharacter, tasteCharPresets, type TasteCharacter } from '../lib/tasteCharacter';
  import { fetchSavedBrewRecipes, upsertSavedBrewRecipe } from '../lib/savedBrewRecipeApi';
  import { countryNameForKey, resolveCountryKey } from '../lib/countryResolve';
  import { initNoteWheelPicker, syncNoteWheelSelection } from '../lib/flavorWheelPicker';
  import { PROCESS_OPTIONS } from '../data/processing';
  import { CHAMPION_PICKER_ITEMS } from '../data/championRecipePicker';
  import { defaultSavedRecipeName, savedRecipeSummary } from '../lib/savedRecipesUi';

  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
    { auth: { flowType: 'implicit' } }
  );

  const PROCESSES = PROCESS_OPTIONS;
  const BREWS = ['V60','Hario Switch','Kalita','Chemex','Aeropress','Френч-пресс','Гейзерная','Турка','Эспрессо','Капсулы','Cold Brew','Другое'];
  const SLIDERS = [['acidity','Кислотность'],['sweetness','Сладость'],['bitterness','Горечь'],['body','Тело']];

  const sel: any = {
    acidity: 3, sweetness: 3, bitterness: 2, body: 3,
    notes: new Set<string>(), noteCats: new Map<string, string>(),
    rating: 0, tasteChar: {} as TasteCharacter,
  };
  const params = new URLSearchParams(location.search);
  const editCupId = params.get('edit');
  const flightId = params.get('flight_id');
  const flightSlotRaw = params.get('flight_slot');
  let selectedTemplateId: string | null = params.get('template') || null;
  let savedRecipesCache: { id: string; name: string; brew_method?: string | null; recipe: unknown }[] = [];
  let recipesTableOk = false;
  const flagByName: Record<string,string> = {};
  for (const k of Object.keys(DB)) flagByName[(DB as any)[k].name] = (DB as any)[k].flag;

  const wheelByCat: Record<string, Set<string>> = {};
  const wheelCanonical = new Map<string, string>();
  (wheelData as any[]).forEach((f) => {
    wheelByCat[f.name] = new Set(f.subs.map((s: any) => s.name));
    f.subs.forEach((s: any) => wheelCanonical.set(s.name.toLowerCase(), s.name));
  });

  const escNote = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');

  function guessCountryFromName() {
    const selCountry = document.getElementById('f_country') as HTMLSelectElement;
    if (selCountry.value && selCountry.value !== BEAN_COUNTRY_OTHER) return;
    const custom = (document.getElementById('f_country_custom') as HTMLInputElement)?.value.trim();
    if (selCountry.value === BEAN_COUNTRY_OTHER && custom) return;
    const name = (document.getElementById('f_name') as HTMLInputElement).value.trim();
    if (!name) return;
    const key = resolveCountryKey(null, name);
    if (key) setCountryValue(countryNameForKey(key));
  }

  function fill(id:string, arr:readonly string[], ph:string){
    const s = document.getElementById(id) as HTMLSelectElement;
    s.innerHTML = `<option value="">${ph}</option>` + arr.map(x=>`<option>${x}</option>`).join('');
  }

  function setSelect(id: string, val: string) {
    if (!val) return;
    const s = document.getElementById(id) as HTMLSelectElement;
    const low = val.trim().toLowerCase();
    for (const o of Array.from(s.options)) {
      if (o.value.toLowerCase() === low || o.text.toLowerCase() === low) { s.value = o.value; return; }
    }
    for (const o of Array.from(s.options)) {
      if (o.text && (o.text.toLowerCase().startsWith(low) || low.startsWith(o.text.toLowerCase().split(' (')[0]))) { s.value = o.value; return; }
    }
  }

  /* Метод или обработка могли прийти из гида в другой формулировке, чем в списке.
     Без своего варианта поле осталось бы пустым и затёрлось при сохранении. */
  function setSelectKeepingValue(id: string, val: string | null | undefined) {
    const v = (val || '').trim();
    const s = document.getElementById(id) as HTMLSelectElement;
    if (!s) return;
    s.value = '';
    if (!v) return;
    setSelect(id, v);
    if (!s.value) {
      s.add(new Option(v, v));
      s.value = v;
    }
  }

  async function guard(){
    const { data:{ user } } = await supabase.auth.getUser();
    if(!user){ window.location.href = '/login'; return null; }
    return user;
  }

  function pourLabel(n: number) { return `${n}-й пролив`; }

  function flagPressed(btn: Element | null): boolean {
    return (btn as HTMLElement | null)?.getAttribute('aria-pressed') === 'true';
  }

  function setFlagPressed(btn: Element | null, on: boolean) {
    if (!btn) return;
    (btn as HTMLElement).setAttribute('aria-pressed', on ? 'true' : 'false');
  }

  function syncPourRowUi(row: HTMLElement) {
    const bypass = flagPressed(row.querySelector('.pour-bypass-flag'));
    const to = flagPressed(row.querySelector('.pour-to-flag'));
    row.classList.toggle('is-bypass', bypass);
    const mlInp = row.querySelector('.pour-ml-inp') as HTMLInputElement | null;
    if (mlInp) mlInp.placeholder = to ? 'до, мл' : 'мл';
  }

  function renumberPours() {
    let n = 0;
    document.querySelectorAll('#pourList .pour-row').forEach((row) => {
      const el = row as HTMLElement;
      const lbl = el.querySelector('.pour-lbl');
      if (!lbl) return;
      if (flagPressed(el.querySelector('.pour-bypass-flag'))) {
        lbl.innerHTML = `Байпас<span class="pour-lbl-sub">мимо кофе</span>`;
      } else {
        n += 1;
        lbl.textContent = pourLabel(n);
      }
      syncPourRowUi(el);
    });
  }

  function pourRowHtml() {
    return `<span class="pour-lbl">1-й пролив</span>
      <div class="pour-ml-wrap">
        <button type="button" class="pour-flag pour-to-flag" aria-pressed="false" title="Объём «до» — итоговый на весах">до</button>
        <input type="number" class="pour-inp pour-ml-inp" inputmode="decimal" min="0" step="1" placeholder="мл"/>
      </div>
      <input type="text" class="pour-inp brew-time-inp pour-time-inp" inputmode="numeric" placeholder="0:45"/>
      <button type="button" class="pour-rm" title="Убрать пролив">×</button>
      <div class="pour-flags">
        <button type="button" class="pour-flag pour-bypass-flag" aria-pressed="false" title="Вода мимо кофе — разбавление">байпас</button>
      </div>`;
  }

  function bindPourRow(row: HTMLElement) {
    bindBrewTimeInput(row.querySelector('.pour-time-inp') as HTMLInputElement);
    row.querySelector('.pour-rm')?.addEventListener('click', () => { row.remove(); renumberPours(); });
    row.querySelectorAll('.pour-flag').forEach((btn) => {
      btn.addEventListener('click', () => {
        const on = !flagPressed(btn);
        setFlagPressed(btn, on);
        renumberPours();
      });
    });
  }

  function readPourMl(inp: HTMLInputElement | null): number | null {
    if (!inp) return null;
    const v = inp.value.trim().replace(',', '.');
    if (!v) return null;
    const n = parseFloat(v);
    return Number.isFinite(n) && n > 0 ? n : null;
  }

  function readPourRow(row: Element): BrewPour | null {
    const ml = readPourMl(row.querySelector('.pour-ml-inp') as HTMLInputElement);
    const time = readBrewTimeInput(row.querySelector('.pour-time-inp') as HTMLInputElement);
    const to = flagPressed(row.querySelector('.pour-to-flag'));
    const bypass = flagPressed(row.querySelector('.pour-bypass-flag'));
    if (!ml && !time && !bypass) return null;
    const out: BrewPour = { ml, time };
    if (to) out.mlMode = 'to';
    if (bypass) out.role = 'bypass';
    return out;
  }

  function setPourRow(row: Element, p: BrewPour) {
    const mlInp = row.querySelector('.pour-ml-inp') as HTMLInputElement;
    const timeInp = row.querySelector('.pour-time-inp') as HTMLInputElement;
    if (mlInp) mlInp.value = p.ml != null && p.ml > 0 ? String(p.ml) : '';
    setBrewTimeInputValue(timeInp, p.time);
    setFlagPressed(row.querySelector('.pour-to-flag'), p.mlMode === 'to');
    setFlagPressed(row.querySelector('.pour-bypass-flag'), p.role === 'bypass');
    syncPourRowUi(row as HTMLElement);
  }

  function setBloomOnForm(bloom: BrewPour | null | undefined) {
    const mlInp = document.getElementById('p_bloom_ml') as HTMLInputElement | null;
    const timeInp = document.getElementById('p_bloom') as HTMLInputElement | null;
    if (!mlInp || !timeInp) return;
    if (!bloom) {
      mlInp.value = '';
      timeInp.value = '';
      return;
    }
    mlInp.value = bloom.ml != null && bloom.ml > 0 ? String(bloom.ml) : '';
    setBrewTimeInputValue(timeInp, bloom.time);
  }

  function collectBloom(): BrewPour | null {
    const ml = readPourMl(document.getElementById('p_bloom_ml') as HTMLInputElement);
    const time = readBrewTimeInput(document.getElementById('p_bloom') as HTMLInputElement);
    if (!ml && !time) return null;
    return { ml, time };
  }

  function appendPourRow(pour?: BrewPour) {
    const list = document.getElementById('pourList')!;
    const row = document.createElement('div');
    row.className = 'pour-row';
    row.innerHTML = pourRowHtml();
    bindPourRow(row);
    if (pour) setPourRow(row, pour);
    list.appendChild(row);
    renumberPours();
  }

  function setPourRows(pours: BrewPour[]) {
    const list = document.getElementById('pourList')!;
    list.innerHTML = '';
    const count = Math.max(pours.length, 1);
    for (let i = 0; i < count; i++) appendPourRow(pours[i]);
    renumberPours();
  }

  function initPours() {
    setPourRows([]);
    document.getElementById('addPourBtn')!.addEventListener('click', () => appendPourRow());
    document.getElementById('addBypassBtn')!.addEventListener('click', () => appendPourRow({ role: 'bypass' }));
  }

  function collectPours(): BrewPour[] {
    return [...document.querySelectorAll('#pourList .pour-row')]
      .map(readPourRow)
      .filter((p): p is BrewPour => pourHasData(p));
  }

  function setGrinderValue(name: string | null | undefined) {
    const sel = document.getElementById('r_grinder') as HTMLSelectElement;
    if (!sel) return;
    const v = name?.trim() || '';
    if (v && ![...sel.options].some((o) => o.value === v)) {
      sel.add(new Option(v, v));
    }
    sel.value = v;
  }

  async function loadGrinders(userId: string) {
    const { data } = await supabase
      .from('shelf_items')
      .select('name')
      .eq('user_id', userId)
      .eq('kind', 'equipment')
      .eq('category', 'Кофемолка')
      .order('created_at', { ascending: false });
    const sel = document.getElementById('r_grinder') as HTMLSelectElement;
    const current = sel.value;
    sel.innerHTML = '<option value="">— молка с полки —</option>' + (data || []).map((g) =>
      `<option value="${escNote(g.name)}">${escNote(g.name)}</option>`
    ).join('');
    setGrinderValue(current);
    const hint = document.getElementById('grinderHint') as HTMLElement;
    if (hint) hint.style.display = data?.length ? 'none' : 'block';
  }

  type ShelfBean = {
    id: string;
    name: string;
    roaster: string | null;
    country: string | null;
    process: string | null;
    variety: string | null;
  };
  let shelfBeans: ShelfBean[] = [];
  let shelfChoiceTouched = false;

  const beanKey = (name: string) => name.trim().toLowerCase().replace(/\s+/g, ' ');

  function escShelfOpt(s: string) {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');
  }

  function matchShelfBean(): ShelfBean | null {
    const name = (document.getElementById('f_name') as HTMLInputElement).value.trim();
    if (!name) return null;
    return shelfBeans.find((b) => beanKey(b.name) === beanKey(name)) || null;
  }

  function updateShelfAddState() {
    const row = document.getElementById('shelfAddRow') as HTMLElement | null;
    const box = document.getElementById('f_to_shelf') as HTMLInputElement | null;
    const hint = document.getElementById('shelfAddHint') as HTMLElement | null;
    if (!row || !box || !hint) return;
    if (editCupId) { row.style.display = 'none'; box.checked = false; return; }
    const existing = matchShelfBean();
    if (existing) {
      row.classList.add('is-on-shelf');
      box.checked = false;
      box.disabled = true;
      hint.textContent = `«${existing.name}» уже на полке — добавлять второй раз не нужно.`;
    } else {
      row.classList.remove('is-on-shelf');
      box.disabled = false;
      if (!shelfChoiceTouched) box.checked = true;
      hint.textContent = 'Полка помнит зерно между чашками — заваришь его снова в один клик, не заполняя поля заново.';
    }
  }

  function syncShelfPickerFromName() {
    const sel = document.getElementById('f_shelf_bean') as HTMLSelectElement | null;
    if (!sel || editCupId) return;
    const match = matchShelfBean();
    sel.value = match ? match.id : '';
    if (match) applyShelfBeanFromPicker();
  }

  function populateShelfBeanSelect() {
    const wrap = document.getElementById('shelfBeanPicker') as HTMLElement | null;
    const sel = document.getElementById('f_shelf_bean') as HTMLSelectElement | null;
    if (!wrap || !sel) return;
    if (editCupId || !shelfBeans.length) {
      wrap.style.display = 'none';
      return;
    }
    sel.innerHTML = `<option value="">— выбрать зерно с полки —</option>` +
      shelfBeans.map((b) => {
        const label = b.roaster ? `${b.name} · ${b.roaster}` : b.name;
        return `<option value="${escShelfOpt(b.id)}">${escShelfOpt(label)}</option>`;
      }).join('');
    wrap.style.display = '';
    syncShelfPickerFromName();
  }

  function applyShelfBeanFromPicker() {
    const sel = document.getElementById('f_shelf_bean') as HTMLSelectElement | null;
    if (!sel) return;
    const id = sel.value;
    if (!id) {
      updateShelfAddState();
      return;
    }
    const bean = shelfBeans.find((b) => b.id === id);
    if (!bean) return;
    (document.getElementById('f_name') as HTMLInputElement).value = bean.name || '';
    (document.getElementById('f_roaster') as HTMLInputElement).value = bean.roaster || '';
    setVarietyValue(bean.variety);
    setCountryValue(bean.country);
    setSelectKeepingValue('f_process', bean.process);
    updateShelfAddState();
  }

  async function loadShelfBeans(userId: string) {
    const { data } = await supabase
      .from('shelf_items')
      .select('id, name, roaster, country, process, variety')
      .eq('user_id', userId)
      .eq('kind', 'bean')
      .order('name', { ascending: true });
    shelfBeans = (data as ShelfBean[]) || [];
    populateShelfBeanSelect();
    updateShelfAddState();
  }

  function bindShelfAdd() {
    document.getElementById('f_name')!.addEventListener('input', updateShelfAddState);
    document.getElementById('f_to_shelf')!.addEventListener('change', () => { shelfChoiceTouched = true; });
    document.getElementById('f_shelf_bean')?.addEventListener('change', applyShelfBeanFromPicker);
    updateShelfAddState();
  }

  async function addBeanToShelf(userId: string, payload: any) {
    const { error } = await supabase.from('shelf_items').insert({
      user_id: userId,
      kind: 'bean',
      name: payload.name,
      roaster: payload.roaster,
      country: payload.country,
      process: payload.process,
      variety: payload.variety,
      source: 'manual',
    });
    if (error) console.warn('shelf insert failed:', error.message);
  }

  function clearRecipeForm() {
    (document.getElementById('r_coffee_g') as HTMLInputElement).value = '';
    (document.getElementById('r_water_g') as HTMLInputElement).value = '';
    (document.getElementById('r_grind') as HTMLInputElement).value = '';
    setGrinderValue(null);
    (document.getElementById('r_temp') as HTMLInputElement).value = '';
    setBrewTimeInputValue(document.getElementById('r_time') as HTMLInputElement, null);
    setBloomOnForm(null);
    setPourRows([]);
    const hint = document.getElementById('recipeHint') as HTMLElement | null;
    if (hint) hint.style.display = 'none';
  }

  function applyRecipeToForm(recipeRaw: unknown, brewMethod?: string | null) {
    if (brewMethod) setSelect('f_brew', brewMethodForForm(brewMethod));
    updateChampToggleLabel();
    const r = normalizeRecipe(recipeRaw);
    if (!r) {
      clearRecipeForm();
      return;
    }
    (document.getElementById('r_coffee_g') as HTMLInputElement).value = r.coffee_g ? String(r.coffee_g) : '';
    (document.getElementById('r_water_g') as HTMLInputElement).value = r.water_g ? String(r.water_g) : '';
    (document.getElementById('r_grind') as HTMLInputElement).value = r.grind || '';
    setGrinderValue(r.grinder);
    (document.getElementById('r_temp') as HTMLInputElement).value = r.temp || '';
    setBrewTimeInputValue(document.getElementById('r_time') as HTMLInputElement, r.time);
    setBloomOnForm(r.blooming ?? null);
    setPourRows(r.pours ?? []);
    (document.getElementById('recipeHint') as HTMLElement).style.display = 'block';
  }

  function syncMyRecipeSelection() {
    document.querySelectorAll('.my-recipe-card').forEach((el) => {
      el.classList.toggle('on', (el as HTMLElement).dataset.id === selectedTemplateId);
    });
  }

  function selectMyRecipe(id: string | null) {
    selectedTemplateId = id;
    syncMyRecipeSelection();
    if (!id) clearRecipeForm();
  }

  function updateMyRecipesSummaryLabel() {
    const label = document.getElementById('myRecipesSummaryLabel');
    if (!label) return;
    if (!recipesTableOk) {
      label.textContent = '📋 Мои рецепты — нужна миграция';
      return;
    }
    label.textContent = savedRecipesCache.length
      ? `📋 Мои рецепты (${savedRecipesCache.length})`
      : '📋 Мои рецепты — пока пусто';
  }

  function renderMyRecipesPanel() {
    const panel = document.getElementById('myRecipesPanel')!;
    updateMyRecipesSummaryLabel();
    if (!recipesTableOk) {
      panel.innerHTML = '<div class="my-recipes-empty">Мои рецепты недоступны — выполни supabase/FIX-RUN-NOW.sql в Supabase SQL Editor.</div>';
      return;
    }
    if (!savedRecipesCache.length) {
      panel.innerHTML = '<div class="my-recipes-empty">Пока пусто. Заполни рецепт ниже и нажми «Сохранить в мои рецепты» — потом выбирай одним кликом.</div>';
      return;
    }
    panel.innerHTML = savedRecipesCache.map((t) =>
      `<button type="button" class="my-recipe-card${t.id === selectedTemplateId ? ' on' : ''}" data-id="${escNote(t.id)}">
        <div class="my-recipe-card-h">${escNote(t.name)}${t.brew_method ? ` · ${escNote(t.brew_method)}` : ''}</div>
        <div class="my-recipe-card-sub">${escNote(savedRecipeSummary(t))}</div>
      </button>`
    ).join('');
    panel.querySelectorAll('.my-recipe-card').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = (btn as HTMLElement).dataset.id!;
        const t = savedRecipesCache.find((x) => x.id === id);
        if (!t) return;
        if (selectedTemplateId === id) {
          selectMyRecipe(null);
          return;
        }
        selectMyRecipe(id);
        applyRecipeToForm(t.recipe, t.brew_method);
      });
    });
  }

  function getChampItemsForBrew() {
    const brew = (document.getElementById('f_brew') as HTMLSelectElement)?.value || '';
    if (!brew) return CHAMPION_PICKER_ITEMS;
    return CHAMPION_PICKER_ITEMS.filter((item) => item.brewMethod === brew);
  }

  function updateChampToggleLabel() {
    const label = document.querySelector('.champ-recipes-toggle-label');
    const brew = (document.getElementById('f_brew') as HTMLSelectElement)?.value || '';
    const count = getChampItemsForBrew().length;
    if (!label) return;
    label.textContent = brew
      ? `🏆 Чемпионские · ${brew} (${count})`
      : `🏆 Чемпионские рецепты (${count})`;
  }

  function closeChampRecipes() {
    const d = document.getElementById('champRecipesDetails') as HTMLDetailsElement | null;
    if (d) d.open = false;
  }

  function renderChampRecipesPanel() {
    const panel = document.getElementById('champRecipesPanel')!;
    const items = getChampItemsForBrew();
    if (!items.length) {
      panel.innerHTML = `<p class="champ-recipes-empty">Для этого способа пока нет готовых схем — выбери другой метод или открой <a href="/blog/chempionskie-recepty">банк рецептов</a>.</p>`;
      return;
    }
    panel.innerHTML = items.map((item) =>
      `<button type="button" class="champ-pick-card" data-champ-id="${escNote(item.id)}">
        <div class="champ-pick-badge">${escNote(item.methodIcon)} ${escNote(item.badgeText)} · ${escNote(item.methodName)}</div>
        <div class="champ-pick-title">${escNote(item.title)}</div>
      </button>`
    ).join('');
    panel.querySelectorAll('.champ-pick-card').forEach((btn) => {
      btn.addEventListener('click', () => {
        const item = items.find((x) => x.id === (btn as HTMLElement).dataset.champId);
        if (!item) return;
        selectMyRecipe(null);
        applyRecipeToForm(item.recipe, item.brewMethod);
        closeChampRecipes();
      });
    });
  }

  async function loadSavedRecipes() {
    const { data: { user } } = await supabase.auth.getUser();
    if (!user) return;
    const result = await fetchSavedBrewRecipes(supabase);
    recipesTableOk = result.error !== 'migration_required';
    if (!result.ok) {
      renderMyRecipesPanel();
      return;
    }
    savedRecipesCache = result.recipes;
    renderMyRecipesPanel();
    if (!editCupId && selectedTemplateId && savedRecipesCache.some((t) => t.id === selectedTemplateId)) {
      const t = savedRecipesCache.find((x) => x.id === selectedTemplateId);
      if (t) applyRecipeToForm(t.recipe, t.brew_method);
    }
  }

  function rv(id: string) {
    return (document.getElementById(id) as HTMLInputElement).value.trim();
  }

  function rn(id: string) {
    const v = rv(id);
    if (!v) return null;
    const n = parseFloat(v.replace(',', '.'));
    return Number.isFinite(n) && n > 0 ? n : null;
  }

  function collectRecipeFromForm() {
    const recipe: Record<string, unknown> = {
      coffee_g: rn('r_coffee_g'),
      water_g: rn('r_water_g'),
      grind: rv('r_grind') || null,
      grinder: (document.getElementById('r_grinder') as HTMLSelectElement).value.trim() || null,
      temp: rv('r_temp') || null,
      time: readBrewTimeInput(document.getElementById('r_time') as HTMLInputElement),
    };
    const bloom = collectBloom();
    if (bloom) recipe.blooming = bloom;
    const pours = collectPours();
    if (pours.length) recipe.pours = pours;
    return recipe;
  }

  async function saveBaseRecipeFromForm() {
    const recipe = collectRecipeFromForm();
    if (!recipeHasData(recipe)) {
      alert('Сначала заполните рецепт — граммы, проливы или параметры');
      return;
    }
    if (!recipesTableOk) {
      alert('Таблица «мои рецепты» ещё не создана. Выполни supabase/FIX-RUN-NOW.sql в Supabase SQL Editor.');
      return;
    }
    const brew = (document.getElementById('f_brew') as HTMLSelectElement).value;
    const defaultName = defaultSavedRecipeName(brew, recipe as Record<string, unknown>);
    const selected = selectedTemplateId ? savedRecipesCache.find((r) => r.id === selectedTemplateId) : null;
    const nameDefault = selected?.name || defaultName;
    const name = prompt('Название рецепта', nameDefault);
    if (!name?.trim()) return;
    const user = await guard();
    if (!user) return;
    const msg = document.getElementById('msg')!;
    const payload = {
      name: name.trim(),
      brew_method: brew || null,
      recipe,
    };

    const doUpdate = selectedTemplateId && selected && confirm(`Обновить рецепт «${selected.name}»? (Отмена — сохранить как новый)`);
    const apiResult = await upsertSavedBrewRecipe(supabase, payload, doUpdate ? selectedTemplateId : null);
    if (!apiResult.ok) {
      msg.className = 'addcup-msg error';
      msg.textContent = apiResult.error?.includes('saved_brew_recipes') || apiResult.error?.includes('FIX-RUN-NOW')
        ? 'Нужна миграция: supabase/FIX-RUN-NOW.sql в Supabase'
        : 'Ошибка: ' + (apiResult.error || 'не удалось сохранить');
      return;
    }
    if (doUpdate) {
      msg.className = 'addcup-msg';
      msg.textContent = 'Рецепт обновлён';
    } else {
      selectMyRecipe(apiResult.id!);
      msg.className = 'addcup-msg';
      msg.textContent = 'Сохранено в «Мои рецепты»';
      const myDetails = document.getElementById('myRecipesDetails') as HTMLDetailsElement | null;
      if (myDetails) myDetails.open = true;
    }
    await loadSavedRecipes();
  }

  function bindRecipeActions() {
    document.getElementById('saveBaseRecipeBtn')!.addEventListener('click', saveBaseRecipeFromForm);
    const champDetails = document.getElementById('champRecipesDetails') as HTMLDetailsElement;
    champDetails.addEventListener('toggle', () => {
      if (champDetails.open) renderChampRecipesPanel();
    });
    updateChampToggleLabel();
    document.getElementById('f_brew')!.addEventListener('change', () => {
      updateChampToggleLabel();
      if (champDetails.open) renderChampRecipesPanel();
    });
  }

  function setEditModeUI() {
    const h1 = document.querySelector('.addcup-page h1');
    const sub = document.querySelector('.addcup-sub');
    const btn = document.getElementById('saveBtn') as HTMLButtonElement;
    if (h1) h1.textContent = 'Редактировать чашку';
    if (sub) sub.textContent = 'Довнеси ноты, поправь баланс или рецепт — карточка обновится.';
    if (btn) btn.textContent = 'Сохранить изменения';
  }

  function prefillFromCup(cup: any) {
    (document.getElementById('f_name') as HTMLInputElement).value = cup.name || '';
    (document.getElementById('f_roaster') as HTMLInputElement).value = cup.roaster || '';
    setVarietyValue(cup.variety);
    setCountryValue(cup.country);
    setSelectKeepingValue('f_process', cup.process);
    setSelectKeepingValue('f_brew', cup.brew_method);
    sel.acidity = cup.acidity ?? 3;
    sel.sweetness = cup.sweetness ?? 3;
    sel.bitterness = cup.bitterness ?? 2;
    sel.body = cup.body ?? 3;
    SLIDERS.forEach(([k]) => {
      const inp = document.querySelector(`#tasteSection input[data-k="${k}"]`) as HTMLInputElement;
      const lbl = document.getElementById('v_' + k);
      if (inp) inp.value = String(sel[k]);
      if (lbl) lbl.textContent = String(sel[k]);
    });
    sel.rating = cup.rating || 0;
    setTasteCharacterUI(normalizeTasteCharacter(cup.taste_character));
    document.querySelectorAll('#rating .star').forEach((s2) => {
      s2.classList.toggle('on', +(s2 as HTMLElement).dataset.i! <= sel.rating);
    });
    sel.notes.clear();
    sel.noteCats.clear();
    const notes = Array.isArray(cup.notes) ? cup.notes : cup.notes ? [String(cup.notes)] : [];
    notes.forEach((n: string) => sel.notes.add(n));
    refreshNotesUI();
    (document.getElementById('f_comment') as HTMLTextAreaElement).value = cup.comment || '';
    selectedTemplateId = cup.brew_recipe_id || null;
    applyRecipeToForm(cup.recipe, cup.brew_method);
    syncMyRecipeSelection();
    renderMyRecipesPanel();
  }

  async function fetchCupForEdit(userId: string) {
    if (!editCupId) return null;
    const { data, error } = await supabase
      .from('cups')
      .select('*')
      .eq('id', editCupId)
      .eq('user_id', userId)
      .maybeSingle();
    if (error || !data) return 'notfound';
    return data;
  }

  /* Пока чашка не подгрузилась, форма выглядит как пустая форма добавления.
     Блокируем её целиком: иначе набранное до префилла молча затрётся чашкой. */
  function beginEditMode() {
    setEditModeUI();
    const card = document.getElementById('formCard');
    if (card) card.setAttribute('inert', '');
    const btn = document.getElementById('saveBtn') as HTMLButtonElement;
    if (btn) { btn.disabled = true; btn.textContent = 'Загружаем чашку…'; }
  }

  function finishEditMode(cup: any) {
    const btn = document.getElementById('saveBtn') as HTMLButtonElement;
    if (cup === 'notfound' || !cup) {
      alert('Чашка не найдена');
      window.location.href = '/account';
      return;
    }
    prefillFromCup(cup);
    document.getElementById('formCard')?.removeAttribute('inert');
    if (btn) { btn.disabled = false; btn.textContent = 'Сохранить изменения'; }
  }

  function addNote(n: string, cat?: string) {
    const note = n.trim();
    if (!note) return;
    const canonical = wheelCanonical.get(note.toLowerCase()) || note;
    sel.notes.add(canonical);
    const inWheel = Object.values(wheelByCat).some((set) => set.has(canonical));
    if (inWheel) sel.noteCats.delete(canonical);
    else if (cat) sel.noteCats.set(canonical, cat);
    refreshNotesUI();
  }

  function removeNote(n: string) {
    sel.notes.delete(n);
    sel.noteCats.delete(n);
    refreshNotesUI();
  }

  function toggleNote(n: string, cat?: string) {
    if (sel.notes.has(n)) removeNote(n);
    else addNote(n, cat);
  }

  function renderSelectedNotes() {
    const el = document.getElementById('selectedNotes')!;
    if (!sel.notes.size) {
      el.innerHTML = '<span class="note-empty">Пока пусто — нажми на колесе или выбери подсказку ниже</span>';
      return;
    }
    el.innerHTML = [...sel.notes].map((n) =>
      `<span class="note-tag">${escNote(n)}<button type="button" class="note-tag-rm" data-n="${encodeURIComponent(n)}" aria-label="Убрать">×</button></span>`
    ).join('');
    el.querySelectorAll('.note-tag-rm').forEach((btn) => {
      btn.addEventListener('click', () => removeNote(decodeURIComponent((btn as HTMLElement).dataset.n!)));
    });
  }

  function refreshNotesUI() {
    renderSelectedNotes();
    syncNoteWheelSelection('noteWheelSvg', (n) => sel.notes.has(n));
    document.querySelectorAll('#noteWheelPanel .note-wheel-chip').forEach((ch) => {
      const n = (ch as HTMLElement).dataset.note!;
      ch.classList.toggle('on', sel.notes.has(n));
    });
  }

  function syncTasteCharChips() {
    TASTE_CHARACTER_DIMS.forEach((dim) => {
      const active = tasteCharPresets(sel.tasteChar[dim]);
      document.querySelectorAll(`.char-chip[data-dim="${dim}"]`).forEach((ch) => {
        ch.classList.toggle('on', active.includes((ch as HTMLElement).dataset.id!));
      });
    });
  }

  function setTasteCharacterUI(tc: TasteCharacter | null) {
    sel.tasteChar = tc ? { ...tc } : {};
    syncTasteCharChips();
  }

  function readTasteCharacterFromForm(): TasteCharacter | null {
    const out: TasteCharacter = {};
    TASTE_CHARACTER_DIMS.forEach((dim) => {
      const presets = tasteCharPresets(sel.tasteChar[dim]);
      if (presets.length) out[dim] = { presets, custom: null };
    });
    return Object.keys(out).length ? out : null;
  }

  function buildTasteSection() {
    const box = document.getElementById('tasteSection')!;
    const charDimsHtml = TASTE_CHARACTER_DIMS.map((dim, i) => {
      const cfg = TASTE_CHARACTER[dim];
      const chips = cfg.options.map((o) => {
        const skip = o.id === 'none' ? ' char-chip--skip' : '';
        const title = o.id === 'none' ? '' : ` title="${escNote(o.desc)}"`;
        return `<button type="button" class="char-chip${skip}" data-dim="${dim}" data-id="${escNote(o.id)}"${title}>${escNote(o.label)}</button>`;
      }).join('');
      const sep = i > 0 ? '<div class="taste-sep"></div>' : '';
      return `${sep}<section class="taste-row" data-dim-block="${dim}">
        <div class="taste-row-head"><span class="taste-row-label">${escNote(cfg.label)}</span><span class="taste-row-val" id="v_${dim}">${sel[dim]}</span></div>
        <input type="range" min="0" max="5" value="${sel[dim]}" data-k="${dim}" aria-label="${escNote(cfg.label)}">
        <p class="taste-row-hint">${escNote(cfg.hint)}</p>
        <div class="taste-chips">${chips}</div>
      </section>`;
    }).join('');

    box.innerHTML = charDimsHtml + `
      <div class="taste-sep"></div>
      <section class="taste-row taste-row--body">
        <div class="taste-row-head"><span class="taste-row-label">Тело</span><span class="taste-row-val" id="v_body">${sel.body}</span></div>
        <input type="range" min="0" max="5" value="${sel.body}" data-k="body" aria-label="Тело">
      </section>`;

    box.querySelectorAll('input[type=range]').forEach((inp) => {
      inp.addEventListener('input', (e: Event) => {
        const k = (e.target as HTMLInputElement).dataset.k!;
        sel[k] = +(e.target as HTMLInputElement).value;
        document.getElementById('v_' + k)!.textContent = String(sel[k]);
      });
    });

    box.addEventListener('click', (e) => {
      const chip = (e.target as HTMLElement).closest('.char-chip') as HTMLElement | null;
      if (!chip) return;
      e.preventDefault();
      const dim = chip.dataset.dim as keyof TasteCharacter;
      const id = chip.dataset.id!;
      if (id === 'none') {
        delete sel.tasteChar[dim];
      } else {
        const active = tasteCharPresets(sel.tasteChar[dim]);
        const next = active.includes(id) ? active.filter((x) => x !== id) : [...active, id];
        if (next.length) sel.tasteChar[dim] = { presets: next, custom: null };
        else delete sel.tasteChar[dim];
      }
      syncTasteCharChips();
    });
  }

  function buildNotes() {
    initNoteWheelPicker(wheelData as any[], {
      svgId: 'noteWheelSvg',
      panelId: 'noteWheelPanel',
      isSelected: (n) => sel.notes.has(n),
      onToggle: (n, cat) => toggleNote(n, cat),
      onCustomAdd: (n, cat) => addNote(n, cat),
      escHtml: escNote,
    });
    refreshNotesUI();
  }

  function prefillNotesFromParam(raw: string) {
    if (!raw) return;
    raw.split(',').map((s) => s.trim()).filter(Boolean).forEach((note) => {
      const low = note.toLowerCase();
      let canonical = wheelCanonical.get(low);
      if (!canonical) {
        for (const [k, v] of wheelCanonical.entries()) {
          if (low === k || low.includes(k) || k.includes(low)) { canonical = v; break; }
        }
      }
      addNote(canonical || note);
    });
  }

  function maybeOpenRecipePickerFromParams() {
    const g = (k: string) => params.get(k) || '';
    const hasRecipe = Boolean(
      g('coffee_g') || g('water_g') || g('ratio') || g('grind') || g('temp') || g('time')
      || g('pours') || g('pour1') || g('template'),
    );
    if (hasRecipe) {
      const picker = document.getElementById('recipePicker') as HTMLDetailsElement | null;
      if (picker) picker.open = true;
    }
  }

  function prefill(){
    const g = (k: string) => params.get(k) || '';
    (document.getElementById('f_name') as HTMLInputElement).value = g('name');
    (document.getElementById('f_roaster') as HTMLInputElement).value = g('roaster');
    setVarietyValue(g('variety'));
    if (g('country')) setCountryValue(g('country'));
    setSelect('f_process', g('process'));
    setSelect('f_brew', g('brew'));
    (document.getElementById('r_coffee_g') as HTMLInputElement).value = g('coffee_g');
    (document.getElementById('r_water_g') as HTMLInputElement).value = g('water_g');
    if (!g('coffee_g') && !g('water_g') && g('ratio')) {
      const parsed = parseGramsFromRatioText(g('ratio'));
      if (parsed.coffee_g) (document.getElementById('r_coffee_g') as HTMLInputElement).value = String(parsed.coffee_g);
      if (parsed.water_g) (document.getElementById('r_water_g') as HTMLInputElement).value = String(parsed.water_g);
    }
    (document.getElementById('r_grind') as HTMLInputElement).value = g('grind');
    setGrinderValue(g('grinder') || null);
    (document.getElementById('r_temp') as HTMLInputElement).value = g('temp');
    setBrewTimeInputValue(document.getElementById('r_time') as HTMLInputElement, g('time'));
    const bloomMl = g('blooming_ml');
    const bloomTime = g('blooming');
    if (bloomMl || bloomTime) {
      setBloomOnForm({
        ml: bloomMl ? parseFloat(bloomMl.replace(',', '.')) : null,
        time: bloomTime || null,
      });
    }
    if (g('pours')) {
      setPourRows(decodePoursParam(g('pours')));
    } else {
      const legacyPours = [g('pour1'), g('pour2'), g('pour3')]
        .map((s) => s.trim())
        .filter(Boolean)
        .map((token) => normalizePour(token))
        .filter((p): p is BrewPour => pourHasData(p));
      if (legacyPours.length) setPourRows(legacyPours);
    }
    const hasPours = Boolean(g('pours') || g('pour1') || g('pour2') || g('pour3'));
    if (g('coffee_g') || g('water_g') || g('ratio') || g('grind') || g('temp') || g('time') || bloomMl || bloomTime || hasPours) {
      (document.getElementById('recipeHint') as HTMLElement).style.display = 'block';
    }
    if (g('notes')) prefillNotesFromParam(g('notes'));
    maybeOpenRecipePickerFromParams();
    if (g('from_shelf') === '1') {
      const el = document.getElementById('fromGuide')!;
      el.innerHTML = `<div class="fg-h">🫘 Зерно на полке</div><div class="fg-note">Когда заваришь — сохрани чашку. Она попадёт в <a href="/account?tab=diary" style="color:var(--accent);font-weight:600">дневник</a> и откроет страну в профиле.</div>`;
      el.style.display = 'block';
    }
    if (g('from_flight') === '1') {
      const focus = g('focus');
      const el = document.getElementById('fromGuide')!;
      el.innerHTML = `<div class="fg-h">🔬 Чашка для сравнения</div><div class="fg-note">Заваривай по пресету — так различия будут во вкусе, а не в параметрах.${focus ? ` На что смотреть: <b>${focus.replace(/</g, '&lt;')}</b>.` : ''}</div>`;
      el.style.display = 'block';
    }
    if (g('from') === 'guide') {
      const country = g('country'), variety = g('variety'), process = g('process'), brew = g('brew'), focus = g('focus'), notes = g('notes');
      const chips: string[] = [];
      if (country) chips.push(`${flagByName[country] || '🌍'} ${country}`);
      if (variety) chips.push(`🌱 ${variety}`);
      if (process) chips.push(`⚗️ ${process}`);
      if (brew) chips.push(`☕ ${brew}`);
      const el = document.getElementById('fromGuide')!;
      el.innerHTML = `<div class="fg-h">📔 Из твоего гида дегустации</div>${chips.length ? `<div class="fg-chips">${chips.map(c=>`<span class="fg-chip">${c}</span>`).join('')}</div>` : ''}${notes ? `<div class="fg-note">Ожидались ноты: <b>${notes.split(',').map(s=>s.trim()).filter(Boolean).join(', ')}</b>. Сравни с тем, что почувствуешь.</div>` : ''}${focus ? `<div class="fg-note" style="margin-top:6px">На что обратить внимание: <b>${focus}</b></div>` : ''}`;
      el.style.display = 'block';
    }
  }

  function build(){
    fill('f_variety', BEAN_VARIETIES, '— не знаю / смесь');
    bindVarietyOther();
    fill('f_country', countriesForSelect(), 'выберите страну');
    bindCountryOther();
    fill('f_process', PROCESSES, 'выберите обработку');
    fill('f_brew', BREWS, 'выберите метод');
    initPours();
    bindBrewTimeInput(document.getElementById('p_bloom') as HTMLInputElement);
    bindBrewTimeInput(document.getElementById('r_time') as HTMLInputElement);
    buildTasteSection();
    buildNotes();
    document.getElementById('f_name')!.addEventListener('blur', guessCountryFromName);
    document.getElementById('rating')!.innerHTML = [1,2,3,4,5].map(i=>`<span class="star" data-i="${i}">★</span>`).join('');
    document.querySelectorAll('#rating .star').forEach(st=>{
      st.addEventListener('click', ()=>{ sel.rating=+(st as HTMLElement).dataset.i!; document.querySelectorAll('#rating .star').forEach(s2=>{ s2.classList.toggle('on', +(s2 as HTMLElement).dataset.i! <= sel.rating); }); });
    });
    if (!editCupId) prefill();
  }

  async function save(){
    const user = await guard();
    if(!user) return;
    const name = (document.getElementById('f_name') as HTMLInputElement).value.trim();
    const msg = document.getElementById('msg')!;
    if(!name){ msg.className='addcup-msg error'; msg.textContent='Добавьте название кофе'; return; }
    guessCountryFromName();
    const btn = document.getElementById('saveBtn') as HTMLButtonElement;
    btn.disabled = true; btn.textContent = 'Сохраняем...';
    const recipe: any = collectRecipeFromForm();
    const hasRecipe = recipeHasData(recipe);
    const payload:any = {
      name,
      roaster: (document.getElementById('f_roaster') as HTMLInputElement).value.trim() || null,
      variety: readVarietyValue(),
      country: readCountryValue(),
      process: (document.getElementById('f_process') as HTMLSelectElement).value || null,
      brew_method: (document.getElementById('f_brew') as HTMLSelectElement).value || null,
      recipe: hasRecipe ? recipe : null,
      acidity: sel.acidity, sweetness: sel.sweetness, bitterness: sel.bitterness, body: sel.body,
      notes: [...sel.notes],
      rating: sel.rating || null,
      comment: (document.getElementById('f_comment') as HTMLTextAreaElement).value.trim() || null,
    };
    if (await tableHasColumn(supabase, 'cups', 'brew_recipe_id')) {
      payload.brew_recipe_id = selectedTemplateId || null;
    }
    if (await tableHasColumn(supabase, 'cups', 'taste_character')) {
      payload.taste_character = readTasteCharacterFromForm();
    }
    if (flightId && await tableHasColumn(supabase, 'cups', 'flight_id')) {
      payload.flight_id = flightId;
      payload.flight_slot = flightSlotRaw != null && flightSlotRaw !== '' ? parseInt(flightSlotRaw, 10) : null;
    }
    if (editCupId) {
      /* select() обязателен: без него update по чужой или отфильтрованной строке
         возвращает 204 без ошибки, и правка теряется молча. */
      const { data: updated, error } = await supabase
        .from('cups').update(payload).eq('id', editCupId).eq('user_id', user.id).select('id');
      if (error || !updated?.length) {
        msg.className = 'addcup-msg error';
        msg.textContent = error
          ? 'Ошибка: ' + error.message
          : 'Изменения не сохранились — обнови страницу и попробуй ещё раз';
        btn.disabled = false; btn.textContent = 'Сохранить изменения';
        return;
      }
      window.location.href = `/cup?id=${editCupId}`;
      return;
    }
    payload.user_id = user.id;
    const { data, error } = await supabase.from('cups').insert(payload).select('id').single();
    if(error){ msg.className='addcup-msg error'; msg.textContent='Ошибка: '+error.message; btn.disabled=false; btn.textContent='Сохранить чашку'; return; }
    const toShelf = document.getElementById('f_to_shelf') as HTMLInputElement | null;
    if (toShelf && toShelf.checked && !toShelf.disabled) await addBeanToShelf(user.id, payload);
    if (flightId) {
      window.location.href = '/account?tab=flights';
      return;
    }
    const country = readCountryValue();
    let href = `/cup?id=${data.id}&new=1`;
    if (country) href += `&opened_country=${encodeURIComponent(country)}`;
    window.location.href = href;
  }

  (async ()=>{
    try {
      const user = await guard();
      if (user) {
        build();
        bindRecipeActions();
        bindShelfAdd();
        if (editCupId) beginEditMode();
        document.getElementById('saveBtn')!.addEventListener('click', save);
        /* Префилл не ждёт молки, полку и рецепты: чашка приходит первой,
           а форма разблокируется сразу, как только заполнена. */
        const cupReady = editCupId
          ? fetchCupForEdit(user.id).then((cup) => finishEditMode(cup))
          : Promise.resolve();
        await Promise.all([
          loadGrinders(user.id),
          loadSavedRecipes(),
          loadShelfBeans(user.id),
          cupReady,
        ]);
      }
    } catch (e) {
      console.error(e);
      const msg = document.getElementById('msg');
      if (msg) {
        msg.className = 'addcup-msg error';
        msg.textContent = 'Не удалось загрузить форму. Обнови страницу или напиши @ksenijashmel.';
      }
    }
  })();
</script>

</Layout>
