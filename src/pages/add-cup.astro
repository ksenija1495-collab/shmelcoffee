---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import { wheelData } from '../data/wheel';
import { DB, countryOrder } from '../data/countries';
---

<Layout title="Добавить кофе — Shmelco" description="Запишите кофе, который пьёте дома или заказали сами">
  <Nav />
  <div class="container">
    <div class="addcup-page">
      <a href="/account" class="addcup-back">← В кабинет</a>
      <h1>Добавить своё кофе</h1>
      <p class="addcup-sub">Кофе из дома или заказанный вне подборок. Запись наполнит вашу Карту вкуса и откроет страны.</p>
      <div class="addcup-card" id="formCard">
        <div id="fromGuide" class="fromguide" style="display:none"></div>
        <label class="fl">Кофе / зерно *</label>
        <input type="text" id="f_name" placeholder="напр. Эфиопия Гедео"/>
        <label class="fl">Обжарщик</label>
        <input type="text" id="f_roaster" placeholder="напр. Tasty Coffee, Rockets"/>
        <label class="fl">Сорт</label>
        <select id="f_variety"></select>
        <div id="varietyCustomRow" class="variety-custom" style="display:none">
          <input type="text" id="f_variety_custom" placeholder="Какой сорт? напр. Sidra, Pink Bourbon"/>
        </div>
        <div class="row2">
          <div><label class="fl">Страна</label><select id="f_country"></select></div>
          <div><label class="fl">Обработка</label><select id="f_process"></select></div>
        </div>
        <label class="fl">Способ заваривания</label>
        <select id="f_brew"></select>
        <div id="templateRow" class="template-row" style="display:none">
          <label class="fl">Базовый рецепт</label>
          <select id="f_template"></select>
          <div class="template-hint">Подставит граммовку, проливы и параметры — подправь под эту чашку</div>
        </div>
        <label class="fl">Рецепт — как ты заваривал</label>
        <div class="recipe-grid">
          <input type="number" id="r_coffee_g" inputmode="decimal" min="0" step="0.1" placeholder="Зерно, г (напр. 15)"/>
          <input type="number" id="r_water_g" inputmode="decimal" min="0" step="1" placeholder="Вода, г (напр. 250)"/>
          <input type="text" id="r_grind" placeholder="Помол (напр. средний)"/>
          <input type="text" id="r_temp" placeholder="Вода °C (напр. 94)"/>
          <input type="text" id="r_time" class="brew-time-inp" inputmode="numeric" placeholder="230"/>
        </div>
        <label class="fl">Время проливов</label>
        <div class="pour-block">
          <div class="pour-row">
            <span class="pour-lbl">Блуминг</span>
            <input type="text" id="p_bloom" class="pour-inp brew-time-inp" inputmode="numeric" placeholder="30"/>
          </div>
          <div id="pourList"></div>
          <button type="button" class="pour-add" id="addPourBtn">+ Пролив</button>
        </div>
        <div id="recipeHint" class="recipe-hint" style="display:none">Подставлен рецепт из гида — поправь под то, как заварил на самом деле.</div>
        <label class="fl">Баланс вкуса</label>
        <p class="balance-hint">Ползунок — насколько. Ниже — характер (тренировка палитры)</p>
        <div id="sliders"></div>
        <div id="tasteChars"></div>
        <label class="fl">Вкус и ароматы — что чувствуешь в чашке</label>
        <p class="note-cat-hint">Раскрой категорию ▶ — выбери подсказку или добавь свою ноту</p>
        <div id="selectedNotes" class="note-selected"></div>
        <div id="noteFamilies"></div>
        <label class="fl">Оценка</label>
        <div id="rating" class="rating"></div>
        <label class="fl">Заметка</label>
        <textarea id="f_comment" rows="3" placeholder="Ваши впечатления, рецепт, мысли…"></textarea>
        <button class="btn btn-primary save-btn" id="saveBtn">Сохранить чашку</button>
        <div id="msg" class="addcup-msg"></div>
      </div>
    </div>
  </div>
</Layout>

<style is:global>
  .addcup-page { padding-top: 88px; max-width: 600px; margin: 0 auto; padding-bottom: 100px; }
  .addcup-back { font-size: .8rem; color: var(--text-muted); text-decoration: none; }
  .addcup-back:hover { color: var(--accent); }
  .addcup-page h1 { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1.6rem; font-weight: 600; margin: 12px 0 4px; }
  .addcup-sub { font-size: .84rem; color: var(--text-dim); margin-bottom: 20px; line-height: 1.5; }
  .addcup-card { padding: 22px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow); }
  .addcup-card .fl { display: block; font-size: .8rem; font-weight: 600; color: var(--text); margin: 14px 0 6px; }
  .addcup-card input[type=text], .addcup-card input[type=number], .addcup-card select, .addcup-card textarea {
    width: 100%; padding: 11px 12px; border: 1px solid var(--border); border-radius: 10px;
    font-size: .92rem; background: var(--bg); color: var(--text); font-family: 'Inter', sans-serif;
  }
  .addcup-card textarea { resize: vertical; }
  .row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .recipe-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .pour-block { margin-top: 4px; display: flex; flex-direction: column; gap: 8px; }
  .pour-row { display: grid; grid-template-columns: 92px 1fr auto; gap: 8px; align-items: center; }
  .pour-lbl { font-size: .78rem; color: var(--text-dim); font-weight: 600; }
  .pour-inp {
    width: 100%; padding: 10px 12px; border: 1px solid var(--border); border-radius: 10px;
    font-size: .92rem; background: var(--bg); color: var(--text); font-family: 'Inter', sans-serif;
  }
  .pour-rm {
    width: 32px; height: 32px; border: 1px solid var(--border); border-radius: 8px;
    background: var(--bg); color: var(--text-muted); cursor: pointer; font-size: 1rem; line-height: 1;
  }
  .pour-rm:hover { border-color: var(--accent-warm); color: var(--accent-warm); }
  .pour-add {
    align-self: flex-start; margin-top: 2px; padding: 7px 12px; border: 1px dashed var(--border);
    border-radius: 8px; background: none; color: var(--accent); font-size: .78rem; font-weight: 600;
    cursor: pointer; font-family: 'Inter', sans-serif;
  }
  .pour-add:hover { border-color: var(--accent); background: rgba(168,124,79,.06); }
  .note-selected {
    min-height: 44px; padding: 10px 12px; border: 1px dashed var(--border); border-radius: 12px;
    display: flex; flex-wrap: wrap; gap: 7px; align-items: center; margin-bottom: 10px; background: var(--bg);
  }
  .note-empty { font-size: .78rem; color: var(--text-muted); line-height: 1.45; }
  .note-tag {
    display: inline-flex; align-items: center; gap: 4px; padding: 5px 10px; border-radius: 20px;
    background: var(--accent); color: #fff; font-size: .78rem; font-weight: 600;
  }
  .note-tag-rm {
    background: none; border: 0; color: rgba(255,255,255,.9); cursor: pointer; font-size: 1rem;
    line-height: 1; padding: 0 2px;
  }
  .note-cat { border: 1px solid var(--border); border-radius: 12px; margin-bottom: 8px; overflow: hidden; background: var(--surface); }
  .note-cat-sum {
    list-style: none; cursor: pointer; padding: 12px 14px; font-size: .86rem; font-weight: 700;
    display: flex; align-items: center; gap: 8px; user-select: none;
  }
  .note-cat-sum::-webkit-details-marker { display: none; }
  .note-cat-sum::marker { content: ''; }
  .note-cat-name { flex: 1; min-width: 0; }
  .note-cat-chevron {
    flex-shrink: 0; font-size: 1.05rem; line-height: 1; color: var(--text-muted);
    transition: transform .18s ease; margin-left: auto;
  }
  .note-cat[open] .note-cat-chevron { transform: rotate(90deg); color: var(--accent); }
  .note-cat-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--cat-color, var(--accent)); flex-shrink: 0; }
  .note-cat-badge {
    font-size: .68rem; font-weight: 700; padding: 2px 8px; border-radius: 20px;
    background: var(--surface-2); color: var(--text-muted); min-width: 22px; text-align: center; flex-shrink: 0;
  }
  .note-cat-badge.has { background: rgba(168,124,79,.15); color: var(--accent); }
  .note-cat-body { padding: 0 14px 14px; border-top: 1px solid var(--border); }
  .note-cat-hint {
    font-size: .72rem; color: var(--text-muted); margin: 0 0 10px; line-height: 1.45;
  }
  .note-hint { font-size: .72rem; color: var(--text-muted); margin: 10px 0 8px; }
  .note-custom-row { display: grid; grid-template-columns: 1fr auto; gap: 8px; margin-top: 10px; }
  .note-custom-inp {
    padding: 9px 11px; border: 1px solid var(--border); border-radius: 10px; font-size: .86rem;
    background: var(--bg); color: var(--text); font-family: 'Inter', sans-serif; width: 100%;
  }
  .note-custom-add {
    width: 40px; border: 1px solid var(--border); border-radius: 10px; background: var(--bg);
    color: var(--accent); font-size: 1.1rem; font-weight: 700; cursor: pointer;
  }
  .note-custom-add:hover { border-color: var(--accent); background: rgba(168,124,79,.06); }
  .template-row { margin-bottom: 4px; }
  .template-hint { font-size: .72rem; color: var(--text-muted); margin-top: 4px; line-height: 1.4; }
  .variety-custom { margin-top: 8px; }
  .variety-custom input {
    width: 100%; padding: 11px 12px; border: 1px solid var(--border); border-radius: 10px;
    font-size: .92rem; background: var(--bg); color: var(--text); font-family: 'Inter', sans-serif;
  }
  .recipe-hint { font-size: .76rem; color: var(--accent); margin-top: 8px; }
  .sliderrow { margin: 12px 0; }
  .sliderrow .top { display: flex; justify-content: space-between; font-size: .82rem; margin-bottom: 3px; }
  .sliderrow .val { color: var(--accent); font-weight: 700; }
  .sliderrow input[type=range] { width: 100%; accent-color: var(--accent); }
  .balance-hint { font-size: .72rem; color: var(--text-muted); margin: -4px 0 10px; line-height: 1.45; }
  .char-block {
    margin: 14px 0 0; padding: 12px 12px 10px; border: 1px dashed var(--border); border-radius: 12px;
    background: rgba(168,124,79,.03);
  }
  .char-block-h { font-size: .78rem; font-weight: 700; color: var(--text); margin-bottom: 2px; }
  .char-block-sub { font-size: .7rem; color: var(--text-muted); margin-bottom: 8px; line-height: 1.4; }
  .char-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 8px; }
  .char-chip {
    padding: 5px 10px; border-radius: 16px; border: 1px solid var(--border); background: var(--bg);
    font-size: .74rem; cursor: pointer; transition: .12s; font-family: 'Inter', sans-serif; color: var(--text);
    text-align: left; line-height: 1.25;
  }
  .char-chip small { display: block; font-size: .62rem; color: var(--text-muted); font-weight: 500; margin-top: 1px; }
  .char-chip.on { background: var(--accent); color: #fff; border-color: var(--accent); }
  .char-chip.on small { color: rgba(255,255,255,.85); }
  .char-custom {
    width: 100%; padding: 9px 11px; border: 1px solid var(--border); border-radius: 10px; font-size: .82rem;
    background: var(--bg); color: var(--text); font-family: 'Inter', sans-serif;
  }
  .famhdr { font-size: .72rem; font-weight: 700; color: var(--text-muted); margin: 12px 0 5px; text-transform: uppercase; letter-spacing: .04em; }
  .chips { display: flex; flex-wrap: wrap; gap: 7px; }
  .chip {
    padding: 6px 12px; border-radius: 20px; border: 1px solid var(--border); background: var(--bg);
    font-size: .8rem; cursor: pointer; transition: .12s; font-family: 'Inter', sans-serif; color: var(--text);
  }
  .chip.on { background: var(--accent); color: #fff; border-color: var(--accent); }
  .rating { display: flex; gap: 6px; }
  .star { font-size: 1.6rem; cursor: pointer; color: var(--border); transition: .12s; }
  .star.on { color: #E0B81E; }
  .save-btn { width: 100%; margin-top: 20px; }
  .addcup-msg { margin-top: 12px; font-size: .84rem; text-align: center; min-height: 20px; }
  .addcup-msg.error { color: var(--accent-warm); }
  .fromguide { padding: 14px 16px; margin-bottom: 8px; border-radius: 12px; background: rgba(168,124,79,.08); border: 1px solid rgba(168,124,79,.3); }
  .fromguide .fg-h { font-size: .78rem; font-weight: 700; color: var(--accent); margin-bottom: 8px; }
  .fromguide .fg-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 8px; }
  .fromguide .fg-chip { font-size: .78rem; padding: 4px 11px; border-radius: 20px; background: var(--surface); border: 1px solid var(--border); color: var(--text-dim); font-weight: 600; }
  .fromguide .fg-note { font-size: .8rem; color: var(--text-dim); line-height: 1.5; }
  .fromguide .fg-note b { color: var(--text); }
  @media (max-width: 600px) { .addcup-page { padding-top: 72px; } .row2 { grid-template-columns: 1fr; } }
</style>

<script>
  import { createClient } from '@supabase/supabase-js';
  import { wheelData } from '../data/wheel';
  import { DB, countryOrder } from '../data/countries';
  import { BEAN_VARIETIES } from '../data/varieties';
  import { normalizeRecipe, recipeHasData, parseGramsFromRatioText } from '../lib/cupRecipe';
  import { bindVarietyOther, readVarietyValue, setVarietyValue } from '../lib/beanVarietyField';
  import { tableHasColumn } from '../lib/supabaseSchema';
  import { bindBrewTimeInput, parseBrewTimeInput, readBrewTimeInput, setBrewTimeInputValue } from '../lib/brewTime';
  import { TASTE_CHARACTER, TASTE_CHARACTER_DIMS } from '../data/tasteCharacter';
  import { normalizeTasteCharacter, type TasteCharacter } from '../lib/tasteCharacter';

  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
    { auth: { flowType: 'implicit' } }
  );

  const PROCESSES = ['Мытая (Washed)','Натуральная (Natural)','Хани (Honey)','Анаэробная','Carbonic maceration','Wet-hulled','Другая'];
  const BREWS = ['V60','Kalita','Chemex','Aeropress','Френч-пресс','Гейзерная','Турка','Эспрессо','Капсулы','Cold Brew','Другое'];
  const SLIDERS = [['acidity','Кислотность'],['sweetness','Сладость'],['bitterness','Горечь'],['body','Тело']];

  const sel: any = {
    acidity: 3, sweetness: 3, bitterness: 2, body: 3,
    notes: new Set<string>(), noteCats: new Map<string, string>(),
    rating: 0, tasteChar: {} as TasteCharacter,
  };
  const params = new URLSearchParams(location.search);
  const editCupId = params.get('edit');
  let selectedTemplateId: string | null = params.get('template') || null;
  const flagByName: Record<string,string> = {};
  for (const k of Object.keys(DB)) flagByName[(DB as any)[k].name] = (DB as any)[k].flag;

  const wheelByCat: Record<string, Set<string>> = {};
  const wheelCanonical = new Map<string, string>();
  (wheelData as any[]).forEach((f) => {
    wheelByCat[f.name] = new Set(f.subs.map((s: any) => s.name));
    f.subs.forEach((s: any) => wheelCanonical.set(s.name.toLowerCase(), s.name));
  });

  const escNote = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');

  function fill(id:string, arr:readonly string[], ph:string){
    const s = document.getElementById(id) as HTMLSelectElement;
    s.innerHTML = `<option value="">${ph}</option>` + arr.map(x=>`<option>${x}</option>`).join('');
  }

  function setSelect(id: string, val: string) {
    if (!val) return;
    const s = document.getElementById(id) as HTMLSelectElement;
    const low = val.trim().toLowerCase();
    for (const o of Array.from(s.options)) {
      if (o.value.toLowerCase() === low || o.text.toLowerCase() === low) { s.value = o.value; return; }
    }
    for (const o of Array.from(s.options)) {
      if (o.text && (o.text.toLowerCase().startsWith(low) || low.startsWith(o.text.toLowerCase().split(' (')[0]))) { s.value = o.value; return; }
    }
  }

  async function guard(){
    const { data:{ user } } = await supabase.auth.getUser();
    if(!user){ window.location.href = '/login'; return null; }
    return user;
  }

  function pourLabel(n: number) { return `${n}-й пролив`; }

  function renumberPours() {
    document.querySelectorAll('#pourList .pour-row').forEach((row, idx) => {
      const lbl = row.querySelector('.pour-lbl');
      if (lbl) lbl.textContent = pourLabel(idx + 1);
    });
  }

  function appendPourRow() {
    const list = document.getElementById('pourList')!;
    const n = list.querySelectorAll('.pour-row').length + 1;
    const row = document.createElement('div');
    row.className = 'pour-row';
    row.innerHTML = `<span class="pour-lbl">${pourLabel(n)}</span><input type="text" class="pour-inp brew-time-inp" inputmode="numeric" placeholder="45"/><button type="button" class="pour-rm" title="Убрать пролив">×</button>`;
    bindBrewTimeInput(row.querySelector('.pour-inp') as HTMLInputElement);
    row.querySelector('.pour-rm')!.addEventListener('click', () => { row.remove(); renumberPours(); });
    list.appendChild(row);
  }

  function setPourRows(values: string[]) {
    const list = document.getElementById('pourList')!;
    list.innerHTML = '';
    const count = Math.max(values.length, 1);
    for (let i = 0; i < count; i++) appendPourRow();
    document.querySelectorAll('#pourList .pour-inp').forEach((inp, i) => {
      if (values[i]) setBrewTimeInputValue(inp as HTMLInputElement, values[i]);
    });
  }

  function initPours() {
    setPourRows([]);
    document.getElementById('addPourBtn')!.addEventListener('click', () => appendPourRow());
  }

  function collectPours(): string[] {
    return [...document.querySelectorAll('#pourList .pour-inp')]
      .map(inp => readBrewTimeInput(inp as HTMLInputElement))
      .filter((t): t is string => Boolean(t));
  }

  function applyRecipeToForm(recipeRaw: unknown, brewMethod?: string | null) {
    if (brewMethod) setSelect('f_brew', brewMethod);
    const r = normalizeRecipe(recipeRaw);
    if (!r) return;
    (document.getElementById('r_coffee_g') as HTMLInputElement).value = r.coffee_g ? String(r.coffee_g) : '';
    (document.getElementById('r_water_g') as HTMLInputElement).value = r.water_g ? String(r.water_g) : '';
    (document.getElementById('r_grind') as HTMLInputElement).value = r.grind || '';
    (document.getElementById('r_temp') as HTMLInputElement).value = r.temp || '';
    setBrewTimeInputValue(document.getElementById('r_time') as HTMLInputElement, r.time);
    setBrewTimeInputValue(document.getElementById('p_bloom') as HTMLInputElement, r.blooming);
    const pours = r.pours || [];
    if (pours.length) {
      setPourRows(pours);
    }
    (document.getElementById('recipeHint') as HTMLElement).style.display = 'block';
  }

  async function loadSavedRecipes() {
    const { data: { user } } = await supabase.auth.getUser();
    if (!user) return;
    const { error: tableErr } = await supabase.from('saved_brew_recipes').select('id').limit(0);
    if (tableErr) return;
    const { data } = await supabase.from('saved_brew_recipes').select('id,name,brew_method,recipe').order('created_at', { ascending: false });
    const row = document.getElementById('templateRow')!;
    const tpl = document.getElementById('f_template') as HTMLSelectElement;
    if (!data?.length) { row.style.display = 'none'; return; }
    row.style.display = 'block';
    tpl.innerHTML = '<option value="">— выбрать базовый рецепт —</option>' + data.map((t) =>
      `<option value="${t.id}">${escNote(t.name)}${t.brew_method ? ' · ' + escNote(t.brew_method) : ''}</option>`
    ).join('');
    if (!editCupId && selectedTemplateId && data.some((t) => t.id === selectedTemplateId)) {
      tpl.value = selectedTemplateId;
      const t = data.find((x) => x.id === selectedTemplateId);
      if (t) applyRecipeToForm(t.recipe, t.brew_method);
    }
    tpl.addEventListener('change', () => {
      selectedTemplateId = tpl.value || null;
      const t = data.find((x) => x.id === tpl.value);
      if (t) applyRecipeToForm(t.recipe, t.brew_method);
    });
  }

  function setEditModeUI() {
    const h1 = document.querySelector('.addcup-page h1');
    const sub = document.querySelector('.addcup-sub');
    const btn = document.getElementById('saveBtn') as HTMLButtonElement;
    if (h1) h1.textContent = 'Редактировать чашку';
    if (sub) sub.textContent = 'Довнеси ноты, поправь баланс вкуса или рецепт — карточка обновится.';
    if (btn) btn.textContent = 'Сохранить изменения';
  }

  function prefillFromCup(cup: any) {
    (document.getElementById('f_name') as HTMLInputElement).value = cup.name || '';
    (document.getElementById('f_roaster') as HTMLInputElement).value = cup.roaster || '';
    setVarietyValue(cup.variety);
    setSelect('f_country', cup.country || '');
    setSelect('f_process', cup.process || '');
    setSelect('f_brew', cup.brew_method || '');
    sel.acidity = cup.acidity ?? 3;
    sel.sweetness = cup.sweetness ?? 3;
    sel.bitterness = cup.bitterness ?? 2;
    sel.body = cup.body ?? 3;
    SLIDERS.forEach(([k]) => {
      const inp = document.querySelector(`#sliders input[data-k="${k}"]`) as HTMLInputElement;
      const lbl = document.getElementById('v_' + k);
      if (inp) inp.value = String(sel[k]);
      if (lbl) lbl.textContent = String(sel[k]);
    });
    sel.rating = cup.rating || 0;
    setTasteCharacterUI(normalizeTasteCharacter(cup.taste_character));
    document.querySelectorAll('#rating .star').forEach((s2) => {
      s2.classList.toggle('on', +(s2 as HTMLElement).dataset.i! <= sel.rating);
    });
    sel.notes.clear();
    sel.noteCats.clear();
    const notes = Array.isArray(cup.notes) ? cup.notes : cup.notes ? [String(cup.notes)] : [];
    notes.forEach((n: string) => sel.notes.add(n));
    refreshNotesUI();
    (document.getElementById('f_comment') as HTMLTextAreaElement).value = cup.comment || '';
    selectedTemplateId = cup.brew_recipe_id || null;
    const tpl = document.getElementById('f_template') as HTMLSelectElement;
    if (tpl && selectedTemplateId) tpl.value = selectedTemplateId;
    applyRecipeToForm(cup.recipe, cup.brew_method);
  }

  async function loadCupForEdit() {
    if (!editCupId) return;
    setEditModeUI();
    const { data: cup, error } = await supabase.from('cups').select('*').eq('id', editCupId).maybeSingle();
    if (error || !cup) {
      alert('Чашка не найдена');
      window.location.href = '/account';
      return;
    }
    prefillFromCup(cup);
  }

  function noteInCategory(note: string, cat: string) {
    if (wheelByCat[cat]?.has(note)) return true;
    return sel.noteCats.get(note) === cat;
  }

  function addNote(n: string, cat?: string) {
    const note = n.trim();
    if (!note) return;
    const canonical = wheelCanonical.get(note.toLowerCase()) || note;
    sel.notes.add(canonical);
    const inWheel = Object.values(wheelByCat).some((set) => set.has(canonical));
    if (inWheel) sel.noteCats.delete(canonical);
    else if (cat) sel.noteCats.set(canonical, cat);
    refreshNotesUI();
  }

  function removeNote(n: string) {
    sel.notes.delete(n);
    sel.noteCats.delete(n);
    refreshNotesUI();
  }

  function toggleNote(n: string, cat?: string) {
    if (sel.notes.has(n)) removeNote(n);
    else addNote(n, cat);
  }

  function renderSelectedNotes() {
    const el = document.getElementById('selectedNotes')!;
    if (!sel.notes.size) {
      el.innerHTML = '<span class="note-empty">Пока пусто — раскрой категорию ▶ ниже, выбери подсказку или добавь свою</span>';
      return;
    }
    el.innerHTML = [...sel.notes].map((n) =>
      `<span class="note-tag">${escNote(n)}<button type="button" class="note-tag-rm" data-n="${encodeURIComponent(n)}" aria-label="Убрать">×</button></span>`
    ).join('');
    el.querySelectorAll('.note-tag-rm').forEach((btn) => {
      btn.addEventListener('click', () => removeNote(decodeURIComponent((btn as HTMLElement).dataset.n!)));
    });
  }

  function syncChipStates() {
    document.querySelectorAll('#noteFamilies .chip').forEach((ch) => {
      const n = (ch as HTMLElement).dataset.n!;
      ch.classList.toggle('on', sel.notes.has(n));
    });
  }

  function updateCategoryBadges() {
    (wheelData as any[]).forEach((f) => {
      const badge = document.querySelector(`[data-cat-badge="${CSS.escape(f.name)}"]`);
      if (!badge) return;
      const count = [...sel.notes].filter((n) => noteInCategory(n, f.name)).length;
      badge.textContent = String(count);
      badge.classList.toggle('has', count > 0);
    });
  }

  function refreshNotesUI() {
    renderSelectedNotes();
    syncChipStates();
    updateCategoryBadges();
  }

  function addCustomNote(btn: HTMLButtonElement) {
    const row = btn.closest('.note-custom-row');
    const inp = row?.querySelector('.note-custom-inp') as HTMLInputElement | null;
    const cat = btn.dataset.cat || inp?.dataset.cat || '';
    if (!inp || !cat) return;
    const val = inp.value.trim();
    if (!val) {
      inp.focus();
      inp.style.borderColor = 'var(--accent-warm)';
      setTimeout(() => { inp.style.borderColor = ''; }, 1200);
      return;
    }
    addNote(val, cat);
    inp.value = '';
    inp.focus();
  }

  function syncTasteCharChips() {
    TASTE_CHARACTER_DIMS.forEach((dim) => {
      const preset = sel.tasteChar[dim]?.preset;
      document.querySelectorAll(`.char-chip[data-dim="${dim}"]`).forEach((ch) => {
        ch.classList.toggle('on', preset === (ch as HTMLElement).dataset.id);
      });
    });
  }

  function setTasteCharacterUI(tc: TasteCharacter | null) {
    sel.tasteChar = tc ? { ...tc } : {};
    TASTE_CHARACTER_DIMS.forEach((dim) => {
      const inp = document.querySelector(`.char-custom[data-dim="${dim}"]`) as HTMLInputElement | null;
      if (inp) inp.value = sel.tasteChar[dim]?.custom || '';
    });
    syncTasteCharChips();
  }

  function readTasteCharacterFromForm(): TasteCharacter | null {
    const out: TasteCharacter = {};
    TASTE_CHARACTER_DIMS.forEach((dim) => {
      const preset = sel.tasteChar[dim]?.preset || null;
      const custom = (document.querySelector(`.char-custom[data-dim="${dim}"]`) as HTMLInputElement | null)?.value.trim() || null;
      if (preset || custom) out[dim] = { preset, custom };
    });
    return Object.keys(out).length ? out : null;
  }

  function buildTasteChars() {
    const box = document.getElementById('tasteChars')!;
    box.innerHTML = TASTE_CHARACTER_DIMS.map((dim) => {
      const cfg = TASTE_CHARACTER[dim];
      const chips = cfg.options.map((o) =>
        `<button type="button" class="char-chip" data-dim="${dim}" data-id="${escNote(o.id)}"><span>${escNote(o.label)}</span><small>${escNote(o.desc)}</small></button>`
      ).join('');
      return `<div class="char-block" data-dim-block="${dim}">
        <div class="char-block-h">${escNote(cfg.label)} — характер</div>
        <div class="char-block-sub">${escNote(cfg.hint)}</div>
        <div class="char-chips">${chips}</div>
        <input type="text" class="char-custom" data-dim="${dim}" placeholder="Или свой вариант…"/>
      </div>`;
    }).join('');

    box.addEventListener('click', (e) => {
      const chip = (e.target as HTMLElement).closest('.char-chip') as HTMLElement | null;
      if (!chip) return;
      e.preventDefault();
      const dim = chip.dataset.dim as keyof TasteCharacter;
      const id = chip.dataset.id!;
      const cur = sel.tasteChar[dim]?.preset;
      if (cur === id) {
        if (sel.tasteChar[dim]) sel.tasteChar[dim]!.preset = null;
        if (!sel.tasteChar[dim]?.custom) delete sel.tasteChar[dim];
      } else {
        sel.tasteChar[dim] = { ...sel.tasteChar[dim], preset: id };
      }
      syncTasteCharChips();
    });
    box.querySelectorAll('.char-custom').forEach((inp) => {
      inp.addEventListener('input', () => {
        const dim = (inp as HTMLElement).dataset.dim as keyof TasteCharacter;
        const v = (inp as HTMLInputElement).value.trim();
        if (v) sel.tasteChar[dim] = { ...sel.tasteChar[dim], custom: v };
        else if (sel.tasteChar[dim]) {
          sel.tasteChar[dim]!.custom = null;
          if (!sel.tasteChar[dim]!.preset) delete sel.tasteChar[dim];
        }
      });
    });
  }

  function buildNotes() {
    const container = document.getElementById('noteFamilies')!;
    container.innerHTML = (wheelData as any[]).map((f, idx) => `
      <details class="note-cat"${idx === 0 ? ' open' : ''}>
        <summary class="note-cat-sum" style="--cat-color:${f.color}">
          <span class="note-cat-dot"></span>
          <span class="note-cat-name">${escNote(f.name)}</span>
          <span class="note-cat-chevron" aria-hidden="true">›</span>
          <span class="note-cat-badge" data-cat-badge="${escNote(f.name)}">0</span>
        </summary>
        <div class="note-cat-body">
          <div class="note-hint">Подсказки — нажми, чтобы добавить</div>
          <div class="chips">${f.subs.map((s: any) => `<button type="button" class="chip" data-n="${escNote(s.name)}" data-cat="${escNote(f.name)}">${escNote(s.name)}</button>`).join('')}</div>
          <div class="note-custom-row">
            <input type="text" class="note-custom-inp" data-cat="${escNote(f.name)}" placeholder="Своя нота…"/>
            <button type="button" class="note-custom-add" data-cat="${escNote(f.name)}" aria-label="Добавить ноту">+</button>
          </div>
        </div>
      </details>`).join('');

    container.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const chip = target.closest('.chip') as HTMLElement | null;
      if (chip) {
        e.preventDefault();
        toggleNote(chip.dataset.n!, chip.dataset.cat);
        return;
      }
      const addBtn = target.closest('.note-custom-add') as HTMLButtonElement | null;
      if (addBtn) {
        e.preventDefault();
        e.stopPropagation();
        addCustomNote(addBtn);
      }
    });
    container.querySelectorAll('.note-custom-inp').forEach((inp) => {
      inp.addEventListener('keydown', (e) => {
        if (e.key !== 'Enter') return;
        e.preventDefault();
        const row = (inp as HTMLElement).closest('.note-custom-row');
        const addBtn = row?.querySelector('.note-custom-add') as HTMLButtonElement | null;
        if (addBtn) addCustomNote(addBtn);
      });
    });
    refreshNotesUI();
  }

  function prefillNotesFromParam(raw: string) {
    if (!raw) return;
    raw.split(',').map((s) => s.trim()).filter(Boolean).forEach((note) => {
      const low = note.toLowerCase();
      let canonical = wheelCanonical.get(low);
      if (!canonical) {
        for (const [k, v] of wheelCanonical.entries()) {
          if (low === k || low.includes(k) || k.includes(low)) { canonical = v; break; }
        }
      }
      addNote(canonical || note);
    });
  }

  function prefill(){
    const g = (k: string) => params.get(k) || '';
    (document.getElementById('f_name') as HTMLInputElement).value = g('name');
    (document.getElementById('f_roaster') as HTMLInputElement).value = g('roaster');
    setVarietyValue(g('variety'));
    setSelect('f_country', g('country'));
    setSelect('f_process', g('process'));
    setSelect('f_brew', g('brew'));
    (document.getElementById('r_coffee_g') as HTMLInputElement).value = g('coffee_g');
    (document.getElementById('r_water_g') as HTMLInputElement).value = g('water_g');
    if (!g('coffee_g') && !g('water_g') && g('ratio')) {
      const parsed = parseGramsFromRatioText(g('ratio'));
      if (parsed.coffee_g) (document.getElementById('r_coffee_g') as HTMLInputElement).value = String(parsed.coffee_g);
      if (parsed.water_g) (document.getElementById('r_water_g') as HTMLInputElement).value = String(parsed.water_g);
    }
    (document.getElementById('r_grind') as HTMLInputElement).value = g('grind');
    (document.getElementById('r_temp') as HTMLInputElement).value = g('temp');
    setBrewTimeInputValue(document.getElementById('r_time') as HTMLInputElement, g('time'));
    setBrewTimeInputValue(document.getElementById('p_bloom') as HTMLInputElement, g('blooming'));
    const pourTimes = g('pours')
      ? g('pours').split(',').map(s => s.trim()).filter(Boolean)
      : [g('pour1'), g('pour2'), g('pour3')].map(s => s.trim()).filter(Boolean);
    if (pourTimes.length) setPourRows(pourTimes);
    if (g('coffee_g') || g('water_g') || g('ratio') || g('grind') || g('temp') || g('time') || g('blooming') || pourTimes.length) {
      (document.getElementById('recipeHint') as HTMLElement).style.display = 'block';
    }
    if (g('notes')) prefillNotesFromParam(g('notes'));
    if (g('from') === 'guide') {
      const country = g('country'), variety = g('variety'), process = g('process'), brew = g('brew'), focus = g('focus'), notes = g('notes');
      const chips: string[] = [];
      if (country) chips.push(`${flagByName[country] || '🌍'} ${country}`);
      if (variety) chips.push(`🌱 ${variety}`);
      if (process) chips.push(`⚗️ ${process}`);
      if (brew) chips.push(`☕ ${brew}`);
      const el = document.getElementById('fromGuide')!;
      el.innerHTML = `<div class="fg-h">📔 Из твоего гида дегустации</div>${chips.length ? `<div class="fg-chips">${chips.map(c=>`<span class="fg-chip">${c}</span>`).join('')}</div>` : ''}${notes ? `<div class="fg-note">Ожидались ноты: <b>${notes.split(',').map(s=>s.trim()).filter(Boolean).join(', ')}</b>. Сравни с тем, что почувствуешь.</div>` : ''}${focus ? `<div class="fg-note" style="margin-top:6px">На что обратить внимание: <b>${focus}</b></div>` : ''}`;
      el.style.display = 'block';
    }
  }

  function build(){
    fill('f_variety', BEAN_VARIETIES, '— не знаю / смесь');
    bindVarietyOther();
    fill('f_country', countryOrder.map((k:string)=>(DB as any)[k].name), 'выберите страну');
    fill('f_process', PROCESSES, 'выберите обработку');
    fill('f_brew', BREWS, 'выберите метод');
    initPours();
    bindBrewTimeInput(document.getElementById('p_bloom') as HTMLInputElement);
    bindBrewTimeInput(document.getElementById('r_time') as HTMLInputElement);
    document.getElementById('sliders')!.innerHTML = SLIDERS.map(([k,n])=>`
      <div class="sliderrow"><div class="top"><span>${n}</span><span class="val" id="v_${k}">${sel[k]}</span></div>
      <input type="range" min="0" max="5" value="${sel[k]}" data-k="${k}"></div>`).join('');
    document.querySelectorAll('#sliders input[type=range]').forEach(inp=>{
      inp.addEventListener('input', (e:any)=>{ const k=e.target.dataset.k; sel[k]=+e.target.value; document.getElementById('v_'+k)!.textContent=e.target.value; });
    });
    buildTasteChars();
    buildNotes();
    document.getElementById('rating')!.innerHTML = [1,2,3,4,5].map(i=>`<span class="star" data-i="${i}">★</span>`).join('');
    document.querySelectorAll('#rating .star').forEach(st=>{
      st.addEventListener('click', ()=>{ sel.rating=+(st as HTMLElement).dataset.i!; document.querySelectorAll('#rating .star').forEach(s2=>{ s2.classList.toggle('on', +(s2 as HTMLElement).dataset.i! <= sel.rating); }); });
    });
    if (!editCupId) prefill();
  }

  async function save(){
    const user = await guard();
    if(!user) return;
    const name = (document.getElementById('f_name') as HTMLInputElement).value.trim();
    const msg = document.getElementById('msg')!;
    if(!name){ msg.className='addcup-msg error'; msg.textContent='Добавьте название кофе'; return; }
    const btn = document.getElementById('saveBtn') as HTMLButtonElement;
    btn.disabled = true; btn.textContent = 'Сохраняем...';
    const rv = (id: string) => (document.getElementById(id) as HTMLInputElement).value.trim();
    const rn = (id: string) => {
      const v = rv(id);
      if (!v) return null;
      const n = parseFloat(v.replace(',', '.'));
      return Number.isFinite(n) && n > 0 ? n : null;
    };
    const recipe: any = {
      coffee_g: rn('r_coffee_g'),
      water_g: rn('r_water_g'),
      grind: rv('r_grind') || null,
      temp: rv('r_temp') || null,
      time: readBrewTimeInput(document.getElementById('r_time') as HTMLInputElement),
      blooming: readBrewTimeInput(document.getElementById('p_bloom') as HTMLInputElement),
      pours: collectPours(),
    };
    if (!recipe.pours.length) delete recipe.pours;
    const hasRecipe = recipeHasData(recipe);
    const payload:any = {
      name,
      roaster: (document.getElementById('f_roaster') as HTMLInputElement).value.trim() || null,
      variety: readVarietyValue(),
      country: (document.getElementById('f_country') as HTMLSelectElement).value || null,
      process: (document.getElementById('f_process') as HTMLSelectElement).value || null,
      brew_method: (document.getElementById('f_brew') as HTMLSelectElement).value || null,
      recipe: hasRecipe ? recipe : null,
      acidity: sel.acidity, sweetness: sel.sweetness, bitterness: sel.bitterness, body: sel.body,
      notes: [...sel.notes],
      rating: sel.rating || null,
      comment: (document.getElementById('f_comment') as HTMLTextAreaElement).value.trim() || null,
    };
    if (await tableHasColumn(supabase, 'cups', 'brew_recipe_id')) {
      payload.brew_recipe_id = selectedTemplateId || null;
    }
    const tasteCharacter = readTasteCharacterFromForm();
    if (tasteCharacter && await tableHasColumn(supabase, 'cups', 'taste_character')) {
      payload.taste_character = tasteCharacter;
    }
    if (editCupId) {
      const { error } = await supabase.from('cups').update(payload).eq('id', editCupId).eq('user_id', user.id);
      if (error) { msg.className = 'addcup-msg error'; msg.textContent = 'Ошибка: ' + error.message; btn.disabled = false; btn.textContent = 'Сохранить изменения'; return; }
      window.location.href = `/cup?id=${editCupId}`;
      return;
    }
    payload.user_id = user.id;
    const { data, error } = await supabase.from('cups').insert(payload).select('id').single();
    if(error){ msg.className='addcup-msg error'; msg.textContent='Ошибка: '+error.message; btn.disabled=false; btn.textContent='Сохранить чашку'; return; }
    window.location.href = `/cup?id=${data.id}&new=1`;
  }

  (async ()=>{
    if(await guard()){
      build();
      await loadSavedRecipes();
      if (editCupId) await loadCupForEdit();
      document.getElementById('saveBtn')!.addEventListener('click', save);
    }
  })();
</script>
