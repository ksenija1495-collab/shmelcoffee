  async function fetchCredits(token: string): Promise<{ balance: number; ok: boolean }> {
    if (!token) return { balance: 0, ok: false };
    try {
      const res = await fetch('/api/guide-credits', { headers: { Authorization: 'Bearer ' + token } });
      if (!res.ok) return { balance: 0, ok: false };
      const data = await res.json();
      return { balance: data.balance ?? 0, ok: true };
    } catch {
      return { balance: 0, ok: false };
    }
  }

  async function pollCredits(token: string, attempts = 8): Promise<number> {
    for (let i = 0; i < attempts; i++) {
      const { balance, ok } = await fetchCredits(token);
      if (ok && balance > 0) return balance;
      await new Promise((r) => setTimeout(r, 1500));
    }
    const last = await fetchCredits(token);
    return last.ok ? last.balance : 0;
  }

  async function init() {
    try {
    const { data: { user }, error: authErr } = await supabase.auth.getUser();
    if (authErr && isFetchError(authErr.message)) {
      showLoadError('Сервер данных временно недоступен. Если через 10 минут не заработает — напишите @ksenijashmel.');
      return;
    }
    if (!user) { window.location.href = '/login'; return; }

    const { data: profileCheck, error: profileErr } = await supabase.from('taste_profiles').select('id').eq('user_id', user.id).limit(1);
    if (profileErr && isFetchError(profileErr.message)) {
      showLoadError('Сервер данных временно недоступен. Если через 10 минут не заработает — напишите @ksenijashmel.');
      return;
    }
    if (!profileCheck?.length) {
      const { count } = await supabase.from('coffee_selections').select('id', { count: 'exact', head: true }).eq('user_id', user.id);
      if (!count) { window.location.href = '/quiz'; return; }
    }

    const { data: { session } } = await supabase.auth.getSession();
    const accessToken = session?.access_token || '';

    const isPaidReturn = new URLSearchParams(window.location.search).get('paid') === '1';
    let creditsResult = await fetchCredits(accessToken);
    if (isPaidReturn && creditsResult.ok && creditsResult.balance === 0) {
      creditsResult = { balance: await pollCredits(accessToken), ok: true };
    }
    const credits = creditsResult.balance;
    const creditsKnown = creditsResult.ok;

    const [profilesRes, selectionsRes, guidesRes, cupsRes, shelfRes] = await Promise.all([
      supabase.from('taste_profiles').select('*').eq('user_id', user.id).order('created_at', { ascending: false }),
      supabase.from('coffee_selections').select('*').eq('user_id', user.id).order('created_at', { ascending: false }),
      supabase.from('guides').select('*').eq('user_id', user.id).order('created_at', { ascending: false }),
      supabase.from('cups').select('*').eq('user_id', user.id).order('created_at', { ascending: false }),
      supabase.from('shelf_items').select('*').eq('user_id', user.id).order('created_at', { ascending: false }),
    ]);
    const recipesResult = await fetchSavedBrewRecipes(supabase);

    const loadErr = [profilesRes, selectionsRes, guidesRes, cupsRes, shelfRes].find(r => r.error)?.error;
    if (loadErr && isFetchError(loadErr.message)) {
      showLoadError('Сервер данных временно недоступен. Если через 10 минут не заработает — напишите @ksenijashmel.');
      return;
    }

    const profiles = profilesRes.data || [];
    const selections = selectionsRes.data || [];
    const guides = guidesRes.data || [];
    const cups = cupsRes.data || [];
    const savedRecipes = recipesResult.ok ? recipesResult.recipes : [];
    const recipesUnavailable = recipesResult.error === 'migration_required' || (
      !recipesResult.ok && Boolean(recipesResult.error?.includes('saved_brew_recipes'))
    );
    const shelf = shelfRes.data || [];
    const buyUrl = buildProdamusBuyUrl(PRODAMUS_URL, user, window.location.origin);
    const paidBanner = isPaidReturn
      ? credits > 0
        ? `<div class="paid-banner">✅ Оплата прошла. У тебя <b>${credits}</b> ${guideWord(credits)} — нажми «Создать гид», чтобы получить персональный рецепт.</div>`
        : `<div class="paid-banner" style="background:rgba(168,124,79,.1);border-color:rgba(168,124,79,.25)">⏳ Оплата обрабатывается… Обнови страницу через минуту или напиши @ksenijashmel, если кредит не появился.</div>`
      : !creditsKnown
        ? `<div class="paid-banner" style="background:rgba(168,124,79,.1);border-color:rgba(168,124,79,.25)">⚠️ Не удалось проверить баланс гидов. <button type="button" id="reloadCredits" style="background:none;border:0;color:var(--accent);font-weight:600;cursor:pointer;text-decoration:underline">Обновить</button></div>`
        : '';

    const latestProfile = profiles[0];
    const topNamesSet = new Set((latestProfile?.profile_type || '').split(',').map((s: string) => s.trim()).filter(Boolean));

    const answers = latestProfile?.answers || null;
    const openedKeys = new Set<string>();
    const openSelStatuses = new Set(['ordered', 'received', 'tasted']);
    selections.forEach((s: any) => {
      if (!openSelStatuses.has(s.status)) return;
      (s.coffees || []).forEach((c: any) => {
        const k = resolveCountryKey(c.origin, c.name);
        if (k) openedKeys.add(k);
      });
    });
    cups.forEach((c: any) => {
      const k = resolveCountryKey(c.country, c.name);
      if (k) openedKeys.add(k);
    });
    shelf.forEach((s: any) => {
      const k = resolveCountryKey(s.country, s.name);
      if (k) openedKeys.add(k);
    });
    const topKeys = calcTop(answers);
    const recommendedFirst = topKeys.filter(k => !openedKeys.has(k)).slice(0, 3);
    const prefFams = new Set<string>();
    (answers?.flavors || []).forEach((f: string) => (FLAVOR_TO_FAM[f] || []).forEach(x => prefFams.add(x)));
    const famColor: Record<string, string> = {};
    wheelData.forEach((c: any) => { famColor[c.name] = c.color; });

    const statusLabels: Record<string, string> = { selected: 'Выбрано', ordered: 'Заказано', received: 'Получено', tasted: 'Продегустировано' };
    const statusIcons: Record<string, string> = { selected: '📋', ordered: '📦', received: '✅', tasted: '🏆' };
