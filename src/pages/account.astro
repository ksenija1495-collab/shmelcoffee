        if (card) card.className = `shelf-card shelf-st-${st}`;
      };
      btn.disabled = true;
      apply(next);
      const { error } = await supabase.from('shelf_items').update({ status: next }).eq('id', btn.dataset.shelfStatus).eq('user_id', user.id);
      btn.disabled = false;
      if (error) { apply(prev); alert('Не удалось сохранить статус: ' + error.message); return; }
      const item = shelf.find((s: any) => s.id === btn.dataset.shelfStatus);
      if (item) item.status = next;
      const counter = page.querySelector('.shelf-low-count') as HTMLElement | null;
      const low = shelf.filter((s: any) => s.kind === 'bean' && s.status === 'low').length;
      if (counter) { counter.textContent = `${low} заканчивается`; counter.style.display = low ? '' : 'none'; }
    }));
    page.querySelectorAll('[data-sel-del]').forEach(b => b.addEventListener('click', async () => { if (!confirm('Удалить подборку?')) return; await supabase.from('coffee_selections').delete().eq('id', (b as HTMLElement).dataset.selDel); init(); }));
    page.querySelectorAll('[data-shelf-all]').forEach(b => b.addEventListener('click', async () => { const sel = selections.find((s: any) => s.id === (b as HTMLElement).dataset.shelfAll); if (!sel) return; const rows = (sel.coffees || []).map((c: any) => ({ user_id: user.id, kind: 'bean', name: c.name || 'Кофе', roaster: c.roaster || null, country: c.origin || null, process: c.process || null, source: 'selection' })); if (rows.length) await supabase.from('shelf_items').insert(rows); init(); }));
    page.querySelectorAll('.coffee-shelf-one').forEach(b => b.addEventListener('click', async () => { const el = b as HTMLElement; const sel = selections.find((s: any) => s.id === el.dataset.sid); if (!sel) return; const c = (sel.coffees || [])[parseInt(el.dataset.ci!)]; if (!c) return; await addCoffeeToShelf(user, c); el.textContent = '✓ на полке'; (el as HTMLButtonElement).disabled = true; }));

    document.getElementById('reloadCredits')?.addEventListener('click', () => init());

    page.querySelectorAll('[data-action]').forEach(btn => {
      btn.addEventListener('click', async () => {
        const action = (btn as HTMLElement).dataset.action!;
        const id = (btn as HTMLElement).dataset.id!;
        if (action === 'generate') {
          (btn as HTMLButtonElement).disabled = true; (btn as HTMLButtonElement).textContent = 'Генерация...';
          try { const res = await fetch('/api/generate-guide', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + accessToken }, body: JSON.stringify({ selectionId: id }) }); if (res.status === 402) { alert('Нужен оплаченный гид. Нажми «Купить гид · 99 ₽».'); init(); return; } if (res.status === 403) { alert('Нет доступа к этой подборке.'); init(); return; } if (!res.ok) throw new Error(await res.text()); init(); }
          catch (e: any) { alert('Ошибка генерации: ' + e.message); (btn as HTMLButtonElement).disabled = false; (btn as HTMLButtonElement).textContent = '🤖 Сгенерировать гид'; }
        } else {
          (btn as HTMLButtonElement).disabled = true;
          const { error } = await supabase.from('coffee_selections').update({ status: action, updated_at: new Date().toISOString() }).eq('id', id);
          if (error) { alert('Ошибка: ' + error.message); (btn as HTMLButtonElement).disabled = false; return; }
          if (action === 'ordered') { const s = selections.find((x: any) => x.id === id); if (s) { const rows = (s.coffees || []).map((c: any) => ({ user_id: user.id, kind: 'bean', name: c.name || 'Кофе', roaster: c.roaster || null, country: c.origin || null, process: c.process || null, source: 'selection' })); if (rows.length) await supabase.from('shelf_items').insert(rows); } }
          init();
        }
      });
    });

    const MOBILE_ACC_TABS = new Set(['profile', 'diary', 'shelf', 'add-cup']);
    function syncAccountNav(name: string) {
      document.querySelectorAll('.mobile-acc-nav a[data-acc-tab]').forEach((a) => {
        const tab = a.getAttribute('data-acc-tab');
        a.classList.toggle('active', MOBILE_ACC_TABS.has(name) && tab === name);
      });
    }

    const moreBtn = document.getElementById('accMoreBtn');
    const moreMenu = document.getElementById('accMoreMenu');
    function placeMoreMenu() {
      if (!moreBtn || !moreMenu || moreMenu.hidden) return;
      const r = moreBtn.getBoundingClientRect();
      const w = moreMenu.offsetWidth;
      moreMenu.style.top = `${r.bottom + 6}px`;
      moreMenu.style.left = `${Math.max(8, Math.min(r.right - w, window.innerWidth - w - 8))}px`;
    }
    moreBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (!moreMenu) return;
      moreMenu.hidden = !moreMenu.hidden;
      placeMoreMenu();
    });
    if (!(window as any).__accDocClickBound) {
      (window as any).__accDocClickBound = true;
      const closeMoreMenu = () => {
        const menu = document.getElementById('accMoreMenu');
        if (menu) menu.hidden = true;
      };
      document.addEventListener('click', closeMoreMenu);
      window.addEventListener('scroll', closeMoreMenu, { passive: true });
      window.addEventListener('resize', closeMoreMenu);
    }
    moreMenu?.addEventListener('click', (e) => e.stopPropagation());

    const tabs = Array.from(page.querySelectorAll('.acc-tab')) as HTMLElement[];
    const moreItems = Array.from(page.querySelectorAll('.acc-more-item')) as HTMLElement[];
    const panels = Array.from(page.querySelectorAll('.acc-panel')) as HTMLElement[];
    function activateTab(name: string) {
      tabs.forEach(t => {
        const tab = t.getAttribute('data-tab');
        if (tab === 'more') t.classList.toggle('active', MORE_TABS.has(name));
        else t.classList.toggle('active', tab === name);
      });
      moreItems.forEach(m => m.classList.toggle('active', m.getAttribute('data-tab') === name));
      panels.forEach(p => p.classList.toggle('active', p.getAttribute('data-panel') === name));
      syncAccountNav(name);
      if (moreMenu) moreMenu.hidden = true;
      try { localStorage.setItem('acc_tab', name); } catch (e) {}
      const url = new URL(location.href);
      if (name === 'profile') url.searchParams.delete('tab');
      else url.searchParams.set('tab', name);
      history.replaceState({}, '', url.pathname + url.search);
    }
    tabs.filter(t => t.getAttribute('data-tab') !== 'more').forEach(t => t.addEventListener('click', () => activateTab(t.getAttribute('data-tab')!)));
    moreItems.forEach(m => m.addEventListener('click', () => activateTab(m.getAttribute('data-tab')!)));
    let startTab = 'profile';
    const urlTab = new URL(location.href).searchParams.get('tab');
    const tabExists = urlTab && (page.querySelector('.acc-tab[data-tab="' + urlTab + '"]') || page.querySelector('.acc-more-item[data-tab="' + urlTab + '"]'));
    if (tabExists) startTab = urlTab!;
    else {
      try { const sv = localStorage.getItem('acc_tab'); if (sv && (page.querySelector('.acc-tab[data-tab="' + sv + '"]') || page.querySelector('.acc-more-item[data-tab="' + sv + '"]'))) startTab = sv; } catch (e) {}
    }
    activateTab(startTab);

    page.querySelectorAll('[data-recipe-del]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = (btn as HTMLElement).dataset.recipeDel!;
        if (!confirm('Удалить этот рецепт?')) return;
        const { data: { session } } = await supabase.auth.getSession();
        const token = session?.access_token;
        if (!token) { alert('Сессия истекла — обновите страницу'); return; }
        const res = await fetch(`/api/saved-brew-recipe?id=${encodeURIComponent(id)}`, {
          method: 'DELETE',
          headers: { Authorization: `Bearer ${token}` },
        });
        if (!res.ok) {
          const msg = res.status === 503 ? 'Нужна миграция Supabase (FIX-RUN-NOW.sql)' : await res.text();
          alert('Не удалось удалить: ' + msg);
          return;
        }
        init();
      });
    });
    page.querySelectorAll('[data-recipe-use]').forEach((btn) => {
      btn.addEventListener('click', () => {
        window.location.href = `/add-cup?template=${(btn as HTMLElement).dataset.recipeUse}`;
      });
    });

    if (!(window as any).__accPopBound) {
      (window as any).__accPopBound = true;
      window.addEventListener('popstate', () => {
        const root = document.getElementById('accountPage');
        if (!root?.querySelector('.acc-tab')) return;
        const tabName = new URL(location.href).searchParams.get('tab') || 'profile';
        const btn = root.querySelector('.acc-tab[data-tab="' + tabName + '"]') as HTMLElement | null
          || root.querySelector('.acc-more-item[data-tab="' + tabName + '"]') as HTMLElement | null;
        if (btn) activateTab(tabName);
      });
    }
    } catch (e: any) {
      console.error(e);
      showLoadError('Не удалось загрузить кабинет. Обновите страницу или напишите @ksenijashmel.');
    }
  }

  init();
</script>

</Layout>
