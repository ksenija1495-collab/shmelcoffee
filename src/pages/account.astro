  /* Обложка зерна работает как корешок книги на полке: страна набрана крупно и читается
     первой, обработка кодируется приглушённым тоном и точкой-маркером. Тона намеренно
     низкой насыщенности — 13 карточек в сетке должны выглядеть набором, а не мозаикой. */
  type ProcessTone = { match?: RegExp; label: string; h: number; s: number; l: number; dot: string };
  const PROCESS_LOOK: ProcessTone[] = [
    { match: /анаэроб|carbonic|мацерац|ферментир/i, label: 'анаэробная', h: 300, s: 15, l: 24, dot: '#c4a3c6' },
    { match: /натур|natural|сух/i, label: 'натуральная', h: 14, s: 26, l: 24, dot: '#d99a7e' },
    { match: /хани|honey|пульп/i, label: 'хани', h: 36, s: 28, l: 25, dot: '#dcb173' },
    { match: /мыт|washed|wet/i, label: 'мытая', h: 168, s: 15, l: 23, dot: '#94bdb2' },
  ];
  const PROCESS_DEFAULT: ProcessTone = { label: 'без обработки', h: 30, s: 8, l: 24, dot: '#bfae9b' };
  const COVER_INK = '#F2EADF';

  /* «Катимор (Catimor)» → «Катимор»: латинские дубли не помещаются и не добавляют смысла. */
  const stripLatin = (s: string) => s.replace(/\s*\([^)]*\)/g, '').trim();

  function processLook(process?: string | null): ProcessTone {
    const p = (process || '').trim();
    if (!p) return PROCESS_DEFAULT;
    return PROCESS_LOOK.find((x) => x.match!.test(p)) || { ...PROCESS_DEFAULT, label: stripLatin(p).toLowerCase() };
  }

  function countryFlag(country?: string | null): string {
    const name = (country || '').trim();
    if (!name) return '';
    for (const [, c] of Object.entries(DB) as [string, any][]) {
      if (c.name === name) return c.flag;
    }
    const key = resolveCountryKey(name, name);
    return key ? (DB as any)[key]?.flag || '' : '';
  }

  /* Внутри одной обработки тон слегка гуляет по стране — три йеменских анаэроба рядом
     не сливаются, но и не спорят друг с другом. */
  function coverBackground(look: ProcessTone, seedText: string): string {
    let seed = 0;
    for (let i = 0; i < seedText.length; i++) seed = (seed * 31 + seedText.charCodeAt(i)) % 9973;
    const h = look.h + ((seed % 9) - 4);
    const l = look.l + ((Math.floor(seed / 9) % 7) - 3);
    return `linear-gradient(157deg, hsl(${h} ${look.s}% ${l + 6}%), hsl(${h} ${look.s + 5}% ${l - 6}%))`;
  }

  function shelfBeanCover(s: any): string {
    const look = processLook(s.process);
    const country = (s.country || '').trim();
    const flag = countryFlag(country);
    const variety = stripLatin(s.variety || '');
    return `<div class="shelf-cover" style="background:${coverBackground(look, country || s.name || '')};color:${COVER_INK}">
      <div class="shelf-cover-proc"><span class="shelf-cover-dot" style="background:${look.dot}"></span>${esc(look.label)}</div>
      <div class="shelf-cover-bottom">
        <div class="shelf-cover-name">
          <div class="shelf-cover-country">${esc(country || 'Без страны')}</div>
          ${variety ? `<div class="shelf-cover-variety">${esc(variety)}</div>` : ''}
        </div>
        <div class="shelf-cover-flag">${flag || '🫘'}</div>
      </div>
    </div>`;
  }

