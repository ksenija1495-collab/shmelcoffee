---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
---

<Layout title="Личный кабинет — Shmelco" description="Профиль, карты, дневник, полка, подборки и гиды">
  <Nav />
  <div class="container">
    <div class="account-page" id="accountPage">
      <div class="account-loading" id="accountLoading">
        <div class="loader-spinner"></div>
        <p>Загрузка вашего профиля...</p>
      </div>
    </div>
  </div>
<style is:global>
  .account-page { padding-top: 88px; max-width: 820px; margin: 0 auto; min-height: 70vh; padding-bottom: 100px; }
  .account-loading { text-align: center; padding: 80px 0; color: var(--text-muted); }
  .loader-spinner { width: 28px; height: 28px; border: 2px solid var(--border); border-top-color: var(--text); border-radius: 50%; animation: spin .6s linear infinite; margin: 0 auto 16px; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .account-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px; padding-bottom: 18px; border-bottom: 1px solid var(--border); flex-wrap: wrap; gap: 12px; }
  .account-header h1 { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1.7rem; font-weight: 600; margin: 0; }
  .account-email { font-size: .76rem; color: var(--text-muted); margin-top: 2px; }
  .pro-badge { font-size: .64rem; font-weight: 800; letter-spacing: .06em; background: linear-gradient(90deg, var(--accent), var(--accent-warm)); color: #fff; padding: 4px 10px; border-radius: 20px; }
  .paid-banner { margin: 0 0 16px; padding: 14px 16px; border-radius: var(--radius); background: rgba(90,140,90,.12); border: 1px solid rgba(90,140,90,.28); font-size: .88rem; line-height: 1.55; color: var(--text); text-align: left; }
  .logout-btn { font-size: .74rem; color: var(--text-muted); background: none; border: 1px solid var(--border); padding: 6px 14px; border-radius: 6px; cursor: pointer; transition: all .2s; font-family: 'Inter', sans-serif; }
  .logout-btn:hover { border-color: var(--accent-warm); color: var(--accent-warm); }

  .acc-tabs { display: flex; gap: 6px; overflow-x: auto; padding: 2px 0 14px; margin-bottom: 22px; border-bottom: 1px solid var(--border); -webkit-overflow-scrolling: touch; scrollbar-width: thin; }
  .acc-tab { flex: 0 0 auto; padding: 9px 15px; border-radius: 10px; border: 1px solid var(--border); background: var(--surface); color: var(--text-dim); font-size: .82rem; font-weight: 600; cursor: pointer; white-space: nowrap; font-family: 'Inter', sans-serif; transition: all .15s; }
  .acc-tab:hover { border-color: var(--border-hover); color: var(--text); }
  .acc-tab.active { background: var(--text); color: var(--bg); border-color: var(--text); }
  /* На узком экране строка не помещается, а горизонтальный скролл на телефоне ничем
     не обозначен — «Открытия» и «Ещё» просто уезжали за край. Переносим в две строки. */
  @media (max-width: 768px) { .acc-tabs { flex-wrap: wrap; overflow-x: visible; } }
  .acc-panel { display: none; }
  .acc-panel.active { display: block; animation: fadein .25s ease; }
  .panel-h { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1.5rem; font-weight: 600; margin: 0 0 18px; display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; }
  .sub-h { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1.25rem; font-weight: 600; margin: 26px 0 12px; }

  .profile-card { padding: 20px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow); }
  .profile-row { display: flex; align-items: baseline; gap: 8px; margin-bottom: 8px; }
  .profile-label { font-size: .72rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: .05em; min-width: 70px; }
  .profile-value { font-size: .88rem; font-weight: 500; }
  .profile-tags { display: flex; flex-wrap: wrap; gap: 5px; }
  .profile-tag { display: inline-block; padding: 3px 10px; border-radius: 20px; background: var(--surface-2); font-size: .74rem; color: var(--text-dim); border: 1px solid var(--border); }
  .tastemap-card { display: flex; gap: 22px; align-items: center; flex-wrap: wrap; }
  .tastemap-wheel { width: 230px; height: 230px; flex-shrink: 0; }
  .tastemap-wheel path[data-cat] { cursor: pointer; transition: opacity .15s; }
  .tastemap-wheel path[data-cat]:hover { opacity: 1 !important; }
  .tastemap-side { flex: 1; min-width: 210px; }
  .tm-row { display: flex; justify-content: space-between; gap: 8px; padding: 7px 0; border-bottom: 1px solid var(--border); }
  .tm-row:last-of-type { border-bottom: 0; }
  .tm-fams { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 12px; }
  .tm-fam { display: inline-block; padding: 3px 10px; border-radius: 20px; font-size: .74rem; color: #fff; font-weight: 600; }
  .tm-hint { font-size: .74rem; color: var(--text-muted); margin-top: 10px; }
  .info-panel { margin-top: 14px; padding: 14px 16px; border-radius: 12px; background: var(--surface-2); border: 1px solid var(--border); font-size: .84rem; display: none; }
  .info-panel.show { display: block; animation: fadein .2s ease; }
  @keyframes fadein { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }
  .info-panel h4 { margin: 0 0 8px; font-size: .92rem; }
  .tm-sub { padding: 5px 0; border-bottom: 1px dashed var(--border); }
  .tm-sub:last-child { border-bottom: 0; }
  .tm-sub b { color: var(--text); }
  .tm-sub .org { color: var(--text-muted); font-size: .78rem; }
  .tm-info-hint { font-size: .72rem; color: var(--text-muted); margin: 0 0 10px; line-height: 1.45; }
  .disco-top { display: flex; align-items: center; gap: 16px; margin-bottom: 8px; }
  .disco-ring { width: 84px; height: 84px; flex-shrink: 0; }
  .disco-count { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1.5rem; font-weight: 600; }
  .disco-subtitle { font-size: .82rem; font-weight: 700; color: var(--text); margin: 18px 0 10px; }
  .disco-rec { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 8px; }
  .disco-rec-card { display: flex; flex-direction: column; gap: 3px; padding: 13px; border-radius: 10px; border: 1px solid var(--accent); background: rgba(168,124,79,.07); text-decoration: none; color: inherit; transition: all .2s; }
  .disco-rec-card:hover { box-shadow: var(--shadow-hover); transform: translateY(-1px); }
  .drc-flag { font-size: 1.5rem; }
  .drc-name { font-weight: 700; font-size: .88rem; }
  .drc-why { font-size: .72rem; color: var(--text-muted); line-height: 1.35; }
  .disco-grid { display: flex; flex-wrap: wrap; gap: 6px; }
  .disco-chip { padding: 6px 11px; border-radius: 20px; font-size: .74rem; border: 1px solid var(--border); cursor: pointer; transition: all .15s; }
  .disco-chip:hover { border-color: var(--accent); }
  .disco-chip.open { background: #e8f0e4; color: #4a7a45; border-color: #cfe0c8; font-weight: 600; }
  .disco-chip.closed { color: var(--text-muted); border-style: dashed; }
  .disco-hint { font-size: .78rem; color: var(--text-muted); margin-top: 16px; line-height: 1.55; }
  .comm-sub { font-size: .82rem; font-weight: 700; margin: 14px 0 8px; color: var(--text); }
  .comm-sub:first-child { margin-top: 0; }
  .comm-row { display: flex; align-items: center; gap: 10px; margin: 8px 0; font-size: .82rem; }
  .comm-row .l { min-width: 130px; }
  .comm-bar { flex: 1; height: 10px; background: var(--surface-2); border-radius: 6px; overflow: hidden; }
  .comm-bar > i { display: block; height: 100%; background: linear-gradient(90deg, var(--accent), var(--accent-warm)); }
  .comm-row .n { font-weight: 700; min-width: 26px; text-align: right; }
  .cup-item { padding: 12px 0; border-bottom: 1px solid var(--border); }
  .cup-item:last-child { border-bottom: 0; }
  .cup-card-link { color: var(--text); text-decoration: none; font-weight: 700; }
  .cup-card-link:hover { color: var(--accent); }
  .cup-open-card { display: inline-block; margin-top: 6px; margin-right: 12px; font-size: .72rem; font-weight: 600; color: var(--accent); text-decoration: none; }
  .cup-open-card:hover { text-decoration: underline; }
  .diary-filters { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 14px; }
  .diary-filters select {
    width: 100%; padding: 9px 11px; border: 1px solid var(--border); border-radius: 10px;
    font-size: .82rem; background: var(--bg); color: var(--text); font-family: 'Inter', sans-serif;
  }
  @media (max-width: 560px) { .diary-filters { grid-template-columns: 1fr; } }
  .shelf-search-wrap { margin-bottom: 14px; }
  .shelf-search {
    width: 100%; padding: 10px 12px; border: 1px solid var(--border); border-radius: 10px;
    font-size: .84rem; background: var(--bg); color: var(--text); font-family: 'Inter', sans-serif;
  }
  .shelf-search:focus { outline: none; border-color: var(--accent); }
  .shelf-search-empty { display: none; margin-top: 8px; }
  .brew-rec { margin-top: 10px; padding: 10px 11px; border-radius: 10px; background: var(--bg); border: 1px dashed var(--border); }
  .brew-rec-compact { margin-top: 8px; }
  .brew-rec-h { font-size: .72rem; font-weight: 700; color: var(--text); margin-bottom: 4px; }
  .brew-rec-sub { font-size: .68rem; color: var(--text-muted); margin-bottom: 8px; }
  .brew-rec-card + .brew-rec-card { margin-top: 8px; padding-top: 8px; border-top: 1px solid var(--border); }
  .brew-rec-label { font-size: .7rem; font-weight: 700; color: var(--text); }
  .brew-rec-params { font-size: .72rem; color: var(--text); margin-top: 2px; line-height: 1.35; }
  .brew-rec-time { font-size: .68rem; color: var(--text-dim); margin-top: 2px; }
  .brew-rec-note { font-size: .68rem; color: var(--text-muted); margin-top: 3px; line-height: 1.35; }
  .brew-rec-why, .brew-rec-avoid { font-size: .68rem; color: var(--text-dim); margin-top: 8px; line-height: 1.4; }
  .shelf-brew-tip > summary {
    list-style: none; cursor: pointer; font-size: .7rem; font-weight: 600; color: var(--accent);
    margin-top: 8px; padding: 4px 0;
  }
  .shelf-brew-tip > summary::-webkit-details-marker { display: none; }
  .shelf-brew-tip[open] > summary { margin-bottom: 2px; }
  .recipe-item {
    padding: 14px 0; border-bottom: 1px solid var(--border); display: flex; flex-wrap: wrap;
    gap: 10px; align-items: flex-start; justify-content: space-between;
  }
  .recipe-item:last-child { border-bottom: 0; }
  .recipe-item-h { font-weight: 700; font-size: .9rem; color: var(--text); }
  .recipe-item-sub { font-size: .76rem; color: var(--text-muted); margin-top: 4px; line-height: 1.4; }
  .recipe-item-actions { display: flex; flex-wrap: wrap; gap: 6px; }
  .recipe-act-link {
    font-size: .72rem; font-weight: 600; padding: 6px 10px; border-radius: 8px;
    border: 1px solid var(--border); background: var(--bg); color: var(--text-dim);
    text-decoration: none; cursor: pointer; font-family: 'Inter', sans-serif;
  }
  .recipe-act-link:hover { border-color: var(--accent); color: var(--accent); }
  .recipe-act-link.danger:hover { border-color: var(--accent-warm); color: var(--accent-warm); }
  .acc-recipe-block { margin-bottom: 12px; border: 1px dashed var(--border); border-radius: 12px; overflow: hidden; background: var(--bg); }
  .acc-recipe-block > summary {
    padding: 12px 14px; font-size: .82rem; font-weight: 700; color: var(--text); cursor: pointer;
    list-style: none; user-select: none; display: flex; align-items: center; justify-content: space-between;
  }
  .acc-recipe-block > summary::-webkit-details-marker { display: none; }
  .acc-recipe-block > summary::after { content: '▼'; font-size: .62rem; opacity: .55; transition: transform .2s; }
  .acc-recipe-block[open] > summary::after { transform: rotate(180deg); }
  .acc-recipe-block-body { padding: 0 12px 12px; }
  .acc-champ-brew { margin-bottom: 8px; border: 1px solid var(--border); border-radius: 10px; overflow: hidden; }
  .acc-champ-brew > summary {
    padding: 9px 12px; font-size: .78rem; font-weight: 600; color: var(--text-dim); cursor: pointer; list-style: none;
    display: flex; justify-content: space-between; align-items: center; background: var(--surface);
  }
  .acc-champ-brew > summary::-webkit-details-marker { display: none; }
  .acc-champ-count { font-size: .68rem; font-weight: 700; color: var(--text-muted); background: var(--surface-2); padding: 2px 8px; border-radius: 12px; }
  .acc-champ-list { display: flex; flex-direction: column; gap: 6px; padding: 8px 10px 10px; }
  .acc-champ-item {
    display: block; padding: 10px 12px; border-radius: 10px; border: 1px solid var(--border);
    background: var(--surface); text-decoration: none; color: inherit; transition: .12s;
  }
  .acc-champ-item:hover { border-color: var(--accent); }
  .acc-champ-item-title { display: block; font-size: .8rem; font-weight: 700; color: var(--text); }
  .acc-champ-item-sub { display: block; font-size: .68rem; color: var(--accent); margin-top: 2px; font-weight: 600; }
  .acc-champ-more { display: inline-block; margin-top: 4px; font-size: .76rem; font-weight: 600; color: var(--accent); text-decoration: none; }
  .acc-champ-more:hover { text-decoration: underline; }
  .migration-box {
    padding: 14px 16px; border-radius: 12px; border: 1px solid rgba(181,112,77,.35);
    background: rgba(181,112,77,.08); font-size: .8rem; line-height: 1.55; color: var(--text-dim);
  }
  .migration-box b { color: var(--text); }
  .migration-box ol { margin: 8px 0 10px 18px; }
  .migration-box a { color: var(--accent); font-weight: 600; }
  .cup-head { font-weight: 700; font-size: .9rem; color: var(--text); }
  .cup-star { color: #E0B81E; font-size: .82rem; }
  .add-cup-btn { font-size: .76rem; padding: 7px 14px; border-radius: 6px; background: var(--text); color: var(--bg); border: 1px solid var(--text); cursor: pointer; text-decoration: none; transition: all .2s; }
  .add-cup-btn:hover { background: var(--accent); border-color: var(--accent); }
  .shelf-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; }
  .shelf-card { position: relative; background: var(--surface); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; box-shadow: var(--shadow); }
  .shelf-photo { width: 100%; height: 120px; object-fit: cover; display: block; }
  .shelf-noimg { width: 100%; height: 120px; display: flex; align-items: center; justify-content: center; font-size: 2.4rem; background: var(--surface-2); }
  .shelf-cover {
    position: relative; overflow: hidden; width: 100%; height: 120px; padding: 11px 13px 13px;
    display: flex; flex-direction: column; justify-content: space-between;
  }
  /* Кольца высот + мягкий свет сверху: фактура вместо плоской заливки, одинаковая для всех обложек. */
  .shelf-cover::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background:
      repeating-radial-gradient(circle at 92% 122%, rgba(248,247,237,.055) 0 1px, transparent 1px 12px),
      radial-gradient(120% 100% at 8% -30%, rgba(248,247,237,.15), transparent 62%);
  }
  /* Правый верхний угол занят кнопкой удаления — обложка туда не заходит. */
  .shelf-cover-proc {
    position: relative; display: flex; align-items: center; gap: 6px;
    padding-right: 26px; font-size: .58rem; font-weight: 700; letter-spacing: .12em;
    text-transform: uppercase; opacity: .82; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .shelf-cover-dot { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; }
  .shelf-cover-flag { font-size: 1.05rem; line-height: 1; flex-shrink: 0; opacity: .9; }
  .shelf-cover-bottom { position: relative; display: flex; align-items: flex-end; justify-content: space-between; gap: 8px; }
  .shelf-cover-name { min-width: 0; }
  .shelf-cover-country {
    font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1.3rem; font-weight: 600;
    line-height: 1.08; letter-spacing: .02em; overflow-wrap: anywhere;
  }
  .shelf-cover-variety {
    font-size: .62rem; line-height: 1.3; opacity: .62; margin-top: 3px;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .shelf-body { padding: 10px 12px; }
  .shelf-name { font-weight: 700; font-size: .82rem; color: var(--text); }
  .shelf-meta { font-size: .72rem; color: var(--text-muted); margin-top: 2px; }
  .shelf-guide-btn { margin-top: 9px; width: 100%; font-size: .7rem; padding: 6px 10px; border-radius: 6px; border: 1px solid var(--border); background: var(--surface); color: var(--text-dim); cursor: pointer; font-family: 'Inter', sans-serif; transition: all .2s; }
  .shelf-guide-btn:hover { border-color: var(--accent); color: var(--accent); }
  .shelf-del { position: absolute; top: 6px; right: 6px; width: 24px; height: 24px; border-radius: 50%; border: 0; background: rgba(0,0,0,.5); color: #fff; cursor: pointer; font-size: 15px; line-height: 1; }
  .shelf-status { margin-top: 8px; width: 100%; font-size: .68rem; font-weight: 600; padding: 5px 8px; border-radius: 6px; border: 1px solid var(--border); background: var(--surface-2); color: var(--text-dim); cursor: pointer; font-family: 'Inter', sans-serif; transition: all .2s; }
  .shelf-status:hover { border-color: var(--text-dim); }
  .shelf-status.st-low { border-color: #d99a2b; background: rgba(217,154,43,.12); color: #a9751a; }
  .shelf-status.st-out { border-color: var(--border); background: transparent; color: var(--text-muted); }
  .shelf-card.shelf-st-low { border-color: #d99a2b; }
  .shelf-card.shelf-st-out { opacity: .55; }
  .shelf-card.shelf-st-out:hover { opacity: 1; }
  .shelf-low-count { display: inline-block; margin-left: 6px; font-size: .66rem; font-weight: 700; padding: 2px 7px; border-radius: 999px; background: rgba(217,154,43,.16); color: #a9751a; vertical-align: middle; }
  .selection-card { padding: 20px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow); margin-bottom: 12px; transition: border-color .2s; }
  .selection-card:hover { border-color: var(--border-hover); }
  .selection-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; flex-wrap: wrap; gap: 8px; }
  .selection-date { font-size: .76rem; color: var(--text-muted); }
  .selection-format { font-size: .72rem; padding: 3px 10px; border-radius: 20px; background: var(--surface-2); color: var(--text-dim); }
  .status-badge { display: inline-block; padding: 3px 10px; border-radius: 20px; font-size: .7rem; font-weight: 600; }
  .status-selected { background: var(--surface-2); color: var(--text-dim); }
  .status-ordered { background: #e8f0e4; color: #4a7a45; }
  .status-received { background: #fef3e2; color: #9a6e2e; }
  .status-tasted { background: #e8e4f0; color: #6b5a8a; }
  .coffee-list { display: flex; flex-direction: column; gap: 8px; }
  .coffee-item { display: flex; align-items: flex-start; justify-content: space-between; padding: 12px 14px; background: var(--surface-2); border-radius: 8px; gap: 10px; }
  .coffee-name { font-weight: 600; font-size: .86rem; }
  .coffee-detail { font-size: .74rem; color: var(--text-dim); margin-top: 2px; }
  .coffee-why { font-size: .72rem; color: var(--accent); margin-top: 4px; font-style: italic; }
  .coffee-price { font-weight: 600; font-size: .86rem; white-space: nowrap; }
  .coffee-buy { display: inline-flex; align-items: center; padding: 4px 10px; border-radius: 5px; background: var(--text); color: var(--bg); font-size: .7rem; font-weight: 600; text-decoration: none; transition: background .2s; }
  .coffee-buy:hover { background: var(--accent); }
  .coffee-shelf-one { font-size: .68rem; padding: 3px 9px; border-radius: 5px; border: 1px solid var(--border); background: var(--surface); color: var(--text-dim); cursor: pointer; }
  .coffee-shelf-one:hover { border-color: var(--accent); color: var(--accent); }
  .selection-actions { margin-top: 14px; display: flex; gap: 8px; flex-wrap: wrap; }
  .sel-action-btn { font-size: .76rem; padding: 7px 16px; border-radius: 6px; border: 1px solid var(--border); background: var(--surface); cursor: pointer; transition: all .2s; font-family: 'Inter', sans-serif; color: var(--text-dim); }
  .sel-action-btn:hover { border-color: var(--accent); color: var(--accent); }
  .sel-action-btn.primary { background: var(--text); color: var(--bg); border-color: var(--text); }
  .sel-action-btn.primary:hover { background: var(--accent); border-color: var(--accent); }
  .sel-action-btn.sel-del:hover { border-color: var(--accent-warm); color: var(--accent-warm); }
  .guide-card { padding: 20px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow); margin-bottom: 12px; }
  .guide-date { font-size: .72rem; color: var(--text-muted); margin-bottom: 10px; }
  .guide-content { font-size: .86rem; line-height: 1.75; color: var(--text); }
  .empty-state { text-align: center; padding: 32px 20px; color: var(--text-muted); font-size: .84rem; background: var(--surface); border-radius: var(--radius); border: 1px solid var(--border); line-height: 1.6; }
  .empty-state a { color: var(--accent); font-weight: 600; }
  .selection-total { text-align: right; font-size: .82rem; color: var(--text-dim); margin-top: 10px; padding-top: 10px; border-top: 1px solid var(--border); }
  .selection-total strong { font-size: .95rem; color: var(--text); }

  .general-guide { margin-bottom: 20px; }
