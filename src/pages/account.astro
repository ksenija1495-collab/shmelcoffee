      <div class="acc-tabs" id="accTabs">
        <button class="acc-tab" data-tab="profile">🎯 Профиль</button>
        <button class="acc-tab" data-tab="taste">🗺️ Карта вкуса</button>
        <button class="acc-tab" data-tab="disco">🧭 Открытия</button>
        <button class="acc-tab" data-tab="diary">📔 Дневник</button>
        <button class="acc-tab" data-tab="shelf">🪵 Полка</button>
        <button class="acc-tab" data-tab="selections">☕ Подборки</button>
        <button class="acc-tab" data-tab="guides">📖 Гиды</button>
        <button class="acc-tab" data-tab="community">🌐 Сообщество</button>
      </div>

      <section class="acc-panel" data-panel="profile"><div class="panel-h">🎯 Вкусовой профиль</div>${profilePanel}</section>
      <section class="acc-panel" data-panel="taste"><div class="panel-h">🗺️ Карта вкуса</div>${tastePanel}</section>
      <section class="acc-panel" data-panel="disco"><div class="panel-h">🧭 Карта открытий</div>${discoPanel}</section>
      <section class="acc-panel" data-panel="diary"><div class="panel-h"><span>📔 Моё кофе</span><a href="/add-cup" class="add-cup-btn">+ Добавить чашку</a></div>${diaryPanel}</section>
      <section class="acc-panel" data-panel="shelf"><div class="panel-h"><span>🪵 Моя полка</span><span style="display:flex;gap:6px"><a href="/add-shelf?kind=bean" class="add-cup-btn">+ Зерно</a><a href="/add-shelf?kind=equipment" class="add-cup-btn">+ Оборудование</a></span></div>${shelfPanel}</section>
      <section class="acc-panel" data-panel="selections"><div class="panel-h">☕ Мои подборки</div>${selectionsPanel}</section>
      <section class="acc-panel" data-panel="guides"><div class="panel-h">📖 Гиды</div>${guidesPanel}</section>
      <section class="acc-panel" data-panel="community"><div class="panel-h">🌐 Сообщество</div><div class="profile-card" id="communityCard"><div class="profile-label" style="min-width:0">Загружаем статистику…</div></div></section>
    `;

    renderTasteWheel(prefFams);
    loadCommunity();
    page.querySelectorAll('.disco-chip[data-k]').forEach(ch => { ch.addEventListener('click', () => showCountry((ch as HTMLElement).getAttribute('data-k')!)); });
    document.getElementById('logoutBtn')?.addEventListener('click', async () => { await supabase.auth.signOut(); window.location.href = '/'; });

    page.querySelectorAll('.gr-tab').forEach(t => t.addEventListener('click', () => {
      const key = (t as HTMLElement).getAttribute('data-gt')!;
      const card = (t as HTMLElement).closest('.guide-rich'); if (!card) return;
      card.querySelectorAll('.gr-tab').forEach(x => x.classList.toggle('active', x.getAttribute('data-gt') === key));
      card.querySelectorAll('.gr-pane').forEach(p => p.classList.toggle('active', p.getAttribute('data-gp') === key));
    }));

    page.querySelectorAll('[data-buy]').forEach(b => b.addEventListener('click', () => {
      if (buyUrl) { window.open(buyUrl, '_blank'); }
      else { alert('Оплата скоро будет доступна. Напишите нам в Telegram @ksenijashmel.'); }
    }));

    page.querySelectorAll('[data-shelf-del]').forEach(b => b.addEventListener('click', async () => { await supabase.from('shelf_items').delete().eq('id', (b as HTMLElement).dataset.shelfDel); init(); }));
    page.querySelectorAll('[data-sel-del]').forEach(b => b.addEventListener('click', async () => { if (!confirm('Удалить подборку?')) return; await supabase.from('coffee_selections').delete().eq('id', (b as HTMLElement).dataset.selDel); init(); }));
    page.querySelectorAll('[data-shelf-all]').forEach(b => b.addEventListener('click', async () => { const sel = selections.find((s: any) => s.id === (b as HTMLElement).dataset.shelfAll); if (!sel) return; const rows = (sel.coffees || []).map((c: any) => ({ user_id: user.id, kind: 'bean', name: c.name || 'Кофе', roaster: c.roaster || null, country: c.origin || null, process: c.process || null, source: 'selection' })); if (rows.length) await supabase.from('shelf_items').insert(rows); init(); }));
    page.querySelectorAll('.coffee-shelf-one').forEach(b => b.addEventListener('click', async () => { const el = b as HTMLElement; const sel = selections.find((s: any) => s.id === el.dataset.sid); if (!sel) return; const c = (sel.coffees || [])[parseInt(el.dataset.ci!)]; if (!c) return; await addCoffeeToShelf(user, c); el.textContent = '✓ на полке'; (el as HTMLButtonElement).disabled = true; }));

    page.querySelectorAll('[data-action]').forEach(btn => {
      btn.addEventListener('click', async () => {
        const action = (btn as HTMLElement).dataset.action!;
        const id = (btn as HTMLElement).dataset.id!;
        if (action === 'generate') {
          (btn as HTMLButtonElement).disabled = true; (btn as HTMLButtonElement).textContent = 'Генерация...';
          try { const res = await fetch('/api/generate-guide', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ selectionId: id }) }); if (res.status === 402) { alert('Нужен оплаченный гид. Нажми «Купить гид · 99 ₽».'); init(); return; } if (!res.ok) throw new Error(await res.text()); init(); }
          catch (e: any) { alert('Ошибка генерации: ' + e.message); (btn as HTMLButtonElement).disabled = false; (btn as HTMLButtonElement).textContent = '🤖 Сгенерировать гид'; }
        } else {
          (btn as HTMLButtonElement).disabled = true;
          await supabase.from('coffee_selections').update({ status: action, updated_at: new Date().toISOString() }).eq('id', id);
          if (action === 'ordered') { const s = selections.find((x: any) => x.id === id); if (s) { const rows = (s.coffees || []).map((c: any) => ({ user_id: user.id, kind: 'bean', name: c.name || 'Кофе', roaster: c.roaster || null, country: c.origin || null, process: c.process || null, source: 'selection' })); if (rows.length) await supabase.from('shelf_items').insert(rows); } }
          init();
        }
      });
    });

    const tabs = Array.from(page.querySelectorAll('.acc-tab')) as HTMLElement[];
    const panels = Array.from(page.querySelectorAll('.acc-panel')) as HTMLElement[];
    function activateTab(name: string) {
      tabs.forEach(t => t.classList.toggle('active', t.getAttribute('data-tab') === name));
      panels.forEach(p => p.classList.toggle('active', p.getAttribute('data-panel') === name));
      try { localStorage.setItem('acc_tab', name); } catch (e) {}
    }
    tabs.forEach(t => t.addEventListener('click', () => activateTab(t.getAttribute('data-tab')!)));
    let startTab = 'profile';
    try { const sv = localStorage.getItem('acc_tab'); if (sv && page.querySelector('.acc-tab[data-tab="' + sv + '"]')) startTab = sv; } catch (e) {}
    activateTab(startTab);
  }

  init();
</script>
