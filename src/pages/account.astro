  function guideWord(n: number): string { const a = Math.abs(n) % 100, b = a % 10; if (a > 10 && a < 20) return 'гидов'; if (b > 1 && b < 5) return 'гида'; if (b === 1) return 'гид'; return 'гидов'; }

