<script>
  import { createClient } from '@supabase/supabase-js';
  import { wheelData } from '../data/wheel';
  import { DB, countryOrder } from '../data/countries';
  import { generalGuide } from '../data/generalGuide';
  import { BREW_METHODS, FAMILY_ICON } from '../data/methods';
  import { buildProdamusBuyUrl } from '../lib/prodamusBuyUrl';
  import { beanOutUrl } from '../lib/beanOutUrl';
  import { formatCupRecipe, recipeFingerprint, applyRecipeToParams } from '../lib/cupRecipe';
  import { formatTasteCharacterLine, normalizeTasteCharacter } from '../lib/tasteCharacter';
  import { savedRecipeSummary } from '../lib/savedRecipesUi';
  import { resolveCountryKey } from '../lib/countryResolve';
  import { fetchSavedBrewRecipes } from '../lib/savedBrewRecipeApi';
  import { CHAMPION_PICKER_ITEMS } from '../data/championRecipePicker';
  import { recommendBrew, renderBrewRecHtml, formatBrewRecCompact } from '../lib/brewRecommend';

  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
    { auth: { flowType: 'implicit' } }
  );
  const PRODAMUS_URL = (import.meta.env.PUBLIC_PRODAMUS_URL as string) || '';

  const page = document.getElementById('accountPage')!;

  const FLAVOR_TO_FAM: Record<string, string[]> = { fruity: ['Ягоды','Цитрус','Фрукты'], floral: ['Цветочный'], chocolate: ['Ореховый'], caramel: ['Сладкий'], spicy: ['Пряный','Обжарочный'], tropical: ['Фрукты'] };
  const FLAVOR_LABELS: Record<string, string> = { fruity: 'Фруктовые', floral: 'Цветочные и чайные', chocolate: 'Шоколад и орехи', caramel: 'Карамель и мёд', spicy: 'Пряные', tropical: 'Тропические' };
  const ACID: Record<string, string> = { high: 'Яркая, сочная', medium: 'Сбалансированная', low: 'Мягкая, гладкая' };
  const BODY: Record<string, string> = { light: 'Лёгкое, чайное', med: 'Среднее, шелковистое', heavy: 'Плотное, сиропистое' };
  const SWEET: Record<string, string> = { fruitSw: 'Фруктовая', honeySw: 'Медовая, карамельная', chocoSw: 'Шоколадная', drySw: 'Сухая, ореховая' };

  const METHOD_BY_LABEL: Record<string, any> = {};
  (BREW_METHODS as any[]).forEach((m) => { METHOD_BY_LABEL[m.label] = m; });
  const FLAG_BY_NAME: Record<string, string> = {};
  for (const [, c] of Object.entries(DB) as [string, any][]) FLAG_BY_NAME[c.name] = c.flag;
  const esc = (s: any) => String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');
  const asNoteList = (notes: unknown): string[] =>
    Array.isArray(notes) ? notes : notes ? [String(notes)] : [];
  const isFetchError = (msg?: string | null) =>
    !!msg && /fetch failed|failed to fetch|network|ENOTFOUND|NXDOMAIN/i.test(msg);

  function renderChampionRecipesBlock(): string {
    const byBrew = new Map<string, typeof CHAMPION_PICKER_ITEMS>();
    for (const item of CHAMPION_PICKER_ITEMS) {
      const list = byBrew.get(item.brewMethod) || [];
      list.push(item);
      byBrew.set(item.brewMethod, list);
    }
    const brews = [...byBrew.keys()].sort((a, b) => a.localeCompare(b, 'ru'));
    const inner = brews.map((brew) => {
      const items = byBrew.get(brew)!;
      return `<details class="acc-champ-brew">
        <summary><span>${esc(brew)}</span><span class="acc-champ-count">${items.length}</span></summary>
        <div class="acc-champ-list">${items.map((item) => {
          const q = applyRecipeToParams(item.recipe as any, item.brewMethod);
          return `<a class="acc-champ-item" href="/add-cup?${q.toString()}">
            <span class="acc-champ-item-title">${esc(item.methodIcon)} ${esc(item.title)}</span>
            <span class="acc-champ-item-sub">${esc(item.badgeText)} · ${esc(item.methodName)}</span>
          </a>`;
        }).join('')}</div>
      </details>`;
    }).join('');
    return `<details class="acc-recipe-block acc-champ-block">
      <summary><span>🏆 Чемпионские</span><span class="acc-champ-count">${CHAMPION_PICKER_ITEMS.length}</span></summary>
      <div class="acc-recipe-block-body">${inner}<a class="acc-champ-more" href="/blog/chempionskie-recepty">Все в блоге →</a></div>
    </details>`;
  }

  function migrationRecipesBox(): string {
    return `<div class="migration-box"><b>Сохранённые рецепты недоступны — нужна миграция в Supabase</b>
      <ol>
        <li>Открой <a href="https://supabase.com/dashboard/project/vakdjxdbfoxkrsedgwcl/sql/new" target="_blank" rel="noopener">SQL Editor</a></li>
        <li>Вставь файл <code>supabase/FIX-RUN-NOW.sql</code> из репозитория</li>
        <li>Нажми Run → обнови эту страницу</li>
      </ol>
      Чемпионские рецепты ниже работают без миграции.</div>`;
  }

  function showLoadError(message: string) {
    page.innerHTML = `<div class="account-loading"><p style="max-width:420px;margin:0 auto 16px;line-height:1.55">${esc(message)}</p><button type="button" class="logout-btn" id="retryAccount">Повторить</button></div>`;
    document.getElementById('retryAccount')?.addEventListener('click', () => init());
  }

  function renderGuide(content: string, gid: string, dateStr: string): string {
    const actions = `<div class="gr-actions"><button class="gr-icon-btn" data-guide-toggle="${gid}" title="Свернуть">▾</button><button class="gr-icon-btn gr-del" data-guide-del="${gid}" title="Удалить">✕</button></div>`;
    let data: any = null;
    try { const p = JSON.parse(content); if (p && (Array.isArray(p.beans) || Array.isArray(p.methods))) data = p; } catch (e) {}
    if (!data) return `<div class="guide-card" data-gid="${gid}"><div class="gr-top"><div class="guide-date" style="margin:0">${dateStr}</div>${actions}</div><div class="gr-body"><div class="guide-content">${content}</div></div></div>`;

    const beansHtml = (data.beans || []).map((b: any) => {
      const flag = FLAG_BY_NAME[esc(b.country)] || '';
      const fam = (FAMILY_ICON as any)[esc(b.family)] || '';
      const ico = flag || fam || '☕';
      const sub = [b.variety, b.roaster, b.country].filter(Boolean).map(esc).join(' · ');
      const tags = (b.tags || []).map((t: string) => `<span class="gb-tag">${esc(t)}</span>`).join('');
      return `<div class="gb-card"><div class="gb-head"><span class="gb-ico">${ico}${(fam && flag) ? ' ' + fam : ''}</span><div><div class="gb-name">${esc(b.name)}</div>${sub ? `<div class="gb-roaster">${sub}</div>` : ''}</div></div>${b.expect ? `<div class="gb-expect">${esc(b.expect)}</div>` : ''}${tags ? `<div class="gb-tags">${tags}</div>` : ''}${b.brewTip ? `<div class="gb-tip">💡 ${esc(b.brewTip)}</div>` : ''}</div>`;
    }).join('');

    const methodsHtml = (data.methods || []).map((m: any) => {
      const md = METHOD_BY_LABEL[esc(m.name)] || null;
      const ico = md ? md.ico : '⚙️';
      const grind = md ? md.grind : (m.grind || '');
      const ratio = md ? md.ratio : (m.ratio || '');
      const temp = md ? md.temp : (m.temp || '');
      const time = md ? md.time : (m.time || '');
      const steps: string[] = md ? md.steps : (m.steps || []);
      const params = ([['Помол', grind], ['Пропорция', ratio], ['Вода', temp], ['Время', time]] as [string, string][]).filter(p => p[1]).map(p => `<div class="gm-param"><span>${p[0]}</span><b>${esc(p[1])}</b></div>`).join('');
      const stepsHtml = (steps || []).map((s: string) => `<li>${esc(s)}</li>`).join('');
      const perBean = (m.perBean || []).map((pb: any) => `<div class="gm-pb"><b>${esc(pb.bean)}:</b> ${esc(pb.tip)}</div>`).join('');
      return `<div class="gm-card"><div class="gm-head"><span class="gb-ico">${ico}</span><div class="gm-name">${esc(m.name)}</div></div>${params ? `<div class="gm-params">${params}</div>` : ''}${stepsHtml ? `<ol class="gm-steps">${stepsHtml}</ol>` : ''}${perBean ? `<div class="gm-perbean"><div class="gm-pb-h">Под твои зёрна</div>${perBean}</div>` : ''}</div>`;
    }).join('');

    const plan = data.weekPlan || [];
    const planHtml = plan.map((d: any) => `<div class="gp-day"><div class="gp-dn">${esc(d.day)}</div><div class="gp-dmain">${esc(d.bean)} · ${esc(d.method)}</div>${d.focus ? `<div class="gp-df">${esc(d.focus)}</div>` : ''}</div>`).join('');
    const tips = (data.nextTips || []).map((t: string) => `<li>${esc(t)}</li>`).join('');
    const hasPlan = plan.length > 0;

    return `<div class="guide-card guide-rich" data-gid="${gid}">
      <div class="gr-top"><div><div class="guide-date" style="margin:0">${dateStr}</div><h3 class="gr-title">${esc(data.title || 'Персональный гид по кофе')}</h3></div>${actions}</div>
      <div class="gr-body">
        <div class="gr-tabs">
          <button class="gr-tab active" data-gt="${gid}|beans">☕ Зёрна</button>
          <button class="gr-tab" data-gt="${gid}|methods">⚗️ Способы</button>
          ${hasPlan ? `<button class="gr-tab" data-gt="${gid}|plan">📅 План недели</button>` : ''}
        </div>
        <div class="gr-pane active" data-gp="${gid}|beans"><div class="gb-grid">${beansHtml}</div></div>
        <div class="gr-pane" data-gp="${gid}|methods"><div class="gm-grid">${methodsHtml}</div></div>
        ${hasPlan ? `<div class="gr-pane" data-gp="${gid}|plan"><div class="gp-grid">${planHtml}</div></div>` : ''}
        ${tips ? `<div class="gr-next"><div class="gr-next-h">Что попробовать дальше</div><ul>${tips}</ul></div>` : ''}
      </div>
    </div>`;
  }

  function calcTop(answers: any): string[] {
    if (!answers) return [];
    const scores: Record<string, number> = {};
    for (const [k, c] of Object.entries(DB) as [string, any][]) {
      let s = 0;
      (answers.flavors || []).forEach((f: string) => { s += (c.sc[f] || 0); });
      if (answers.acidity) s += (c.sc[answers.acidity] || 0);
      if (answers.body) s += (c.sc[answers.body] || 0);
      if (answers.sweetness) s += (c.sc[answers.sweetness] || 0);
      scores[k] = s;
    }
    return Object.entries(scores).sort((a, b) => b[1] - a[1]).map(([k]) => k);
  }

  function ringSVG(open: number, total: number): string {
    const pct = total ? open / total : 0; const C = 2 * Math.PI * 36;
    return `<svg width="84" height="84" viewBox="0 0 84 84"><circle cx="42" cy="42" r="36" fill="none" stroke="var(--border)" stroke-width="8"/><circle cx="42" cy="42" r="36" fill="none" stroke="var(--accent)" stroke-width="8" stroke-linecap="round" stroke-dasharray="${C}" stroke-dashoffset="${C * (1 - pct)}" transform="rotate(-90 42 42)"/><text x="42" y="48" text-anchor="middle" font-family="'Cormorant Garamond',serif" font-size="17" font-weight="700" fill="var(--text)">${Math.round(pct * 100)}%</text></svg>`;
  }

  function showFamily(idx: number) {
    const cat: any = wheelData[idx]; const el = document.getElementById('tmInfo'); if (!el || !cat) return;
    el.innerHTML = `<h4 style="color:${cat.color}">${cat.name}</h4><p class="tm-info-hint">Справочник — ноты добавляются при записи чашки, не здесь.</p>` + cat.subs.map((s: any) => `<div class="tm-sub"><b>${s.name}</b> <span class="org">— ${s.org}</span></div>`).join('');
    el.classList.add('show');
    const svg = document.getElementById('tasteWheel');
    svg?.querySelectorAll('path[data-type="cat"]').forEach((p) => {
      const i = parseInt((p as SVGPathElement).getAttribute('data-cat') || '-1', 10);
      const on = i === idx;
      (p as SVGPathElement).setAttribute('opacity', on ? '1' : '0.22');
      (p as SVGPathElement).setAttribute('stroke-width', on ? '2' : '1');
    });
  }

  function renderTasteWheel(prefFams: Set<string>) {
    const svg = document.getElementById('tasteWheel'); if (!svg) return;
    const cx = 180, cy = 180, ir1 = 46, ir2 = 162, gap = 1.4;
    const n = wheelData.length, catAng = 360 / n;
    const p2 = (r: number, deg: number) => { const rad = (deg - 90) * Math.PI / 180; return { x: cx + r * Math.cos(rad), y: cy + r * Math.sin(rad) }; };
    const sector = (ri: number, ro: number, a1: number, a2: number) => { const A = p2(ro, a1), B = p2(ro, a2), C = p2(ri, a2), D = p2(ri, a1); const lg = (a2 - a1) > 180 ? 1 : 0; return `M${A.x},${A.y} A${ro},${ro},0,${lg},1,${B.x},${B.y} L${C.x},${C.y} A${ri},${ri},0,${lg},0,${D.x},${D.y}Z`; };
    let html = `<circle cx="${cx}" cy="${cy}" r="${ir1 - 6}" fill="var(--surface-2)"/><text x="${cx}" y="${cy}" text-anchor="middle" dominant-baseline="middle" font-family="'Cormorant Garamond',serif" font-size="14" font-weight="600" fill="var(--text)" style="pointer-events:none">ВКУС</text>`;
    wheelData.forEach((cat: any, i: number) => {
      const a1 = i * catAng + gap, a2 = (i + 1) * catAng - gap;
      const on = prefFams.has(cat.name);
      html += `<path d="${sector(ir1, ir2, a1, a2)}" fill="${cat.color}" opacity="${on ? 1 : 0.2}" stroke="#fff" stroke-width="1" data-cat="${i}" data-type="cat" style="cursor:pointer"><title>${cat.name}</title></path>`;
      const mid = (a1 + a2) / 2, pos = p2((ir1 + ir2) / 2, mid);
      let rot = mid; if (rot > 90 && rot < 270) rot += 180;
      html += `<text x="${pos.x}" y="${pos.y}" text-anchor="middle" dominant-baseline="middle" transform="rotate(${rot},${pos.x},${pos.y})" font-family="'Inter',sans-serif" font-size="9.5" font-weight="600" fill="#3b2a1c" opacity="${on ? 1 : 0.55}" style="pointer-events:none">${cat.name}</text>`;
    });
    svg.innerHTML = html;
    svg.querySelectorAll('path[data-type="cat"]').forEach((p) => {
      p.addEventListener('click', (e) => {
        e.stopPropagation();
        showFamily(parseInt((p as SVGPathElement).getAttribute('data-cat')!, 10));
      });
    });
  }

