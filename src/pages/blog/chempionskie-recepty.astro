---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import { recipesData } from '../../data/recipes';
import {
  champParamOrder,
  paramLabels,
  recipeDisplayText,
  recipeQuery,
  resolveRecipeTab,
} from '../../lib/recipePageHelpers';

const activeTab = resolveRecipeTab(recipesData, Astro.url.searchParams);
---

<Layout
  title="Банк чемпионских рецептов — Shmelco"
  description="Рецепты чемпионов World Brewers Cup, AeroPress Championship и классика — V60, Hario Switch, аэропресс, кемекс, эспрессо, турка."
  keywords={['рецепт аэропресса', 'чемпионский рецепт кофе', 'V60 рецепт', 'Hario Switch рецепт', 'world brewers cup']}
>
  <Nav />
  <div class="container champ-page">
    <a href="/blog" class="champ-back">← В блог</a>
    <nav class="champ-breadcrumb" aria-label="Навигация">
      <a href="/blog">Блог</a> <span>›</span> <span>Чемпионские рецепты</span>
    </nav>
    <div class="champ-hero">
      <h1>Банк чемпионских рецептов</h1>
      <p class="champ-hero-sub">Проверенные схемы чемпионов и классика — по методам заваривания. Сохраняй в дневник и повторяй.</p>
    </div>

    <div class="recipe-tabs" id="recipeTabs" role="tablist" aria-label="Метод заваривания">
      {Object.entries(recipesData).map(([key, method]) => (
        <button
          type="button"
          class:list={['recipe-tab', { active: key === activeTab }]}
          data-tab={key}
          role="tab"
          aria-selected={key === activeTab}
        >
          {method.icon} {method.name}
        </button>
      ))}
    </div>

    {Object.entries(recipesData).map(([methodKey, method]) => {
      const champions = method.recipes.filter((r) => r.badge === 'champion');
      const others = method.recipes.filter((r) => r.badge !== 'champion');
      return (
        <div
          class="champ-method-panel"
          data-panel={methodKey}
          hidden={methodKey !== activeTab}
          role="tabpanel"
        >
          <div class="champ-cards">
            {champions.map((r) => (
              <article class={`champ-card champ-card--${methodKey}`}>
                <div class="champ-card-bg" />
                <div class="champ-card-inner">
                  <span class="champ-method">{recipeDisplayText(method.methodLabel)}: ЧЕМПИОН</span>
                  <h2 class="champ-title">{recipeDisplayText(r.title)}</h2>
                  <p class="champ-tagline">{recipeDisplayText(r.tagline || r.sub)}</p>
                  {(r.highlights?.length ?? 0) > 0 && (
                    <ul class="champ-highlights">
                      {r.highlights!.map((h) => (
                        <li>{recipeDisplayText(h)}</li>
                      ))}
                    </ul>
                  )}
                  <div class="champ-params recipe-params">
                    {champParamOrder.filter((k) => r.params[k]).map((k) => (
                      <div class:list={['recipe-param', { 'recipe-param--grind': k === 'grind' }]}>
                        <div class="recipe-param-label">{paramLabels[k] || k}</div>
                        <div class="recipe-param-value">{recipeDisplayText(r.params[k])}</div>
                      </div>
                    ))}
                  </div>
                  <ol class="champ-steps">
                    {r.steps.map((s) => (
                      <li>{recipeDisplayText(s)}</li>
                    ))}
                  </ol>
                  {r.profile && (
                    <div class="champ-profile">
                      <b>Профиль:</b> {recipeDisplayText(r.profile)}
                      {(r.profileTags?.length ?? 0) > 0 && (
                        <div class="champ-profile-tags">
                          {r.profileTags!.map((t) => (
                            <span class="champ-profile-tag">{t.emoji} {recipeDisplayText(t.label)}</span>
                          ))}
                        </div>
                      )}
                    </div>
                  )}
                  <a class="champ-use-btn" href={recipeQuery(methodKey, r, recipesData)}>
                    Записать чашку по рецепту →
                  </a>
                </div>
                <div class="champ-watermark">@shmelcoffee</div>
              </article>
            ))}
          </div>

          {others.length > 0 && (
            <div class="champ-classic-block">
              <div class="classic-block-h">Классика и простые рецепты</div>
              {others.map((r, idx) => (
                <div class="recipe-card" id={`rc-${methodKey}-${idx}`}>
                  <button type="button" class="recipe-card-header" data-method={methodKey} data-idx={idx}>
                    <div class="recipe-card-left">
                      <span class={`recipe-badge ${r.badge}`}>{recipeDisplayText(r.badgeText)}</span>
                      <div>
                        <div class="recipe-card-title">{recipeDisplayText(r.title)}</div>
                        <div class="recipe-card-sub">{recipeDisplayText(r.sub)}</div>
                      </div>
                    </div>
                    <span class="recipe-chevron">▼</span>
                  </button>
                  <div class="recipe-card-body">
                    <div class="recipe-params">
                      {Object.entries(r.params).map(([pk, pv]) => (
                        <div class="recipe-param">
                          <div class="recipe-param-label">{paramLabels[pk] || pk}</div>
                          <div class="recipe-param-value">{recipeDisplayText(pv)}</div>
                        </div>
                      ))}
                    </div>
                    <div class="recipe-steps">
                      {r.steps.map((s) => (
                        <div class="recipe-step">{recipeDisplayText(s)}</div>
                      ))}
                    </div>
                    <div class="recipe-tip"><strong>Совет:</strong> {recipeDisplayText(r.tip)}</div>
                    <a class="champ-use-btn" href={recipeQuery(methodKey, r, recipesData)} style="margin-top:14px">
                      Записать чашку →
                    </a>
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>
      );
    })}
  </div>
<style is:global>
  .champ-page { padding: 88px 0 72px; max-width: 720px; }
  .champ-back {
    display: inline-block; font-size: .8rem; color: var(--text-muted);
    text-decoration: none; margin-bottom: 10px;
  }
  .champ-back:hover { color: var(--accent); }
  .champ-breadcrumb {
    font-size: .74rem; color: var(--text-muted); margin-bottom: 18px;
  }
  .champ-breadcrumb a { color: var(--accent); text-decoration: none; font-weight: 600; }
  .champ-hero { margin-bottom: 22px; }
  .champ-hero h1 {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 2rem; font-weight: 600; line-height: 1.15; margin-bottom: 8px;
  }
  .champ-hero-sub { font-size: .88rem; color: var(--text-dim); line-height: 1.55; max-width: 560px; }

  .recipe-tabs .recipe-tab {
    cursor: pointer;
    font: inherit;
  }

  .champ-cards { display: flex; flex-direction: column; gap: 18px; margin-bottom: 28px; }
  .champ-card {
    position: relative; border-radius: 16px; overflow: hidden;
    border: 1px solid rgba(255,255,255,.45);
    box-shadow: 0 16px 40px rgba(70,41,24,.12);
  }
  .champ-card-bg {
    position: absolute; inset: 0;
    background: linear-gradient(145deg, rgba(72,98,102,.88), rgba(45,62,66,.92)),
      radial-gradient(circle at 80% 20%, rgba(168,124,79,.25), transparent 55%);
  }
  .champ-card--v60 .champ-card-bg {
    background: linear-gradient(145deg, rgba(90,62,42,.9), rgba(60,40,28,.94)),
      radial-gradient(circle at 70% 30%, rgba(224,184,30,.15), transparent 50%);
  }
  .champ-card--switch .champ-card-bg {
    background: linear-gradient(145deg, rgba(38,68,62,.92), rgba(24,44,40,.96)),
      radial-gradient(circle at 75% 25%, rgba(100,160,140,.22), transparent 50%);
  }
  .champ-card--chemex .champ-card-bg {
    background: linear-gradient(145deg, rgba(74,86,72,.9), rgba(48,56,46,.94));
  }
  .champ-card--espresso .champ-card-bg {
    background: linear-gradient(145deg, rgba(50,38,32,.92), rgba(30,22,18,.96));
  }
  .champ-card-inner {
    position: relative; z-index: 1; padding: 22px 20px 18px;
    background: rgba(255,255,255,.92);
    margin: 14px; border-radius: 12px;
    backdrop-filter: blur(6px);
  }
  .champ-method {
    display: block; font-size: .58rem; font-weight: 800; letter-spacing: .18em;
    color: var(--text-muted); margin-bottom: 6px;
  }
  .champ-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.35rem; font-weight: 700; line-height: 1.2; color: var(--text);
    text-transform: uppercase; letter-spacing: .02em;
  }
  .champ-tagline {
    margin-top: 8px; font-size: .82rem; font-style: italic; color: var(--text-dim); line-height: 1.45;
  }
  .champ-highlights {
    list-style: none; margin: 14px 0 0; padding: 0; display: flex; flex-direction: column; gap: 6px;
  }
  .champ-highlights li {
    font-size: .78rem; color: var(--text); padding-left: 22px; position: relative; line-height: 1.4;
  }
  .champ-highlights li::before {
    content: '✓'; position: absolute; left: 0; color: var(--accent-green); font-weight: 700;
  }
  .champ-params { margin-top: 12px; }
  .champ-params .recipe-param--grind {
    grid-column: 1 / -1;
    background: rgba(168,124,79,.08);
    border-color: rgba(168,124,79,.25);
  }
  .champ-params .recipe-param--grind .recipe-param-value { line-height: 1.45; }
  .champ-steps {
    margin: 16px 0 0; padding: 0; list-style: none; counter-reset: cstep;
  }
  .champ-steps li {
    counter-increment: cstep; position: relative; padding: 0 0 10px 26px;
    font-size: .8rem; line-height: 1.5; color: var(--text);
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
  }
  .champ-steps li::before {
    content: counter(cstep) '.'; position: absolute; left: 0; font-weight: 700; color: var(--accent);
  }
  .champ-profile {
    margin-top: 14px; padding-top: 12px; border-top: 1px dashed rgba(228,208,185,.9);
    font-size: .76rem; color: var(--text-dim); line-height: 1.45;
  }
  .champ-profile b { color: var(--text); font-weight: 700; }
  .champ-profile-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
  .champ-profile-tag {
    font-size: .68rem; font-weight: 600; padding: 4px 9px; border-radius: 8px;
    background: rgba(168,124,79,.1); border: 1px solid rgba(168,124,79,.2);
  }
  .champ-watermark {
    text-align: center; font-size: .62rem; letter-spacing: .08em;
    color: rgba(255,255,255,.75); padding: 10px 0 12px; position: relative; z-index: 1;
  }
  .champ-use-btn {
    display: inline-block; margin-top: 12px; padding: 8px 14px; border-radius: 8px;
    background: var(--text); color: var(--bg); font-size: .74rem; font-weight: 700;
    text-decoration: none; transition: .15s;
  }
  .champ-use-btn:hover { background: var(--accent); }

  .classic-block-h {
    font-size: .82rem; font-weight: 700; color: var(--text); margin: 8px 0 12px;
  }
  .recipe-card-header {
    width: 100%;
    border: none;
    background: transparent;
    text-align: left;
    cursor: pointer;
  }

  @media (max-width: 600px) {
    .champ-page { padding-top: 72px; }
    .champ-hero h1 { font-size: 1.65rem; }
    .champ-card-inner { margin: 10px; padding: 18px 16px; }
  }
</style>

<script>
  function activateRecipeTab(id: string, push = false) {
    document.querySelectorAll('.recipe-tab[data-tab]').forEach((t) => {
      const active = t.getAttribute('data-tab') === id;
      t.classList.toggle('active', active);
      t.setAttribute('aria-selected', active ? 'true' : 'false');
    });
    document.querySelectorAll('.champ-method-panel').forEach((panel) => {
      (panel as HTMLElement).hidden = panel.getAttribute('data-panel') !== id;
    });
    const url = new URL(location.href);
    url.searchParams.set('tab', id);
    if (push) history.pushState({ tab: id }, '', url);
    else history.replaceState({ tab: id }, '', url);
  }

  document.getElementById('recipeTabs')?.addEventListener('click', (e) => {
    const tab = (e.target as HTMLElement).closest<HTMLButtonElement>('.recipe-tab[data-tab]');
    if (!tab?.dataset.tab) return;
    activateRecipeTab(tab.dataset.tab, true);
  });

  if (!(window as any).__recipeTabsPopBound) {
    (window as any).__recipeTabsPopBound = true;
    window.addEventListener('popstate', () => {
      const id = new URL(location.href).searchParams.get('tab');
      const fallback = document.querySelector('.recipe-tab.active')?.getAttribute('data-tab');
      const target = id && document.querySelector('.recipe-tab[data-tab="' + id + '"]')
        ? id
        : fallback;
      if (target) activateRecipeTab(target);
    });
  }

  document.querySelectorAll('.recipe-card-header').forEach((header) => {
    header.addEventListener('click', () => {
      const method = header.getAttribute('data-method');
      const idx = header.getAttribute('data-idx');
      document.getElementById(`rc-${method}-${idx}`)?.classList.toggle('open');
    });
  });
</script>

</Layout>
