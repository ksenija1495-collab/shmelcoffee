---
interface Props {
  home?: string;
}
const { home = '/g' } = Astro.props;
---

<div class="book" data-book>
  <div class="stage">
    <slot />
  </div>
  <footer class="bookbar">
    <i class="book-progress" data-progress></i>
    <a class="book-home" href={home}>Все гайды</a>
    <button type="button" data-prev>Назад</button>
    <button type="button" data-contents>Содержание</button>
    <span data-count>1</span>
    <button type="button" data-next>Дальше</button>
  </footer>
  <div class="booktoc" data-toc hidden>
    <button type="button" class="booktoc-bg" data-toc-close aria-label="Закрыть содержание"></button>
    <div class="booktoc-panel">
      <div class="booktoc-head">
        <p>Содержание</p>
        <button type="button" data-toc-close>Закрыть</button>
      </div>
      <div data-toc-list></div>
    </div>
  </div>
</div>

<script>
  function boot(root: HTMLElement) {
    const leaves = [...root.querySelectorAll<HTMLElement>(':scope .stage > .leaf')];
    if (!leaves.length) return;
    let index = 0;
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    const progress = root.querySelector<HTMLElement>('[data-progress]')!;
    const toc = root.querySelector<HTMLElement>('[data-toc]')!;
    const list = root.querySelector<HTMLElement>('[data-toc-list]')!;
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-next]')!;

    let part = '';
    leaves.forEach((leaf, i) => {
      const name = leaf.dataset.part || '';
      if (name && name !== part) {
        part = name;
        const label = document.createElement('p');
        label.className = 'booktoc-part';
        label.textContent = name;
        list.append(label);
      }
      const button = document.createElement('button');
      button.type = 'button';
      button.textContent = leaf.dataset.title || leaf.querySelector('h1,h2,h3')?.textContent?.trim() || String(i + 1);
      button.addEventListener('click', () => {
        show(i);
        toc.hidden = true;
      });
      list.append(button);
    });

    function show(nextIndex: number) {
      const n = Math.max(0, Math.min(leaves.length - 1, nextIndex));
      leaves.forEach((leaf, i) => leaf.classList.toggle('is-on', i === n));
      index = n;
      count.textContent = `${n + 1} / ${leaves.length}`;
      progress.style.transform = `scaleX(${(n + 1) / leaves.length})`;
      prev.disabled = n === 0;
      next.disabled = n === leaves.length - 1;
      const copy = leaves[n].querySelector<HTMLElement>('.leaf-copy');
      if (copy) copy.scrollTop = 0;
      const id = leaves[n].id;
      const url = id ? `#${id}` : location.pathname;
      history.replaceState(null, '', url);
      list.querySelectorAll('button').forEach((button, i) => button.classList.toggle('is-on', i === n));
    }

    prev.addEventListener('click', () => show(index - 1));
    next.addEventListener('click', () => show(index + 1));
    root.querySelectorAll('[data-contents]').forEach((button) => {
      button.addEventListener('click', () => { toc.hidden = false; });
    });
    root.querySelectorAll('[data-toc-close]').forEach((button) => {
      button.addEventListener('click', () => { toc.hidden = true; });
    });

    root.addEventListener('click', (event) => {
      const link = (event.target as HTMLElement).closest?.('a[href^="#"]') as HTMLAnchorElement | null;
      if (!link) return;
      const id = link.getAttribute('href')!.slice(1);
      const found = leaves.findIndex((leaf) => leaf.id === id);
      if (found < 0) return;
      event.preventDefault();
      show(found);
    });

    window.addEventListener('keydown', (event) => {
      if (event.metaKey || event.ctrlKey || event.altKey) return;
      const target = event.target as HTMLElement;
      if (target.closest('input, textarea')) return;
      if (event.key === 'ArrowRight' || event.key === 'PageDown') {
        event.preventDefault();
        show(index + 1);
      } else if (event.key === 'ArrowLeft' || event.key === 'PageUp') {
        event.preventDefault();
        show(index - 1);
      } else if (event.key === 'Escape') {
        toc.hidden = true;
      }
    });

    let startX = 0;
    let startY = 0;
    let swipe = false;
    root.addEventListener('pointerdown', (event) => {
      swipe = !(event.target as HTMLElement).closest('a, button');
      startX = event.clientX;
      startY = event.clientY;
    });
    root.addEventListener('pointerup', (event) => {
      if (!swipe) return;
      swipe = false;
      const dx = event.clientX - startX;
      const dy = event.clientY - startY;
      if (Math.abs(dx) < 56 || Math.abs(dx) < Math.abs(dy)) return;
      show(dx < 0 ? index + 1 : index - 1);
    });

    const hash = location.hash.slice(1);
    const start = leaves.findIndex((leaf) => leaf.id === hash);
    show(start >= 0 ? start : 0);
  }

  document.querySelectorAll<HTMLElement>('[data-book]').forEach(boot);
</script>

<style>
  :global(html:has(.book)),
  :global(body:has(.book)) {
    height: 100%;
    overflow: hidden;
  }
  .book {
    height: 100%;
    min-height: 0;
    display: grid;
    grid-template-rows: 1fr auto;
    background: var(--bg);
    position: relative;
  }
  .stage {
    position: relative;
    min-height: 0;
    overflow: hidden;
  }
  .book :global(.leaf) {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: minmax(240px, 0.86fr) minmax(320px, 1.14fr);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    background: var(--bg);
  }
  .book :global(.leaf.is-on) {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    z-index: 1;
  }
  .book :global(.leaf:not(:has(> .figure))) {
    grid-template-columns: 1fr;
  }
  .book :global(.leaf > .figure) {
    margin: 0;
    min-height: 0;
    background: #efe8d8;
    overflow: auto;
  }
  .book :global(.leaf > .figure img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 0;
  }
  .book :global(.leaf > .figure.map) {
    background: var(--bg);
  }
  .book :global(.leaf > .figure.map img) {
    object-fit: contain;
    height: auto;
    min-height: 100%;
    min-width: 760px;
  }
  .book :global(.figure.shots) {
    display: grid;
    grid-template-rows: 1fr 1fr;
    gap: 4px;
  }
  .book :global(.figure.shots img) {
    height: 100%;
    min-height: 0;
  }
  .book :global(.leaf > .figure figcaption) {
    position: sticky;
    bottom: 0;
    margin: 0;
    padding: 8px 14px 10px;
    background: linear-gradient(transparent, rgba(248, 247, 237, .94) 40%);
    font-size: .75rem;
    line-height: 1.35;
    color: var(--text-dim);
  }
  .book :global(.leaf-copy > h3) {
    font-size: 1.85rem;
    font-weight: 500;
    color: var(--accent);
    margin: 0 0 16px;
  }
  .book :global(.leaf-copy) {
    overflow: auto;
    min-height: 0;
    padding: 36px 44px 32px;
  }
  .book :global(.leaf:not(:has(> .figure)) .leaf-copy) {
    max-width: 720px;
    margin: 0 auto;
    width: 100%;
  }
  .book :global(.leaf.cover .leaf-copy) {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 100%;
    max-width: min(680px, 100%);
    margin: 0;
    padding: 8vh 7vw 12vh;
  }
  .book :global(.leaf.cover h1) {
    font-size: clamp(2.8rem, 6vw, 5rem);
    line-height: 0.92;
    max-width: 11em;
  }
  .book :global(.leaf .block),
  .book :global(.leaf.lot) {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }
  .bookbar {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px calc(10px + env(safe-area-inset-bottom));
    border-top: 1px solid var(--border);
    background: var(--bg);
  }
  .book-progress {
    position: absolute;
    left: 0;
    top: -1px;
    height: 2px;
    width: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left center;
  }
  .book-home, .bookbar button {
    appearance: none;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
    border-radius: 2px;
    padding: 8px 12px;
    font: 600 .78rem/1.2 Inter, system-ui, sans-serif;
    letter-spacing: .04em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .bookbar button:disabled { opacity: .35; cursor: default; }
  .bookbar button:hover:not(:disabled), .book-home:hover { border-color: var(--border-hover); }
  .bookbar [data-count] {
    font-size: .78rem;
    letter-spacing: .08em;
    color: var(--text-dim);
  }
  .bookbar [data-next] { margin-left: auto; }
  .booktoc {
    position: absolute;
    inset: 0;
    z-index: 5;
    display: grid;
  }
  .booktoc[hidden] { display: none; }
  .booktoc-bg {
    position: absolute;
    inset: 0;
    border: 0;
    background: rgba(70, 41, 24, .28);
    cursor: pointer;
  }
  .booktoc-panel {
    position: relative;
    justify-self: end;
    width: min(420px, 100%);
    height: 100%;
    overflow: auto;
    background: var(--bg);
    border-left: 1px solid var(--border);
    padding: 22px 22px 40px;
  }
  .booktoc-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }
  .booktoc-head p {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.8rem;
  }
  .booktoc-part {
    margin: 18px 0 6px;
    font-size: .72rem;
    font-weight: 600;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .booktoc-panel button[data-toc-close] {
    border: 0;
    background: transparent;
    color: var(--text-dim);
    font: 600 .75rem/1 Inter, system-ui, sans-serif;
    letter-spacing: .06em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .booktoc-panel [data-toc-list] button {
    display: block;
    width: 100%;
    text-align: left;
    border: 0;
    border-bottom: 1px solid var(--border);
    background: transparent;
    color: var(--text);
    padding: 9px 0;
    font: 500 1.05rem/1.3 'Cormorant Garamond', Georgia, serif;
    cursor: pointer;
  }
  .booktoc-panel [data-toc-list] button.is-on { color: var(--accent); }
  @media (max-width: 800px) {
    .book :global(.leaf.is-on),
    .book :global(.leaf) {
      grid-template-columns: 1fr;
      grid-template-rows: minmax(160px, 32vh) minmax(0, 1fr);
    }
    .book :global(.leaf:not(:has(> .figure))) {
      grid-template-rows: 1fr;
    }
    .book :global(.figure.shots) {
      grid-template-rows: 1fr;
      grid-template-columns: 1fr 1fr;
    }
    .book :global(.leaf-copy) { padding: 22px 18px 18px; }
    .book :global(.leaf.cover .leaf-copy) { padding: 28px 22px 8vh; max-width: 100%; }
    .book-home { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .book-progress { transition: none; }
  }
</style>
