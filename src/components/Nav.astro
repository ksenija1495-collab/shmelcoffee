---
const currentPath = Astro.url.pathname;
const isActive = (path: string) => currentPath === path || currentPath.startsWith(path + '/');
---

<nav class="site-nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo">Shmelco</a>
    <ul class="nav-links">
      <li><a href="/" class={currentPath === '/' ? 'active' : ''}>Главная</a></li>
      <li><a href="/countries" class={isActive('/countries') ? 'active' : ''}>Страны</a></li>
      <li><a href="/wheel" class={isActive('/wheel') ? 'active' : ''}>Вкусы</a></li>
      <li><a href="/blog" class={isActive('/blog') ? 'active' : ''}>Блог</a></li>
      <li><a href="/account" class={isActive('/account') ? 'active' : ''} id="navAccount">Кабинет</a></li>
      <li><a href="/quiz" class={`nav-cta ${isActive('/quiz') ? 'active' : ''}`}>Начать бесплатно →</a></li>
    </ul>
  </div>
</nav>

<script>
  // Энхансер плана дегустации на /account. Живёт здесь, чтобы не трогать большой
  // account.astro (который нельзя переписать целиком через API). Добавляет:
  //  • цель обучения у каждого гида;
  //  • прогресс-бар (сколько дней плана оттестировано);
  //  • отметку «✓ пройдено» на дне, если по нему записана чашка;
  //  • ссылку «Записать чашку» с префиллом из данных гида (+ рецепт способа).
  import { createClient } from '@supabase/supabase-js';
  import { DB } from '../data/countries';
  import { BREW_METHODS } from '../data/methods';

  if (location.pathname === '/account' || location.pathname === '/account/') {
    const supabase = createClient(
      import.meta.env.PUBLIC_SUPABASE_URL,
      import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
      { auth: { flowType: 'implicit' } }
    );

    const METHOD_MAP: Record<string, string> = {
      'Воронка V60': 'V60', 'Hario Switch': 'Hario Switch', 'Kalita Wave': 'Kalita', 'Кемекс': 'Chemex', 'Аэропресс': 'Aeropress',
      'Френч-пресс': 'Френч-пресс', 'Турка': 'Турка', 'Гейзер (мока)': 'Гейзерная',
      'Эспрессо-машина': 'Эспрессо', 'Cold Brew': 'Cold Brew',
    };
    const methodByLabel: Record<string, any> = {};
    (BREW_METHODS as any[]).forEach((m) => { methodByLabel[m.label] = m; });
    const norm = (s: any) => String(s == null ? '' : s).trim().toLowerCase();

    let guideMap: Record<string, any> = {};
    let goalById: Record<string, string> = {};
    let cups: any[] = [];
    let loaded = false;

    function goalText(i: number) {
      if (i <= 1) return 'Цель гида: научиться фиксировать вкусовые ноты. Просто замечай и записывай, что чувствуешь в чашке.';
      return 'Цель гида: сравнивай кофе, методы и пропорции — замечай, что именно меняет вкус.';
    }

    function beanLogged(name: string, mapped?: string) {
      return cups.some((c) => norm(c.name) === norm(name) && (mapped ? norm(c.brew_method) === norm(mapped) : true));
    }
    function dayDone(day: any) {
      const parts = String(day.bean || '').split(/\s+vs\s+/i).map((s) => s.trim()).filter(Boolean);
      if (parts.length > 1) return parts.every((p) => beanLogged(p));
      return beanLogged(day.bean, METHOD_MAP[day.method]);
    }

    function buildLink(day: any, beanByName: Record<string, any>) {
      const bn = beanByName[day.bean] || {};
      const brew = METHOD_MAP[day.method] || '';
      const rec = methodByLabel[day.method] || {};
      const notes = (bn.tags || []).join(',');
      const q = new URLSearchParams();
      q.set('name', day.bean || '');
      if (bn.roaster) q.set('roaster', bn.roaster);
      if (bn.country) q.set('country', bn.country);
      if (bn.variety) q.set('variety', bn.variety);
      if (bn.process) q.set('process', bn.process);
      if (brew) q.set('brew', brew);
      if (rec.grind) q.set('grind', rec.grind);
      if (rec.ratio) {
        const { coffee_g, water_g } = (() => {
          const m = String(rec.ratio).match(/(\d+(?:[.,]\d+)?)\s*г[^\d]*(\d+(?:[.,]\d+)?)\s*мл/i);
          if (!m) return {};
          return { coffee_g: m[1].replace(',', '.'), water_g: m[2].replace(',', '.') };
        })();
        if (coffee_g) q.set('coffee_g', coffee_g);
        if (water_g) q.set('water_g', water_g);
      }
      if (rec.temp) q.set('temp', rec.temp);
      if (rec.time) q.set('time', rec.time);
      if (notes) q.set('notes', notes);
      if (day.focus) q.set('focus', day.focus);
      q.set('from', 'guide');
      return '/add-cup?' + q.toString();
    }

    async function loadData() {
      const { data: { user } } = await supabase.auth.getUser();
      if (!user) return;
      const [gRes, cRes] = await Promise.all([
        supabase.from('guides').select('id,content,created_at').eq('user_id', user.id).order('created_at', { ascending: true }),
        supabase.from('cups').select('name,brew_method').eq('user_id', user.id),
      ]);
      cups = cRes.data || [];
      (gRes.data || []).forEach((g: any, i: number) => {
        try { const c = JSON.parse(g.content); if (c && Array.isArray(c.weekPlan)) { guideMap[g.id] = c; goalById[g.id] = goalText(i); } } catch (e) {}
      });
      loaded = true;
    }

    function enhance() {
      if (!loaded) return;
      document.querySelectorAll('.guide-rich[data-gid]').forEach((card) => {
        const gid = card.getAttribute('data-gid')!;
        const data = guideMap[gid];
        if (!data) return;
        const beanByName: Record<string, any> = {};
        (data.beans || []).forEach((b: any) => { beanByName[b.name] = b; });
        const plan = data.weekPlan || [];

        // Цель обучения + прогресс-бар (один раз на гид)
        const body = card.querySelector('.gr-body');
        if (body && !card.getAttribute('data-goaladded')) {
          card.setAttribute('data-goaladded', '1');
          const done = plan.filter(dayDone).length;
          const total = plan.length || 1;
          const pct = Math.round((done / total) * 100);
          const box = document.createElement('div');
          box.style.cssText = 'margin:0 0 14px;padding:12px 14px;border:1px solid var(--border);border-radius:12px;background:var(--surface-2)';
          box.innerHTML =
            '<div style="font-size:.82rem;font-weight:600;color:var(--text);line-height:1.45">🎯 ' + (goalById[gid] || goalText(9)) + '</div>' +
            '<div style="font-size:.72rem;color:var(--text-muted);margin:9px 0 5px">Пройдено дней: <b style="color:var(--accent)">' + done + ' / ' + total + '</b></div>' +
            '<div style="height:8px;background:var(--border);border-radius:6px;overflow:hidden"><i style="display:block;height:100%;background:var(--accent);width:' + pct + '%"></i></div>';
          body.insertBefore(box, body.firstChild);
        }

        // Дни плана: отметка «пройдено» + ссылка «Записать чашку»
        const pane = card.querySelector('[data-gp="' + gid + '|plan"]');
        if (!pane) return;
        const days = pane.querySelectorAll('.gp-day');
        days.forEach((el, i) => {
          const day = plan[i];
          if (!day) return;
          const done = dayDone(day);
          if (done && !(el as HTMLElement).getAttribute('data-donemark')) {
            (el as HTMLElement).setAttribute('data-donemark', '1');
            (el as HTMLElement).style.borderColor = 'var(--accent)';
            const badge = document.createElement('div');
            badge.textContent = '✓ пройдено';
            badge.style.cssText = 'display:inline-block;margin-top:8px;margin-right:8px;font-size:.7rem;font-weight:700;color:#4a7a45;background:#e8f0e4;border:1px solid #cfe0c8;border-radius:8px;padding:4px 9px';
            el.appendChild(badge);
          }
          if (!(el as HTMLElement).getAttribute('data-logadded')) {
            (el as HTMLElement).setAttribute('data-logadded', '1');
            const a = document.createElement('a');
            a.href = buildLink(day, beanByName);
            a.textContent = done ? '📔 Записать ещё' : '📔 Записать чашку';
            a.style.cssText = 'display:inline-block;margin-top:8px;font-size:.72rem;font-weight:600;color:var(--accent);text-decoration:none;border:1px solid var(--accent);border-radius:8px;padding:5px 11px';
            el.appendChild(a);
          }
        });
      });
    }

    (async () => {
      await loadData();
      enhance();
      const obs = new MutationObserver(() => enhance());
      obs.observe(document.body, { childList: true, subtree: true });
    })();
  }
</script>
