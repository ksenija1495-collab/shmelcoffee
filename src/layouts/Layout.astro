---
import Analytics from '@vercel/analytics/astro';

interface Props {
  title: string;
  description?: string;
  keywords?: string[];
  ogType?: string;
  canonical?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'Shmelco Coffee Guide — интерактивный гид по specialty кофе. Диагностика вкуса, подбор зерна, колесо вкусов.',
  keywords = [],
  ogType = 'website',
  canonical,
  noindex = false,
} = Astro.props;

const siteUrl = 'https://shmelcoffee.com';
const canonicalUrl = canonical || new URL(Astro.url.pathname, siteUrl).href;
const path = Astro.url.pathname;
const isBlog = path === '/blog' || path.startsWith('/blog/');
const isHome = path === '/';
const isCountries = path === '/countries' || path.startsWith('/countries/');
const accountZonePaths = ['/account', '/add-cup', '/add-shelf', '/cup'];
const isAccountZone = accountZonePaths.some((p) => path === p || path.startsWith(`${p}/`));
const isAccount = path === '/account' || path.startsWith('/account/');
const accountNavTab = (() => {
  if (path === '/add-cup') return 'add-cup';
  if (path === '/add-shelf') return 'shelf';
  if (path === '/cup') return 'diary';
  if (path === '/account') return Astro.url.searchParams.get('tab') || 'profile';
  return 'profile';
})();
---

<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')}>}
  <link rel="canonical" href={canonicalUrl}>
  {noindex && <meta name="robots" content="noindex, nofollow">}

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="apple-touch-icon" href="/favicon.svg">

  <!-- Open Graph -->
  <meta property="og:type" content={ogType}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:site_name" content="Shmelco Coffee Guide">
  <meta property="og:locale" content="ru_RU">

  <!-- Twitter -->
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
  <slot />
  {isAccountZone ? (
    <div class="mobile-nav mobile-acc-nav" role="navigation" aria-label="Кабинет">
      <a href="/account?tab=profile" class:list={[{ active: accountNavTab === 'profile' }]} data-acc-tab="profile"><span class="mn-icon">🎯</span>Профиль</a>
      <a href="/account?tab=diary" class:list={[{ active: accountNavTab === 'diary' }]} data-acc-tab="diary"><span class="mn-icon">📔</span>Дневник</a>
      <a href="/account?tab=shelf" class:list={[{ active: accountNavTab === 'shelf' }]} data-acc-tab="shelf"><span class="mn-icon">🪵</span>Полка</a>
      <a href="/add-cup" class:list={[{ active: accountNavTab === 'add-cup' }]} data-acc-tab="add-cup"><span class="mn-icon">☕</span>Чашка</a>
    </div>
  ) : (
    <div class="mobile-nav">
      <a href="/" class={isHome ? 'active' : ''}><span class="mn-icon">🏠</span>Главная</a>
      <a href="/blog" class={isBlog ? 'active' : ''}><span class="mn-icon">📖</span>Блог</a>
      <a href="/countries" class={isCountries ? 'active' : ''}><span class="mn-icon">🌍</span>Страны</a>
      <a href="/account" id="mobileAccount" class={isAccount ? 'active' : ''}><span class="mn-icon">👤</span>Кабинет</a>
    </div>
  )}
  <div class="footer">Shmelco · product atelier · Specialty Coffee Guide</div>
  <Analytics />
</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
